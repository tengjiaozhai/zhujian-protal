.selected{padding:15px}.ps-mode-preview{height:64px}.ps-mode strong{font-size:15px}.ps-mode p{font-size:12px}.ps-module-cards{grid-template-columns:1fr}.ps-module-card{padding:12px;gap:8px}.ps-module-card p{font-size:11px}.ps-module-tail small{font-size:10px}.ps-layouts{gap:10px}.ps-layouts>button{width:100%;font-size:14px;min-height:56px}.ps-module-layout{display:block}.ps-module-nav{padding:16px;margin-bottom:16px}.ps-module-nav nav{display:flex;gap:6px;overflow-x:auto}.ps-module-nav nav a{padding:10px;flex-shrink:0}.ps-module-nav nav a>.ti:last-child{display:none}.ps-module-panel{padding:20px;border-radius:12px}.ps-module-panel .ps-card-heading{margin-bottom:28px}.ps-fields{gap:24px}.ps-info{font-size:11px}.ps-base-fields{grid-template-columns:1fr}.ps-theme-row{flex-direction:column;gap:24px}.ps-theme-row>div+div{border:0;padding:0}.ps-carousel-options{grid-template-columns:1fr;padding:16px}.ps-chips button{font-size:12px;padding:8px 12px}.ps-preview-menu>[role=menu]{right:0}.portal-feature{padding:16px 16px 0}.portal-grid.equal-columns,.portal-grid.right-wide{display:flex;flex-direction:column}.portal-grid>.portal-column{display:contents}.portal-grid .portal-item{width:100%}.ps-portal-preview.mobile{width:100%}.ps-portal-preview .portal-hero-inner{padding:20px 16px}.ps-portal-preview .portal-grid{padding:16px}.portal-preview-modal>.hub-dialog{max-width:calc(100vw - 24px)}.portal-preview-modal .dialog-body{padding:12px}.portal-description{font-size:12px}}\n\n.portal-grid.single>.portal-column{display:contents}.portal-grid.single>.portal-column>.portal-item{width:100%}\n","script":"const FORM_SEEDS = [\n ['f1','月度设备运行情况填报','普通表单','设备管理','收集中','实名填报','月报'],\n ['f2','教学设备采购申请','流程表单','设备管理','收集中','实名填报','单次'],\n ['f3','校园服务满意度调查','普通表单','信息采集','收集中','登录匿名','单次'],\n ['f4','室内场馆预约安排需求表','流程表单','行政事务','收集中','实名填报','周报'],\n ['f5','教师科研成果登记','普通表单','教育教学','草稿','实名填报','单次'],\n ['f6','院系年度工作报表','业务报表','教育教学','未发布','实名填报','年报'],\n ['f7','教学质量意见收集','普通表单','教育教学','已暂停','完全匿名','单次'],\n ['f8','大型仪器使用登记','普通表单','设备管理','收集中','实名填报','日报'],\n ['f9','学术交流活动报名','普通表单','行政事务','已结束','实名填报','单次'],\n ['f10','外聘专家入校申请','流程表单','行政事务','草稿','实名填报','单次'],\n ['f11','实验室安全检查表','流程表单','设备管理','收集中','实名填报','周报'],\n ['f12','2025 年度数据归档表','普通表单','信息采集','已归档','实名填报','年报']\n];\nconst FORMS = FORM_SEEDS.map((x,i)=>({id:x[0],name:x[1],type:x[2],category:x[3],status:x[4],identity:x[5],cycle:x[6],owner:i===3?'李静':'高源',updated:'2026-10-'+String(23-i%5).padStart(2,'0')+' 09:30',start:'2026-10-01T08:00',end:'2026-10-31T18:00',version:i===4?1:3,scope:x[5]==='完全匿名'?'公开访问':'指定组织',audience:x[5]==='完全匿名'?[]:['信息工程学院','理学院'],limit:1,reminder:true,favorite:[0,2,3].includes(i),shared:[1,3,10].includes(i),deleted:false,allowWithdraw:i===1&&x[2]==='流程表单',published:!['草稿','未发布'].includes(x[4])}));\nconst PEOPLE = ['高源','张伟','李静','陈晨','赵敏','王强','刘洋','林敏','周扬','李明','陈蕾','吴越'];\nconst DEPARTMENTS = ['信息工程学院','理学院','机关部门'];\nconst TASKS = FORMS.flatMap((f,fi)=>Array.from({length:fi===0?12:fi===1?8:fi===2?5:fi===3?5:2},(_,i)=>{\n const fill=['未填报','已提交','已提交','填报中','已完成','已逾期'][i%6];\n const audit=f.type==='流程表单'?(fill==='已提交'?'待审核':fill==='已完成'?'已通过':'—'):'—';\n return {id:f.id+'-t'+i,fid:f.id,person:PEOPLE[i%12],dept:DEPARTMENTS[i%3],fill,audit,cycle:f.cycle==='月报'?'2026年10月':f.cycle==='周报'?'2026年第43周':f.cycle==='日报'?'2026-10-23':'本次填报',start:'2026-10-01 08:00',due:fill==='已逾期'?'2026-10-20 18:00':'2026-10-31 18:00',submitted:['已提交','已完成'].includes(fill)?'2026-10-22 14:'+String(10+i):'—',version:3,node:'部门审核',following:[0,3].includes(fi),remark:'',value:8+i};\n}));\nTASKS.find(t=>t.fid==='f2'&&t.person==='高源').fill='已提交';\nTASKS.find(t=>t.fid==='f2'&&t.person==='高源').audit='待审核';\nTASKS.find(t=>t.fid==='f2'&&t.person==='高源').submitted='2026-10-22 15:30';\nTASKS.find(t=>t.fid==='f3'&&t.person==='高源').fill='已完成';\nTASKS.find(t=>t.fid==='f3'&&t.person==='高源').submitted='2026-10-22 16:20';\nObject.assign(TASKS.find(t=>t.fid==='f8'&&t.person==='高源'),{fill:'填报中',equipment:'电子显微镜',value:6,remark:'本期维护记录待补充。'});\nObject.assign(TASKS.find(t=>t.fid==='f11'&&t.person==='高源'),{fill:'已逾期',due:'2026-10-20 18:00'});\nfor(let i=TASKS.length-1;i>=0;i--){if(!FORMS.find(f=>f.id===TASKS[i].fid).published||FORMS.find(f=>f.id===TASKS[i].fid).identity==='完全匿名')TASKS.splice(i,1);}\nTASKS.push({id:'f1-202609-gaoyuan',fid:'f1',person:'高源',dept:'信息工程学院',fill:'已完成',audit:'—',cycle:'2026年9月',start:'2026-09-01 08:00',due:'2026-09-30 18:00',submitted:'2026-09-28 10:00',version:2,node:'—',following:false,value:12,equipment:'教学设备',remark:'9月运行记录已核对。'});\nconst RECORDS = TASKS.filter(t=>['已提交','已完成'].includes(t.fill)).map((t,i)=>({id:'R'+String(i+1).padStart(4,'0'),tid:t.id,fid:t.fid,person:t.person,dept:t.dept,submitted:t.submitted,cycle:t.cycle,audit:t.audit,version:t.version,node:t.node,value:t.value,remark:'设备运行正常，已完成本期信息核对。'}));\nconst LOGS = [\n ['2026-10-23 09:30','高源','修改配置','调整本月填报截止时间','成功','v3'],\n ['2026-10-22 16:40','李静','授权变更','新增理学院统计查看范围','成功','v3'],\n ['2026-10-21 10:15','高源','发布','发布第 3 版，保留历史响应版本','成功','v3'],\n ['2026-10-20 15:20','高源','数据导出','导出授权范围内的填报数据','成功','v2'],\n ['2026-10-19 11:30','高源','发布校验','截止时间早于开始时间，已阻止发布','失败','v2'],\n ['2026-10-18 09:00','系统任务','生成任务','按当前范围生成本周期填报任务','成功','v2'],\n ['2026-10-17 14:20','高源','修改设计','新增设备数量字段，保存为设计草稿','成功','v2']\n].map((x,i)=>({id:i,time:x[0],actor:x[1],action:x[2],detail:x[3],result:x[4],version:x[5]}));\nconst COMPONENTS = [{type:'text',label:'单行文本',icon:'letter-t',group:'常用组件'},{type:'textarea',label:'多行文本',icon:'align-left',group:'常用组件'},{type:'number',label:'数字',icon:'numbers',group:'常用组件'},{type:'select',label:'下拉选择',icon:'selector',group:'常用组件'},{type:'date',label:'日期',icon:'calendar',group:'常用组件'},{type:'grid',label:'FormGrid 栅格',icon:'layout-grid',group:'布局组件'},{type:'description',label:'文本描述',icon:'text-caption',group:'布局组件'},{type:'member',label:'成员单选',icon:'user',group:'组织组件'},{type:'department',label:'部门单选',icon:'building',group:'组织组件'},{type:'attachment',label:'附件上传',icon:'paperclip',group:'高级组件'}];\n\nconst HUB_DATA_ACCESS={f1:{data:true,statistics:true,export:true,scope:'all'},f2:{data:true,statistics:true,export:true,scope:'all'},f3:{data:true,statistics:true,export:true,scope:'all'},f4:{data:true,statistics:true,export:false,scope:'all'},f7:{data:true,statistics:true,export:true,scope:'all'},f8:{data:true,statistics:true,export:true,scope:'信息工程学院'},f9:{data:true,statistics:true,export:true,scope:'all'},f11:{data:false,statistics:true,export:false,scope:'all'},f12:{data:true,statistics:true,export:true,scope:'all'}};\nfunction hubCycleKey(f){return ({单次:'本次填报',日报:'2026-10-23',周报:'2026年第43周',月报:'2026年10月',年报:'2026年度'})[f.cycle];}\nconst PORTAL_MODULES={work:['我的待办','check','显示待处理的审批、填报与业务事项'],services:['应用导航','layout-grid','按分组组织常用应用与业务入口'],progress:['填报计划','adjustments-horizontal','展示当前进行中的填报计划与进度'],notices:['重要提醒','bell','汇总平台消息和学校重要通知'],recent:['最近访问','device-desktop','快速返回最近使用过的应用'],frequent:['我的收藏','sparkles','展示已收藏的应用和常用服务']};\nconst PORTAL_GROUPS={common:'常用服务',teaching:'教学管理',office:'行政办公',data:'数据服务'};\nconst PORTAL_MODES={workbench:['工作台模式','待办优先，聚合工作事项'],navigation:['导航模式','快速找到常用应用'],portal:['门户模式','内容展示与资讯触达']};\nfunction portalDefaults(){return {order:['work','services','progress','notices','recent','frequent'],hidden:[],layout:'columns',density:'comfortable',mode:'workbench',modules:{work:{count:5,types:['audit','fill'],destination:'tasks'},services:{groups:Object.keys(PORTAL_GROUPS),groupOrder:Object.keys(PORTAL_GROUPS),appOrder:[],excluded:[],destination:'applications'},progress:{scopes:['owned','joined'],count:3,showProgress:true,destination:'detail'},notices:{sources:['platform','school'],count:5,destination:'messages'},recent:{count:5,sort:'time',empty:'recommend'},frequent:{count:5,types:['service','form'],empty:'guide',destination:'favorites'}},style:{title:'校务工作台',subtitle:state().hub.profile?.department||'校内服务',description:'',color:'#07599f',images:[],bannerMode:'static',interval:5,effect:'fade'}}}\nfunction portalSettings(){const defaults=portalDefaults(),saved=state().hub.portal||{},modules={};for(const k of Object.keys(PORTAL_MODULES))modules[k]={...defaults.modules[k],...saved.modules?.[k]};const order=[...new Set([...(saved.order||defaults.order),...defaults.order])].filter(k=>PORTAL_MODULES[k]);return {...defaults,...saved,order,hidden:(saved.hidden||[]).filter(k=>PORTAL_MODULES[k]),modules,style:{...defaults.style,...saved.style}}}\nfunction portalDraft(){return parent.Prototype.session.portalDraft??=structuredClone(portalSettings())}\nfunction portalValue(path){return path.split('.').reduce((o,k)=>o[k],portalDraft())}\nfunction setPortalValue(path,value){const keys=path.split('.'),key=keys.pop();keys.reduce((o,k)=>o[k],portalDraft())[key]=value}\nfunction portalDirty(){return JSON.stringify(portalDraft())!==JSON.stringify(portalSettings())}\nfunction portalDirtyLabel(){const n=$('psDirty');if(n){n.textContent=portalDirty()?'有未保存的修改':'所有修改已保存';n.classList.toggle('saved',!portalDirty())}}\nfunction psButton(label,action,attrs='',cls=''){return '<button type=\"button\" class=\"ps-button '+cls+'\" data-ps-action=\"'+action+'\" '+attrs+'>'+label+'<\/button>'}\nfunction psField(title,hint,control){control=control.replace(/aria-label=\"[^\"]*\"/, 'aria-label=\"'+title+'\"');return '<div class=\"ps-field\"><label>'+title+'<\/label>'+(hint?'<p>'+hint+'<\/p>':'')+control+'<\/div>'}\nfunction psSelect(path,choices){const value=portalValue(path);return '<select aria-label=\"'+esc(path)+'\" data-ps-value=\"'+path+'\">'+choices.map(c=>{const [v,n]=Array.isArray(c)?c:[c,c];return '<option value=\"'+v+'\"'+(String(v)===String(value)?' selected':'')+'>'+n+'<\/option>'}).join('')+'<\/select>'}\nfunction psCount(path,unit='条'){return psSelect(path,[3,5,8,10].map(n=>[n,n+' '+unit]))}\nfunction psChips(path,choices){const values=portalValue(path);return '<div class=\"ps-chips\">'+choices.map(([v,n])=>'<button type=\"button\" aria-pressed=\"'+values.includes(v)+'\" data-ps-action=\"chip\" data-path=\"'+path+'\" data-value=\"'+v+'\" class=\"'+(values.includes(v)?'selected':'')+'\">'+n+(values.includes(v)?icon('check'):'')+'<\/button>').join('')+'<\/div>'}\nfunction psToggle(path,label){return '<input type=\"checkbox\" role=\"switch\" aria-label=\"'+label+'\" data-ps-value=\"'+path+'\" '+(portalValue(path)?'checked':'')+'>'}\nfunction psInfo(){return '<div class=\"ps-info\">'+icon('help-circle')+'配置不会突破业务权限，未启用的模块会保留当前配置但不展示在首页。<\/div>'}\nfunction portalSection(){const section=params.get('section')||'home';return ['home','modules','style','system'].includes(section)?section:'home'}\nfunction renderPortalSettings(){\n const section=portalSection(),titles={home:'首页配置',modules:'模块配置',style:'页面样式',system:'系统设置'},title=titles[section],draft=portalDraft();\n document.body.classList.add('portal-settings-page');\n $('hubMain').innerHTML='<div class=\"portal-settings\"><aside class=\"ps-sidebar\"><a class=\"ps-back\" href=\"#/portal\">'+icon('arrow-left')+' 返回应用门户<\/a><h2>'+icon('settings')+' 设置中心<\/h2><div class=\"ps-nav-label\">门户管理<\/div><nav aria-label=\"门户管理\">'+[['home','首页配置','home'],['modules','模块配置','layout-grid'],['style','页面样式','palette']].map(([v,n,ic])=>'<a href=\"#/portal-settings?section='+v+'\" '+(section===v?'class=\"active\" aria-current=\"page\"':'')+'>'+icon(ic)+n+(section===v?icon('chevron-right'):'')+'<\/a>').join('')+'<\/nav><div class=\"ps-nav-label system\">系统管理<\/div><nav><a href=\"#/portal-settings?section=system\" '+(section==='system'?'class=\"active\" aria-current=\"page\"':'')+'>'+icon('settings')+'系统设置<\/a><\/nav><button class=\"ps-help\" data-ps-action=\"help\">'+icon('help-circle')+'<strong>需要帮助？<\/strong><span>查看门户配置使用指南<\/span><\/button><\/aside><main class=\"ps-main\"><header class=\"ps-head\"><div><div class=\"ps-breadcrumb\">设置中心 '+icon('chevron-right')+' '+(section==='system'?'系统管理':'门户管理')+' '+icon('chevron-right')+' <span>'+title+'<\/span><\/div><h1>'+title+'<\/h1><\/div>'+(section==='system'?'':'<div class=\"ps-head-actions\"><span id=\"psDirty\" class=\"ps-dirty '+(!portalDirty()?'saved':'')+'\">'+(portalDirty()?'有未保存的修改':'所有修改已保存')+'<\/span><div class=\"ps-preview-menu\"><button class=\"ps-button\" data-ps-action=\"preview-menu\" aria-expanded=\"false\">'+icon('eye')+'预览门户 '+icon('chevron-down')+'<\/button><div role=\"menu\" hidden><button role=\"menuitem\" data-ps-action=\"preview\" data-device=\"desktop\">'+icon('device-desktop')+' 网页预览<\/button><button role=\"menuitem\" data-ps-action=\"preview\" data-device=\"mobile\">'+icon('device-mobile')+' 手机预览<\/button><\/div><\/div>'+psButton(icon('device-floppy')+'保存并发布','save','','primary')+'<\/div>')+'<\/header><div class=\"ps-body\">'+(section==='home'?portalHomeConfiguration():section==='modules'?portalModuleConfiguration():section==='style'?portalStyleConfiguration():'<section class=\"ps-card\"><h2>系统设置<\/h2><div class=\"small-empty\">暂无系统配置项<\/div><\/section>')+'<\/div><\/main><\/div>';\n document.querySelectorAll('.ps-preview-menu').forEach(menu=>{const panel=menu.querySelector('[role=menu]'),trigger=menu.querySelector('button');const toggle=open=>{panel.hidden=!open;trigger.setAttribute('aria-expanded',String(open))};menu.addEventListener('mouseenter',()=>toggle(true));menu.addEventListener('mouseleave',()=>toggle(false));menu.addEventListener('focusout',e=>{if(!menu.contains(e.relatedTarget))toggle(false)});});\n document.title=title+' · 竹简应用中台';\n}\nfunction portalHomeConfiguration(){const d=portalDraft();return '<section class=\"ps-card\"><div class=\"ps-card-heading\"><div><h2>首页模式<\/h2><p>选择适合学校业务场景的首页结构，切换模式不会清空已有配置<\/p><\/div><span class=\"ps-badge\">当前：高校定制化<\/span><\/div><div class=\"ps-modes\">'+Object.entries(PORTAL_MODES).map(([key,[name,desc]],i)=>'<button type=\"button\" class=\"ps-mode '+(d.mode===key?'selected':'')+'\" data-ps-action=\"mode\" data-value=\"'+key+'\" aria-pressed=\"'+(d.mode===key)+'\"><div class=\"ps-mode-preview\" aria-hidden=\"true\"><span><\/span><span><\/span><span><\/span><\/div>'+(i===0?'<span class=\"ps-recommended\">推荐<\/span>':'')+'<strong>'+name+' '+icon(d.mode===key?'circle-dot':'circle')+'<\/strong><p>'+desc+'<\/p><\/button>').join('')+'<\/div><\/section><section class=\"ps-card\"><div class=\"ps-card-heading\"><div><h2>展示模块<\/h2><p>控制哪些模块出现在门户首页，可拖拽调整展示顺序<\/p><\/div>'+psButton('恢复默认配置','reset-home','','text')+'<\/div><div class=\"ps-module-cards\">'+d.order.map((key,i)=>{const [name,ic,desc]=PORTAL_MODULES[key],off=d.hidden.includes(key),counts={work:workspaceTasks('fill').filter(t=>taskPending(t,'fill')).length+workspaceTasks('audit').filter(t=>taskPending(t,'audit')).length,services:d.modules.services.groups.length,progress:progressItems().length,notices:d.modules.notices.count,recent:d.modules.recent.count,frequent:d.modules.frequent.count};return '<article class=\"ps-module-card '+(off?'off':'')+'\" draggable=\"true\" data-ps-drag=\"module\" data-key=\"'+key+'\"><span class=\"ps-drag-handle\" aria-label=\"拖动排序\">'+icon('grip-vertical')+'<\/span><span class=\"ps-module-symbol\">'+icon(ic)+'<\/span><div><strong>'+name+'<\/strong><p>'+desc+'<\/p><\/div><div class=\"ps-module-tail\"><small>'+(key==='work'?counts[key]+' 条待处理':key==='services'?'已配置 '+counts[key]+' 个分组':key==='progress'?counts[key]+' 个进行中':'最多展示 '+counts[key]+' 条')+'<\/small><input type=\"checkbox\" role=\"switch\" aria-label=\"显示'+name+'\" data-ps-visible=\"'+key+'\" '+(!off?'checked':'')+'><div class=\"ps-order-actions\">'+psButton(icon('arrow-up'),'move','data-kind=\"module\" data-key=\"'+key+'\" data-dir=\"-1\" aria-label=\"上移'+name+'\" '+(i===0?'disabled':''),'icon')+psButton(icon('arrow-down'),'move','data-kind=\"module\" data-key=\"'+key+'\" data-dir=\"1\" aria-label=\"下移'+name+'\" '+(i===d.order.length-1?'disabled':''),'icon')+'<\/div><\/div><\/article>';}).join('')+'<\/div><\/section><section class=\"ps-card\"><h2>页面布局<\/h2><p>仅提供当前门户支持的布局方式<\/p><div class=\"ps-layouts\">'+[['single','单栏布局'],['columns','双栏布局'],['right-wide','左窄右宽']].map(([v,n])=>'<button type=\"button\" class=\"'+(d.layout===v?'selected':'')+'\" data-ps-action=\"layout\" data-value=\"'+v+'\" aria-pressed=\"'+(d.layout===v)+'\"><span class=\"ps-layout-icon '+v+'\" aria-hidden=\"true\"><i><\/i>'+(v==='single'?'':'<i><\/i>')+'<\/span>'+n+(d.layout===v?icon('check'):'')+'<\/button>').join('')+'<\/div><\/section>'}\nfunction portalModuleConfiguration(){const key=PORTAL_MODULES[params.get('module')]?params.get('module'):'work',p='modules.'+key+'.';let body='',title=PORTAL_MODULES[key][0]+'配置',desc='';\n if(key==='work'){title='工作待办配置';desc='控制首页待办的范围、分类与跳转规则，数据权限沿用现有待办中心。';body=psField('首页展示数量','超过数量的内容可通过“查看全部”访问',psCount(p+'count'))+psField('待办类型','选择需要在首页展示的待办类型',psChips(p+'types',[['audit','待审核'],['fill','待填报'],['handling','待处理'],['initiated','我发起的']]))+psField('查看全部跳转','用户点击“查看全部”后的目标页面',psSelect(p+'destination',[['tasks','待办中心 / 全部待办'],['fill','填报中心 / 我的填报'],['audit','填报中心 / 我的审核']]))}\n if(key==='services'){desc='复用现有应用分组设置能力，在门户中组织常用应用与业务入口。';body=psField('导航分组','分组设置属于应用导航的子配置，可拖拽调整分组顺序',psChips(p+'groups',portalDraft().modules.services.groupOrder.map(k=>[k,PORTAL_GROUPS[k]])))+psField('组内应用排序','点击“管理应用”进入分组和应用排序设置',psButton('管理分组与应用 '+icon('chevron-right'),'manage-apps','','outline'))+psField('查看全部跳转','用户点击“全部应用”后的目标页面',psSelect(p+'destination',[['applications','应用中心 / 全部应用'],['forms','表单中心 / 我的表单']]))}\n if(key==='progress'){desc='展示当前用户有权限参与的填报计划、完成进度及截止时间。';body=psField('计划范围','仅展示当前用户可见且处于进行中的计划',psChips(p+'scopes',[['owned','我负责的'],['joined','我参与的'],['school','学院公开']]))+psField('首页展示数量','建议展示 3–5 个进行中的计划',psCount(p+'count','个'))+psField('进度展示','在计划卡片中展示填报完成比例',psToggle(p+'showProgress','进度展示'))+psField('详情跳转','点击计划卡片后的目标页面',psSelect(p+'destination',[['detail','填报中心 / 计划详情'],['statistics','表单详情 / 统计分析']]))}\n if(key==='notices'){desc='汇总平台公告、校务通知等重要消息，仅使用当前产品支持的消息来源。';body=psField('消息来源','选择需要汇总到首页的消息渠道',psChips(p+'sources',[['platform','平台公告'],['school','校务通知'],['system','系统消息'],['operations','运维提醒']]))+psField('首页展示数量','超过数量的消息可通过“查看全部”访问',psCount(p+'count'))+psField('详情跳转','点击提醒后的目标页面',psSelect(p+'destination',[['messages','消息中心 / 全部消息'],['task','填报中心 / 对应任务']]))}\n if(key==='recent'){desc='基于平台访问记录，为用户快速呈现最近使用过的应用和服务。';body=psField('首页展示数量','只配置首页展示，不改变访问记录的保留规则',psCount(p+'count'))+psField('排序方式','选择最近访问内容的排序逻辑','<div class=\"ps-chips\">'+[['time','按访问时间'],['count','按访问频次']].map(([v,n])=>'<button type=\"button\" aria-pressed=\"'+(portalValue(p+'sort')===v)+'\" class=\"'+(portalValue(p+'sort')===v?'selected':'')+'\" data-ps-action=\"choice\" data-path=\"'+p+'sort\" data-value=\"'+v+'\">'+n+(portalValue(p+'sort')===v?icon('check'):'')+'<\/button>').join('')+'<\/div>')+psField('空状态处理','用户暂无访问记录时的展示方式',psSelect(p+'empty',[['recommend','展示应用推荐'],['hide','隐藏模块']]))}\n if(key==='frequent'){desc='展示用户主动收藏的应用与服务，帮助用户快速进入高频使用的业务入口。';body=psField('首页展示数量','超过数量的收藏内容可通过“查看全部”访问',psCount(p+'count','个'))+psField('展示内容范围','选择首页需要展示的收藏类型',psChips(p+'types',[['service','应用服务'],['form','填报表单'],['report','数据报表']]))+psField('空状态处理','用户暂无收藏时的展示方式',psSelect(p+'empty',[['guide','展示收藏引导'],['hide','隐藏模块']]))+psField('查看全部跳转','用户点击“查看全部”后的目标页面',psSelect(p+'destination',[['favorites','应用中心 / 我的收藏'],['forms','表单中心 / 我的表单']]))}\n return '<div class=\"ps-module-layout\"><aside class=\"ps-module-nav\"><h2>可配置模块 <span>6<\/span><\/h2><nav aria-label=\"可配置模块\">'+Object.entries(PORTAL_MODULES).map(([v,[name,ic]])=>'<a href=\"#/portal-settings?section=modules&module='+v+'\" class=\"'+(key===v?'selected':'')+'\" '+(key===v?'aria-current=\"page\"':'')+'>'+icon(ic)+name+icon('chevron-right')+'<\/a>').join('')+'<\/nav><\/aside><section class=\"ps-module-panel\"><div class=\"ps-card-heading\"><div><h2>'+title+'<\/h2><p>'+desc+'<\/p><\/div>'+psButton(icon('external-link')+'查看首页效果','preview','data-device=\"desktop\"','text')+'<\/div><div class=\"ps-fields\">'+body+'<\/div>'+psInfo()+'<\/section><\/div>'\n}\nfunction portalStyleConfiguration(){const s=portalDraft().style;return '<section class=\"ps-card\"><h2>门户基础信息<\/h2><p>配置门户名称与描述信息，帮助用户识别当前工作台<\/p><div class=\"ps-base-fields\"><label>门户标题<input data-ps-value=\"style.title\" value=\"'+esc(s.title)+'\" maxlength=\"40\"><\/label><label>副标题<input data-ps-value=\"style.subtitle\" value=\"'+esc(s.subtitle)+'\" maxlength=\"80\"><\/label><label class=\"wide\">描述信息<textarea data-ps-value=\"style.description\" rows=\"3\" maxlength=\"300\">'+esc(s.description)+'<\/textarea><\/label><\/div><\/section><section class=\"ps-card\"><h2>视觉主题<\/h2><p>选择门户主色和背景风格，确保学校品牌的一致性<\/p><div class=\"ps-theme-row\"><div><label>主题色<\/label><div class=\"ps-swatches\">'+[['#07599f','高校深蓝'],['#006ee6','明亮蓝'],['#7352d6','紫色'],['#008568','绿色'],['#b8601b','橙色']].map(([v,n])=>'<button type=\"button\" title=\"'+n+'\" aria-label=\"'+n+'\" aria-pressed=\"'+(s.color===v)+'\" style=\"--swatch:'+v+'\" class=\"'+(s.color===v?'selected':'')+'\" data-ps-action=\"color\" data-value=\"'+v+'\"><\/button>').join('')+'<\/div><\/div><div><label>横幅背景<\/label><label class=\"ps-upload\">'+icon('upload')+' 上传背景图片<input id=\"portalBannerUpload\" type=\"file\" accept=\"image/png,image/jpeg,image/webp\" multiple><span class=\"sr-only\">上传背景图片<\/span><\/label><small>支持 PNG、JPG、WebP，单张不超过 2MB，最多 5 张<\/small><\/div><\/div><div class=\"ps-banner-mode\"><h3>横幅展示方式<\/h3><p>设置首页横幅背景的呈现方式，可选择单张背景或多图轮播<\/p><div class=\"ps-chips\">'+[['static','静态背景'],['carousel','轮播图']].map(([v,n])=>'<button type=\"button\" class=\"'+(s.bannerMode===v?'selected':'')+'\" aria-pressed=\"'+(s.bannerMode===v)+'\" data-ps-action=\"choice\" data-path=\"style.bannerMode\" data-value=\"'+v+'\">'+icon(s.bannerMode===v?'circle-dot':'circle')+n+'<\/button>').join('')+'<\/div>'+(s.bannerMode==='carousel'?'<div class=\"ps-carousel-options\">'+psField('轮播间隔','',psSelect('style.interval',[[3,'3 秒'],[5,'5 秒'],[8,'8 秒'],[10,'10 秒']]))+psField('切换效果','',psSelect('style.effect',[['fade','淡入淡出'],['slide','左右滑动']]))+'<p>'+icon('photo')+' 已上传 '+s.images.length+' 张横幅图片，支持拖拽调整轮播顺序<\/p><\/div>':'')+'<div class=\"ps-images\">'+s.images.map((img,i)=>'<div draggable=\"true\" data-ps-drag=\"image\" data-key=\"'+i+'\"><img src=\"'+img.data+'\" alt=\"横幅 '+(i+1)+'\"><span>'+esc(img.name)+'<\/span><div>'+psButton(icon('arrow-left'),'move','data-kind=\"image\" data-key=\"'+i+'\" data-dir=\"-1\" aria-label=\"前移横幅'+(i+1)+'\" '+(!i?'disabled':''),'icon')+psButton(icon('arrow-right'),'move','data-kind=\"image\" data-key=\"'+i+'\" data-dir=\"1\" aria-label=\"后移横幅'+(i+1)+'\" '+(i===s.images.length-1?'disabled':''),'icon')+psButton(icon('trash'),'remove-image','data-index=\"'+i+'\" aria-label=\"删除横幅'+(i+1)+'\"','icon')+'<\/div><\/div>').join('')+'<\/div><\/div><\/section>'}\nfunction portalApplicationCatalog(){return [{id:'fill',name:'我的填报',icon:'clipboard-list',url:'#/reporting?view=fill',group:'common'},{id:'audit',name:'我的审核',icon:'rubber-stamp',url:'#/reporting?view=audit',group:'common'},{id:'templates',name:'模板中心',icon:'template',url:'#/templates',group:'teaching'},{id:'team',name:'团队协作',icon:'users',url:'#/team',group:'office'},{id:'wiki',name:'知识文档',icon:'book',url:'#/wiki',group:'office'},{id:'progress',name:'填报进度',icon:'chart-bar',url:'#/reporting?view=progress',group:'data'}]}\nfunction portalManageApps(){const d=portalDraft().modules.services,catalog=portalApplicationCatalog();modal('管理分组与应用','<div class=\"ps-app-manager\">'+d.groupOrder.map((g,i)=>'<section draggable=\"true\" data-ps-drag=\"group\" data-key=\"'+g+'\"><header><strong>'+icon('grip-vertical')+PORTAL_GROUPS[g]+'<\/strong><div>'+psButton(icon('arrow-up'),'move','data-kind=\"group\" data-key=\"'+g+'\" data-dir=\"-1\" aria-label=\"上移'+PORTAL_GROUPS[g]+'\" '+(!i?'disabled':''),'icon')+psButton(icon('arrow-down'),'move','data-kind=\"group\" data-key=\"'+g+'\" data-dir=\"1\" aria-label=\"下移'+PORTAL_GROUPS[g]+'\" '+(i===d.groupOrder.length-1?'disabled':''),'icon')+'<\/div><\/header>'+portalSortApps(catalog.filter(a=>a.group===g),d).map(a=>'<div class=\"ps-app-row\" draggable=\"true\" data-ps-drag=\"app\" data-key=\"'+a.id+'\"><label><input type=\"checkbox\" data-ps-app=\"'+a.id+'\" '+(!d.excluded.includes(a.id)?'checked':'')+'>'+icon(a.icon)+a.name+'<\/label><div>'+psButton(icon('arrow-up'),'move','data-kind=\"app\" data-key=\"'+a.id+'\" data-dir=\"-1\" aria-label=\"上移'+a.name+'\"','icon')+psButton(icon('arrow-down'),'move','data-kind=\"app\" data-key=\"'+a.id+'\" data-dir=\"1\" aria-label=\"下移'+a.name+'\"','icon')+'<\/div><\/div>').join('')+'<\/section>').join('')+'<\/div>');portalDirtyLabel()}\nfunction portalSortApps(apps,cfg){const order=[...cfg.appOrder,...portalApplicationCatalog().map(a=>a.id)];return apps.sort((a,b)=>order.indexOf(a.id)-order.indexOf(b.id))}\nfunction portalWidget(key,cfg=portalSettings()){\n const m=cfg.modules[key];if(key==='services'){const catalog=portalApplicationCatalog();return '<section class=\"portal-widget widget-services\" data-widget=\"services\"><header><h2>应用导航<\/h2>'+psButton('全部应用 '+icon('chevron-right'),'all-apps','data-destination=\"'+m.destination+'\"','text')+'<\/header>'+cfg.modules.services.groupOrder.filter(g=>m.groups.includes(g)).map(g=>'<div class=\"portal-app-group\"><h3>'+PORTAL_GROUPS[g]+'<\/h3><div class=\"campus-services\">'+portalSortApps(catalog.filter(a=>a.group===g&&!m.excluded.includes(a.id)),m).map(a=>'<a href=\"'+a.url+'\">'+icon(a.icon)+'<span>'+a.name+'<\/span><\/a>').join('')+'<\/div><\/div>').join('')+(m.groups.length?'':'<div class=\"small-empty\">尚未选择导航分组<\/div>')+'<\/section>'}\n if(key==='progress'){const person=state().hub.profile?.name||'高源',dept=state().hub.profile?.department;const items=progressItems().filter(x=>(m.scopes.includes('owned')&&x.f.owner===person)||(m.scopes.includes('joined')&&x.tasks.some(t=>t.person===person))||(m.scopes.includes('school')&&(x.f.scope==='全校'||x.f.audience?.includes(dept)))).slice(0,m.count);return '<section class=\"portal-widget widget-progress\" data-widget=\"progress\"><header><h2>填报计划<\/h2><a href=\"#/reporting?view=progress\">全部计划 '+icon('chevron-right')+'<\/a><\/header><div class=\"campus-plans\">'+items.map(x=>'<button '+(m.destination==='statistics'?'data-ps-action=\"plan-stats\"':'data-action=\"progress-detail\"')+' data-id=\"'+esc(x.f.id)+'\" data-cycle=\"'+esc(x.cycle)+'\"><span><strong>'+esc(x.f.name)+'<\/strong><small>'+esc(x.cycle)+' · 截止 '+esc(x.f.end||'未设置')+'<\/small><\/span><span class=\"campus-plan-status\">'+(x.anonymous?x.records.length+' 份响应':x.done+' / '+x.tasks.length+' 已填')+'<\/span>'+(m.showProgress&&!x.anonymous?'<span class=\"campus-plan-bar\"><i style=\"width:'+(x.tasks.length?Math.round(x.done/x.tasks.length*100):0)+'%\"><\/i><\/span>':'')+'<\/button>').join('')+(items.length?'':'<div class=\"small-empty\">暂无可查看的填报计划<\/div>')+'<\/div><\/section>'}\n if(key==='work'){const available=m.types,kind=available.includes(ui.portalKind)?ui.portalKind:available[0],audit=kind==='audit',tasks=kind==='initiated'?workspaceTasks('fill').filter(t=>['已提交','已完成'].includes(t.fill)):workspaceTasks(audit?'audit':'fill').filter(t=>taskPending(t,audit?'audit':'fill'));const url=m.destination==='audit'?'#/reporting?view=audit':m.destination==='fill'?'#/reporting?view=fill':'#/reporting?view='+(audit?'audit':'fill')+'&status='+(audit?'待审核':'pending');return '<section class=\"portal-widget widget-work\" data-widget=\"work\"><header><h2>工作待办<\/h2><a href=\"'+url+'\">查看全部 '+icon('chevron-right')+'<\/a><\/header><div class=\"portal-task-tabs\">'+[['fill','待我填报'],['audit','待我审核'],['handling','待处理'],['initiated','我发起的']].filter(([k])=>available.includes(k)).map(([v,n])=>button(n,'portal-tab','data-kind=\"'+v+'\"',v===kind?'selected':'')).join('')+'<\/div>'+(available.length?tasks.slice(0,m.count).map(t=>portalTaskRow(t,audit?'audit':'fill')).join(''):'')+(!available.length||!tasks.length?'<div class=\"small-empty\">'+icon('circle-check')+'当前没有待办事项<\/div>':'')+'<\/section>'}\n if(key==='recent'||key==='frequent'){const s=state();let forms=key==='recent'?s.hub.recent.map(id=>form(id)).filter(f=>f&&!f.deleted):allForms().filter(f=>!f.deleted&&f.favorite&&m.types.includes(f.type==='业务报表'?'report':'form'));if(key==='recent'&&m.sort==='count')forms.sort((a,b)=>(s.hub.visits?.[b.id]?.count||0)-(s.hub.visits?.[a.id]?.count||0));if(!forms.length&&m.empty==='hide')return '';const recommended=key==='recent'&&!forms.length&&m.empty==='recommend';if(recommended)forms=allForms().filter(f=>!f.deleted).slice(0,m.count);return '<section class=\"portal-widget widget-'+key+'\" data-widget=\"'+key+'\"><header><h2>'+(key==='recent'?'最近访问':'我的收藏')+'<\/h2><a href=\"'+(key==='recent'?'#/home':m.destination==='forms'?'#/mine':'#/home?tab=favorite')+'\">'+(key==='recent'?'进入表单中心':'全部')+' '+icon('chevron-right')+'<\/a><\/header>'+(recommended?'<p class=\"portal-recommend\">暂无访问记录，为你推荐以下应用<\/p>':'')+'<div class=\"portal-form-list\">'+forms.slice(0,m.count).map(f=>'<button class=\"portal-form\" data-action=\"view\" data-id=\"'+esc(f.id)+'\"><span class=\"form-icon\">'+icon(f.type==='流程表单'?'git-branch':'forms')+'<\/span><span><strong>'+esc(f.name)+'<\/strong><small>'+esc(f.type)+' · '+esc(f.status)+'<\/small><\/span>'+icon(f.favorite?'star':'arrow-up-right')+'<\/button>').join('')+(forms.length?'':'<div class=\"small-empty\">'+icon('star')+'暂无收藏，可在表单中心将常用表单加入收藏。<a href=\"#/home\">前往收藏<\/a><\/div>')+'<\/div><\/section>'}\n const notes=workspaceNotifications().filter(({t,kind})=>!state().hub.readMessages.includes(t.id)&&m.sources.includes(t.fill==='已逾期'?'operations':t.fill==='已驳回'?'system':kind==='audit'?'school':'platform'));return '<section class=\"portal-widget widget-notices\" data-widget=\"notices\"><header><h2>重要提醒 <span>'+notes.length+'<\/span><\/h2><a href=\"#/messages\">全部消息 '+icon('chevron-right')+'<\/a><\/header>'+notes.slice(0,m.count).map(({t,kind})=>'<button class=\"portal-notice\" '+(m.destination==='task'?'data-action=\"workspace-task\"':'data-ps-action=\"messages\"')+' data-id=\"'+esc(t.id)+'\" data-kind=\"'+kind+'\"><span class=\"notice-dot\"><\/span><span><strong>'+(kind==='audit'?'有一项申请等待审核':t.fill==='已驳回'?'填报已退回，请修改':t.fill==='已逾期'?'有一项填报已逾期':'有一项填报待完成')+'<\/strong><small>'+esc(form(t.fid).name)+'<\/small><\/span>'+icon('chevron-right')+'<\/button>').join('')+(notes.length?'':'<div class=\"small-empty\">暂无重要提醒<\/div>')+'<\/section>'\n}\nfunction portalMarkup(cfg,preview=false){const fill=workspaceTasks('fill').filter(t=>taskPending(t,'fill')),audit=workspaceTasks('audit').filter(t=>taskPending(t,'audit')),late=workspaceTasks('fill').filter(activeOverdue),order=cfg.order.filter(k=>!cfg.hidden.includes(k)),feature=cfg.mode==='navigation'?'services':cfg.mode==='portal'?'notices':null;const cards=order.filter(k=>k!==feature).map(k=>({key:k,html:portalWidget(k,cfg)})).filter(c=>c.html).map((c,i)=>'<div class=\"portal-item\" style=\"order:'+i+'\">'+c.html+'<\/div>');return '<div class=\"portal-root\" style=\"--primary:'+cfg.style.color+';--portal-accent:'+cfg.style.color+'\"><section class=\"portal-hero '+(cfg.style.effect==='slide'?'portal-slide':'')+'\"><div class=\"portal-banners\" aria-hidden=\"true\">'+cfg.style.images.slice(0,cfg.style.bannerMode==='static'?1:5).map((im,i)=>'<img class=\"'+(!i?'active':'')+'\" src=\"'+im.data+'\" alt=\"\">').join('')+'<\/div><div class=\"portal-hero-inner\"><div class=\"portal-heading\"><div><h1>'+esc(cfg.style.title)+'<\/h1><span class=\"portal-department\">'+esc(cfg.style.subtitle)+'<\/span>'+(cfg.style.description?'<p class=\"portal-description\">'+esc(cfg.style.description)+'<\/p>':'')+'<\/div>'+(!preview?button(icon('adjustments-horizontal')+' 自定义门户','portal-settings','','secondary'):'')+'<\/div><div class=\"portal-overview\">'+[['待我填报',fill.length,'fill','clipboard-list'],['待我审核',audit.length,'audit','rubber-stamp'],['逾期事项',late.length,'overdue','clock-exclamation']].map(([n,v,k,ic])=>'<button data-action=\"portal-metric\" data-view=\"'+k+'\"><span>'+icon(ic)+n+'<\/span><strong>'+v+'<\/strong><\/button>').join('')+'<\/div><\/div>'+(cfg.style.bannerMode==='carousel'&&cfg.style.images.length>1?'<div class=\"portal-banner-dots\">'+cfg.style.images.map((_,i)=>'<button aria-label=\"显示横幅'+(i+1)+'\" aria-pressed=\"'+(!i)+'\" data-ps-slide=\"'+i+'\"><\/button>').join('')+'<\/div>':'')+'<\/section>'+(feature&&order.includes(feature)?'<div class=\"portal-feature\">'+portalWidget(feature,cfg)+'<\/div>':'')+'<div class=\"portal-grid '+(cfg.layout==='single'?'single':cfg.layout==='right-wide'?'right-wide':'equal-columns')+' '+(cfg.density==='compact'?'compact':'')+'\">'+[0,1].map(col=>'<div class=\"portal-column\">'+cards.filter((_,i)=>i%2===col).join('')+'<\/div>').join('')+'<\/div><\/div>'}\nfunction mountPortalCarousel(root,cfg){const images=[...root.querySelectorAll('.portal-banners img')],dots=[...root.querySelectorAll('[data-ps-slide]')];let index=0;const show=n=>{index=n;images.forEach((im,i)=>im.classList.toggle('active',i===n));dots.forEach((d,i)=>d.setAttribute('aria-pressed',String(i===n)))};dots.forEach((d,i)=>d.addEventListener('click',()=>show(i)));if(cfg.style.bannerMode==='carousel'&&images.length>1){const timer=setInterval(()=>{if(!root.isConnected)return clearInterval(timer);if(!root.querySelector('.portal-hero')?.matches(':hover')&&!document.hidden)show((index+1)%images.length)},Number(cfg.style.interval)*1000)}}\nfunction renderPortal(){const cfg=portalSettings();document.body.classList.add('portal-surface');$('hubMain').innerHTML=portalMarkup(cfg);mountPortalCarousel($('hubMain'),cfg);document.title=cfg.style.title+' · 竹简应用中台'}\nfunction previewPortal(device){const cfg=structuredClone(portalDraft());modal(device==='mobile'?'手机门户预览':'网页门户预览','<div class=\"ps-portal-preview '+(device==='mobile'?'mobile':'')+'\">'+portalMarkup(cfg,true)+'<\/div>');$('hubModal').classList.add('portal-preview-modal');mountPortalCarousel($('hubModal').querySelector('.ps-portal-preview'),cfg)}\nfunction movePortalItem(kind,key,dir,target){\n const d=portalDraft();let array=kind==='module'?d.order:kind==='image'?d.style.images:kind==='group'?d.modules.services.groupOrder:d.modules.services.appOrder;\n if(kind==='app'){const catalog=portalApplicationCatalog(),group=catalog.find(a=>a.id===key)?.group;if(target!==undefined&&catalog.find(a=>a.id===target)?.group!==group)return;array=portalSortApps(catalog.filter(a=>a.group===group),d.modules.services).map(a=>a.id)}\n const i=kind==='image'?Number(key):array.indexOf(key),next=target===undefined?i+dir:kind==='image'?Number(target):array.indexOf(target);if(i<0||next<0||next>=array.length||i===next)return;\n const [item]=array.splice(i,1);array.splice(next,0,item);if(kind==='app')d.modules.services.appOrder=[...array,...portalApplicationCatalog().map(a=>a.id).filter(id=>!array.includes(id))];\n if(kind==='app'||kind==='group')portalManageApps();else renderPortalSettings()\n}\nfunction savePortalConfiguration(){const d=portalDraft();if(!d.style.title.trim())return toast('请填写门户标题');if(d.hidden.length===Object.keys(PORTAL_MODULES).length)return toast('请至少保留一个展示模块');FormLinkState.update(s=>{s.hub.portal=structuredClone(d)});parent.Prototype.session.portalDraft=structuredClone(d);portalDirtyLabel();toast('门户配置已保存并发布')}\ndocument.addEventListener('input',e=>{if(e.target.matches('[data-ps-value]')&&!['checkbox','file'].includes(e.target.type)){const path=e.target.dataset.psValue;setPortalValue(path,e.target.value);portalDirtyLabel()}});\ndocument.addEventListener('change',async e=>{\n const input=e.target;if(input.matches('[data-ps-value]')){let value=input.type==='checkbox'?input.checked:input.value;if(/\\.(count|interval)$/.test(input.dataset.psValue))value=Number(value);setPortalValue(input.dataset.psValue,value);portalDirtyLabel()}\n if(input.matches('[data-ps-visible]')){const d=portalDraft(),key=input.dataset.psVisible;d.hidden=input.checked?d.hidden.filter(k=>k!==key):[...new Set([...d.hidden,key])];renderPortalSettings()}\n if(input.matches('[data-ps-app]')){const d=portalDraft().modules.services,key=input.dataset.psApp;d.excluded=input.checked?d.excluded.filter(k=>k!==key):[...new Set([...d.excluded,key])];portalDirtyLabel()}\n if(input.id==='portalBannerUpload'){\n  const files=[...input.files],images=portalDraft().style.images;if(images.length+files.length>5)return toast('最多上传 5 张横幅图片');if(files.some(f=>!['image/png','image/jpeg','image/webp'].includes(f.type)||f.size>2*1024*1024))return toast('请选择不超过 2MB 的 PNG、JPG 或 WebP 图片');\n  try{const added=await Promise.all(files.map(file=>new Promise((resolve,reject)=>{const url=URL.createObjectURL(file),im=new Image();im.onload=()=>{const canvas=document.createElement('canvas'),scale=Math.min(1,1600/im.width,900/im.height);canvas.width=Math.round(im.width*scale);canvas.height=Math.round(im.height*scale);canvas.getContext('2d').drawImage(im,0,0,canvas.width,canvas.height);URL.revokeObjectURL(url);resolve({name:file.name,data:canvas.toDataURL('image/webp',.82)})};im.onerror=()=>{URL.revokeObjectURL(url);reject(Error('图片无法读取'))};im.src=url})));images.push(...added);renderPortalSettings();toast('横幅图片已加入，保存并发布后生效')}catch{toast('图片无法读取，请重新选择')}\n }\n});\ndocument.addEventListener('click',e=>{\n const b=e.target.closest('[data-ps-action]');if(!b)return;const a=b.dataset.psAction,d=portalDraft();\n if(a==='mode'){d.mode=b.dataset.value;renderPortalSettings()}if(a==='layout'){d.layout=b.dataset.value;renderPortalSettings()}if(a==='color'){d.style.color=b.dataset.value;renderPortalSettings()}\n if(a==='chip'){const values=portalValue(b.dataset.path),v=b.dataset.value;setPortalValue(b.dataset.path,values.includes(v)?values.filter(k=>k!==v):[...values,v]);renderPortalSettings()}\n if(a==='choice'){setPortalValue(b.dataset.path,b.dataset.value);renderPortalSettings()}\n if(a==='reset-home'){const defaults=portalDefaults();Object.assign(d,{order:defaults.order,hidden:defaults.hidden,layout:defaults.layout,mode:defaults.mode});renderPortalSettings();toast('首页配置已恢复默认，保存后生效')}\n if(a==='save')savePortalConfiguration();if(a==='preview')previewPortal(b.dataset.device||'desktop');if(a==='manage-apps')portalManageApps();\n if(a==='preview-menu'){const panel=b.nextElementSibling;panel.hidden=false;b.setAttribute('aria-expanded','true')}\n if(a==='move')movePortalItem(b.dataset.kind,b.dataset.key,Number(b.dataset.dir));if(a==='remove-image'){d.style.images.splice(Number(b.dataset.index),1);renderPortalSettings()}\n if(a==='help')parent.document.querySelector('[data-help-content=\"guide\"]').click();\n if(a==='all-apps'){if(b.dataset.destination==='forms')parent.Prototype.navigate('#/mine');else{const cfg=portalSettings().modules.services;modal('全部应用','<div class=\"campus-services\">'+portalSortApps(portalApplicationCatalog().filter(x=>cfg.groups.includes(x.group)&&!cfg.excluded.includes(x.id)),cfg).map(x=>'<a href=\"'+x.url+'\">'+icon(x.icon)+x.name+'<\/a>').join('')+'<\/div>')}}\n if(a==='messages')parent.Prototype.navigate('#/messages');if(a==='plan-stats')openForm(b.dataset.id,'statistics');\n});\nlet portalDrag=null;\ndocument.addEventListener('dragstart',e=>{const item=e.target.closest('[data-ps-drag]');if(!item)return;portalDrag={kind:item.dataset.psDrag,key:item.dataset.key};e.dataTransfer.setData('text/plain',JSON.stringify(portalDrag));e.dataTransfer.effectAllowed='move'});\ndocument.addEventListener('dragover',e=>{const item=e.target.closest('[data-ps-drag]');if(portalDrag&&item?.dataset.psDrag===portalDrag.kind)e.preventDefault()});\ndocument.addEventListener('drop',e=>{const item=e.target.closest('[data-ps-drag]');if(!portalDrag||item?.dataset.psDrag!==portalDrag.kind)return;e.preventDefault();movePortalItem(portalDrag.kind,portalDrag.key,0,item.dataset.key);portalDrag=null});\ndocument.addEventListener('dragend',()=>portalDrag=null);\n\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst icon=n=>'<i class=\"ti ti-'+n+'\" aria-hidden=\"true\"><\/i>';\nconst route=__prototypeRoute.route;\nconst params=new URLSearchParams(__prototypeLocation.search);\nconst labels={portal:'应用门户',reporting:'填报中心',home:'首页',mine:'我的表单',team:'团队表单',wiki:'知识库',trash:'回收站',center:'表单中心',templates:'模板中心',messages:'消息'};\nif(!FormLinkState.read().hub){\n FormLinkState.update(s=>{\n  s.forms=s.forms||{};for(const f of FORMS)if(!s.forms[f.id])s.forms[f.id]={...f,docRef:{scope:['f2','f4','f11'].includes(f.id)?'team':['f6','f12'].includes(f.id)?'wiki':'mine',team:0,folder:f.category}};\n  if(!Array.isArray(s.tasks))s.tasks=TASKS;if(!Array.isArray(s.records))s.records=RECORDS;\n  s.hub={recent:FORMS.map(f=>f.id),readMessages:[],profile:{name:'高源',account:'admin',role:'系统管理员',department:'信息工程学院'}};\n });\n}\nconst ui={tab:params.get('tab')||'recent',type:params.get('typeFilter')||'全部类型',order:params.get('order')||'desc',query:params.get('q')||'',page:1,pageSize:8,messageTab:'all'};\nlet closeFocus=null,modalSubmit=null,toastTimer;\nfunction state(){return FormLinkState.read()}\nfunction allForms(){return Object.values(state().forms||{})}\nfunction form(id){return allForms().find(f=>f.id===id)}\nfunction modify(id,fn){FormLinkState.update(s=>{if(s.forms?.[id])fn(s.forms[id],s.hub,s)});}\nfunction toast(s){$('hubToast').textContent=s;$('hubToast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('hubToast').classList.remove('show'),2800)}\nfunction sync(){const q=new URLSearchParams();if(route==='home'&&ui.tab!=='recent')q.set('tab',ui.tab);if(ui.query)q.set('q',ui.query);if(ui.type!=='全部类型')q.set('typeFilter',ui.type);if(ui.order==='asc')q.set('order','asc');parent.Prototype.sync(route,q.size?'?'+q:'')}\nfunction link(f,page='overview',extra={}){return parent.Prototype.url('#/'+page+'?'+new URLSearchParams({form:f.id,ctx:JSON.stringify(f),...extra}))}\nfunction touch(id){FormLinkState.update(s=>{s.hub.recent=[id,...s.hub.recent.filter(x=>x!==id)];s.hub.visits=s.hub.visits||{};const v=s.hub.visits[id]||{count:0};s.hub.visits[id]={count:v.count+1,time:stamp()}})}\nfunction openForm(id,page){const f=form(id);if(!f)return;touch(id);parent.Prototype.navigate(link(f,page))}\nfunction button(text,action,attrs='',cls=''){return '<button type=\"button\" class=\"'+cls+'\" data-action=\"'+action+'\" '+attrs+'>'+text+'<\/button>'}\nfunction modal(title,body,submitLabel='',submit=null){$('hubModal').classList.remove('portal-preview-modal');closeFocus=document.activeElement;modalSubmit=submit;$('hubModal').innerHTML='<section class=\"hub-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dialogTitle\"><header><h2 id=\"dialogTitle\">'+title+'<\/h2>'+button(icon('x'),'close-modal','aria-label=\"关闭\"','icon-button')+'<\/header><div class=\"dialog-body\">'+body+'<p class=\"error\" id=\"dialogError\" role=\"alert\"><\/p><\/div><footer>'+button(submitLabel?'取消':'关闭','close-modal','','secondary')+(submitLabel?button(submitLabel,'modal-submit','','primary'):'')+'<\/footer><\/section>';$('hubModal').hidden=false;$('hubModal').querySelector('input,select,button')?.focus()}\nfunction closeModal(){$('hubModal').hidden=true;$('hubModal').innerHTML='';modalSubmit=null;closeFocus?.focus()}\nfunction create(template=null){modal(template?'使用模板':'新建表单','<label class=\"dialog-field\">表单名称<input id=\"newFormName\" maxlength=\"80\" placeholder=\"请输入表单名称\" value=\"'+esc(template?.name||'')+'\"><\/label><label class=\"dialog-field\">表单类型<select id=\"newFormType\">'+['普通表单','流程表单','业务报表'].map(t=>'<option'+(template?.type===t?' selected':'')+'>'+t+'<\/option>').join('')+'<\/select><\/label><label class=\"dialog-field\">保存位置<select id=\"newFormSpace\">'+[['mine','我的表单'],['team','团队表单'],['wiki','知识库']].map(([v,n])=>'<option value=\"'+v+'\"'+(route===v?' selected':'')+'>'+n+'<\/option>').join('')+'<\/select><\/label>','创建并编辑',()=>{const name=$('newFormName').value.trim();if(!name){$('dialogError').textContent='请输入表单名称。';return}const base=structuredClone(template||form('f1'));const id='new-'+Date.now();Object.assign(base,{id,name,type:$('newFormType').value,owner:'高源',status:'草稿',published:false,version:1,publishedVersion:undefined,draftVersion:undefined,releases:[],favorite:false,shared:false,deleted:false,updated:stamp(),docRef:{scope:$('newFormSpace').value,team:0,folder:'未分类'}});if(!template){delete base.fields;delete base.nodes}FormLinkState.update(s=>{s.forms[id]=base;s.hub.recent.unshift(id)});closeModal();openForm(id,'design')})}\nfunction stamp(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')+' '+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')}\nfunction rows(){const s=state();let list=allForms().filter(f=>route==='trash'?f.deleted:!f.deleted);if(route==='home'){if(ui.tab==='recent')list=list.filter(f=>s.hub.recent.includes(f.id));if(ui.tab==='favorite')list=list.filter(f=>f.favorite);if(ui.tab==='sharedWithMe')list=list.filter(f=>f.shared&&f.owner!=='高源');if(ui.tab==='sharedByMe')list=list.filter(f=>f.shared&&f.owner==='高源')}else if(['mine','team','wiki'].includes(route))list=list.filter(f=>(f.docRef?.scope||'mine')===route);if(ui.query)list=list.filter(f=>[f.name,f.owner].some(t=>t.includes(ui.query)));if(ui.type!=='全部类型')list=list.filter(f=>f.type===ui.type);list.sort((a,b)=>ui.order==='asc'?a.updated.localeCompare(b.updated):b.updated.localeCompare(a.updated));return list}\nfunction item(f){const attrs='data-id=\"'+esc(f.id)+'\"';return '<tr data-form-id=\"'+esc(f.id)+'\"><td><div class=\"form-name\"><span class=\"form-icon '+(f.type==='流程表单'?'flow':f.type==='业务报表'?'report':'')+'\">'+icon(f.type==='流程表单'?'git-branch':f.type==='业务报表'?'report-analytics':'forms')+'<\/span><div><button class=\"name-link\" data-action=\"view\" '+attrs+'>'+esc(f.name)+'<\/button><div class=\"form-meta\">'+esc(f.status)+'<span>·<\/span>'+esc(f.category)+(f.favorite?'<i class=\"ti ti-star-filled favorite-mark\" aria-label=\"已收藏\"><\/i>':'')+'<\/div><\/div><\/div><\/td><td><span class=\"type-label '+(f.type==='流程表单'?'flow':f.type==='业务报表'?'report':'')+'\">'+esc(f.type)+'<\/span><\/td><td><span class=\"mobile-label\">创建人<\/span>'+esc(f.owner)+'<\/td><td class=\"date-cell\"><span class=\"mobile-label\">更新时间<\/span>'+esc(f.updated)+'<\/td><td><div class=\"row-actions\">'+(route==='trash'?button('恢复','restore',attrs,'text-button'):button('分享','share',attrs,'text-button')+button('查看','view',attrs,'text-button')+button('编辑','edit',attrs,'text-button')+button(icon('dots'),'more',attrs+' aria-label=\"'+esc(f.name)+'的更多操作\" aria-haspopup=\"menu\"','icon-button'))+'<\/div><\/td><\/tr>'}\nfunction countTab(key){const all=allForms().filter(f=>!f.deleted);const s=state();return all.filter(f=>key==='recent'?s.hub.recent.includes(f.id):key==='favorite'?f.favorite:key==='sharedWithMe'?f.shared&&f.owner!=='高源':f.shared&&f.owner==='高源').length}\nfunction list(){$('hubMain').setAttribute('aria-label',labels[route]);const items=rows(),max=Math.max(1,Math.ceil(items.length/ui.pageSize));ui.page=Math.min(ui.page,max);const tabs=route==='home'?'<div class=\"list-tabs\" role=\"tablist\" aria-label=\"首页分类\">'+[['recent','最近'],['favorite','我的收藏'],['sharedWithMe','与我共享'],['sharedByMe','我共享的']].map(([v,n])=>'<button role=\"tab\" aria-selected=\"'+(ui.tab===v)+'\" class=\"'+(ui.tab===v?'selected':'')+'\" data-action=\"tab\" data-tab=\"'+v+'\">'+n+'<span>'+countTab(v)+'<\/span><\/button>').join('')+'<\/div>':'<div class=\"list-total\">'+items.length+'<span>个'+(route==='trash'?'已删除的':'')+'表单<\/span><\/div>';\n $('hubMain').innerHTML='<header class=\"hub-page-heading\"><h1>'+esc(route==='home'?'表单中心':labels[route])+'<\/h1><\/header><section class=\"list-panel\"><div class=\"list-toolbar\">'+tabs+'<label class=\"search-box\">'+icon('search')+'<input id=\"formSearch\" aria-label=\"搜索表单名称或创建人\" placeholder=\"搜索表单名称或创建人\" value=\"'+esc(ui.query)+'\">'+(ui.query?button(icon('x'),'clear-search','aria-label=\"清空搜索\"','icon-button'):'')+'<\/label>'+(route==='mine'?button(icon('plus')+' 新建表单','create','','primary toolbar-create'):'')+'<\/div><div class=\"forms-table-wrap\"><table class=\"forms-table\"><colgroup><col class=\"col-name\"><col class=\"col-type\"><col class=\"col-owner\"><col class=\"col-date\"><col class=\"col-actions\"><\/colgroup><thead><tr><th>表单名称<\/th><th><button class=\"header-control '+(ui.type!=='全部类型'?'active':'')+'\" id=\"typeFilter\" data-action=\"type-filter\" aria-haspopup=\"menu\" aria-expanded=\"false\">表单类型'+icon('filter')+(ui.type!=='全部类型'?'<span class=\"filter-indicator\"><\/span>':'')+'<\/button><\/th><th>创建人<\/th><th aria-sort=\"'+(ui.order==='asc'?'ascending':'descending')+'\"><button class=\"header-control\" data-action=\"sort\" aria-label=\"更新时间，当前'+(ui.order==='asc'?'升序':'降序')+'，点击切换\">更新时间'+icon(ui.order==='asc'?'sort-ascending':'sort-descending')+'<\/button><\/th><th>操作<\/th><\/tr><\/thead><tbody>'+items.slice((ui.page-1)*ui.pageSize,ui.page*ui.pageSize).map(item).join('')+'<\/tbody><\/table>'+(items.length?'':'<div class=\"empty-state\">'+icon('files-off')+'<h2>暂无表单<\/h2><p>'+(ui.query||ui.type!=='全部类型'?'试试其他关键词或清除筛选。':route==='trash'?'已删除的表单会显示在这里。':route==='home'&&ui.tab==='recent'?'打开表单后会再次出现在最近列表。':'这里还没有符合条件的表单。')+'<\/p>'+((ui.query||ui.type!=='全部类型')?button('清除筛选','reset','','secondary'):'')+'<\/div>')+'<\/div><div class=\"table-footer\"><span>共 '+items.length+' 个表单'+(ui.type!=='全部类型'?' · '+esc(ui.type):'')+'<\/span><div class=\"pager\">'+button(icon('chevron-left'),'prev','aria-label=\"上一页\" '+(ui.page<=1?'disabled':''),'icon-button')+'<span class=\"current-page\">'+ui.page+'<\/span><span class=\"page-total\">/ '+max+'<\/span>'+button(icon('chevron-right'),'next','aria-label=\"下一页\" '+(ui.page>=max?'disabled':''),'icon-button')+'<select id=\"pageSize\" aria-label=\"每页条数\">'+[8,16,24].map(n=>'<option'+(ui.pageSize===n?' selected':'')+' value=\"'+n+'\">'+n+' 条 / 页<\/option>').join('')+'<\/select><\/div><\/div><\/section>';\n $('formSearch').addEventListener('input',e=>{const pos=e.target.selectionStart;ui.query=e.target.value;ui.page=1;sync();list();$('formSearch').focus();$('formSearch').setSelectionRange(pos,pos)});$('pageSize').addEventListener('change',e=>{ui.pageSize=Number(e.target.value);ui.page=1;list()});document.title=labels[route]+' · 竹简应用中台';\n}\nfunction popover(anchor,html){removePopover();const p=document.createElement('div');p.id='hubPopover';p.className='hub-popover';p.setAttribute('role','menu');p.innerHTML=html;document.body.append(p);const r=anchor.getBoundingClientRect();p.style.top=Math.min(r.bottom+8,innerHeight-p.offsetHeight-12)+'px';p.style.left=Math.max(12,Math.min(r.right-p.offsetWidth,innerWidth-p.offsetWidth-12))+'px';p.querySelector('button')?.focus()}\nfunction removePopover(){$('hubPopover')?.remove();$('typeFilter')?.setAttribute('aria-expanded','false')}\nfunction share(id){const f=form(id);modal('分享表单','<div class=\"share-form-name\"><span class=\"form-icon\">'+icon('forms')+'<\/span><strong>'+esc(f.name)+'<\/strong><\/div><label class=\"dialog-field\">原型预览链接<div class=\"copy-field\"><input id=\"shareLink\" readonly value=\"'+esc(link(f,'overview'))+'\">'+button('复制链接','copy-link','','secondary')+'<\/div><\/label><div class=\"sharing-state\">'+icon(f.shared?'link':'lock')+'<div><strong>'+(f.shared?'已共享':'尚未共享')+'<\/strong><p>'+(f.shared?'此表单已显示在首页「我共享的」分类。':'开启后，此表单将显示在首页「我共享的」分类。')+'<\/p><\/div><\/div>',f.shared?'停止共享':'开启共享',()=>{modify(id,f=>{f.shared=!f.shared;f.updated=stamp()});closeModal();list();toast(form(id).shared?'已开启共享':'已停止共享')})}\nconst templateIds=['f1','f2','f3','f11'];\nfunction templates(){$('hubMain').innerHTML='<header class=\"hub-page-heading\"><h1>模板中心<\/h1><\/header><div class=\"template-grid\">'+templateIds.map(id=>{const f=form(id);return '<article class=\"template-card\"><div class=\"template-preview '+(f.type==='流程表单'?'flow':'')+'\">'+icon(f.type==='流程表单'?'git-branch':'forms')+'<span>'+esc(f.type)+'<\/span><\/div><div class=\"template-info\"><h2>'+esc(f.name)+'<\/h2><p>'+esc(f.category)+' · '+esc(f.identity)+'<\/p><div>'+button('预览','view','data-id=\"'+id+'\"','secondary')+button('使用模板','template','data-id=\"'+id+'\"','primary')+'<\/div><\/div><\/article>'}).join('')+'<\/div>'}\n\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b){if(!e.target.closest('#hubPopover'))removePopover();return}const a=b.dataset.action,id=b.dataset.id;if(a!=='more'&&a!=='type-filter')removePopover();\n if(a==='create')create();if(a==='close-modal')closeModal();if(a==='modal-submit')modalSubmit?.();if(a==='tab'){ui.tab=b.dataset.tab;ui.page=1;sync();list()}if(a==='view'||a==='edit')openForm(id,a==='edit'?'design':'overview');\n if(a==='more'){const f=form(id);popover(b,button(icon(f.favorite?'star-off':'star')+(f.favorite?'取消收藏':'添加收藏'),'favorite','data-id=\"'+id+'\" role=\"menuitem\"')+button(icon('history-toggle')+'从最近列表移除','remove-recent','data-id=\"'+id+'\" role=\"menuitem\"')+button(icon('trash')+'删除','delete','data-id=\"'+id+'\" role=\"menuitem\"','danger'))}\n if(a==='favorite'){modify(id,f=>f.favorite=!f.favorite);list();toast(form(id).favorite?'已添加收藏':'已取消收藏')}\n if(a==='remove-recent'){FormLinkState.update(s=>s.hub.recent=s.hub.recent.filter(x=>x!==id));list();toast('已从最近列表移除，表单仍保留在原位置')}\n if(a==='delete')modal('删除表单','<p>确定将「'+esc(form(id).name)+'」移至回收站？<\/p><p class=\"muted\">删除后可在回收站恢复，已有表单配置和填报数据会保留。<\/p>','移至回收站',()=>{modify(id,f=>f.deleted=true);closeModal();list();toast('已移至回收站')});\n if(a==='restore'){modify(id,f=>f.deleted=false);list();toast('表单已恢复至原位置')}\n if(a==='share')share(id);if(a==='copy-link')navigator.clipboard.writeText($('shareLink').value).then(()=>toast('链接已复制')).catch(()=>{$('shareLink').select();toast('请选择并复制链接')});\n if(a==='type-filter'){popover(b,['全部类型','普通表单','流程表单','业务报表'].map(t=>button(t+icon(ui.type===t?'check':'circle'),'filter-type','data-type=\"'+t+'\" role=\"menuitemradio\" aria-checked=\"'+(ui.type===t)+'\"',ui.type===t?'selected':'')).join(''));$('typeFilter').setAttribute('aria-expanded','true')}\n if(a==='filter-type'){ui.type=b.dataset.type;ui.page=1;sync();list()}if(a==='sort'){ui.order=ui.order==='asc'?'desc':'asc';ui.page=1;sync();list();toast('已按更新时间'+(ui.order==='asc'?'升序':'降序')+'排列')}\n if(a==='prev'||a==='next'){ui.page+=a==='next'?1:-1;list()}if(a==='clear-search'){ui.query='';ui.page=1;sync();list()}if(a==='reset'){ui.query='';ui.type='全部类型';ui.page=1;sync();list()}\n if(a==='template')create(form(id));if(a==='message-tab'){ui.messageTab=b.dataset.tab;renderMessages()}if(a==='read-all'){FormLinkState.update(s=>{s.hub.readMessages=[...new Set([...(s.hub.readMessages||[]),...workspaceNotifications().map(({t})=>t.id)])]});renderMessages();toast('消息已全部标为已读')}\n if(a==='task')openWorkspaceTask(id);\n if(handleWorkspaceAction(a,b))return;\n});\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();removePopover()}if(e.key==='Tab'&&!$('hubModal').hidden){const inputs=[...$('hubModal').querySelectorAll('input,select,button,textarea,a[href]')].filter(e=>!e.disabled);if(e.shiftKey&&document.activeElement===inputs[0]){e.preventDefault();inputs.at(-1)?.focus()}else if(!e.shiftKey&&document.activeElement===inputs.at(-1)){e.preventDefault();inputs[0]?.focus()}}});\n$('hubModal').addEventListener('click',e=>{if(e.target===$('hubModal'))closeModal()});\nwindow.HubOpenCreate=create;\nwindow.PrototypeSnapshot=()=>{};\nif(route==='portal-settings')renderPortalSettings();else if(route==='portal')renderPortal();else if(route==='reporting')renderReporting();else if(route==='templates')templates();else if(route==='messages')renderMessages();else list();\nif(params.get('create')==='1')create();\n\nfunction workspaceTasks(kind){\n return parent.Prototype.tasks(kind);\n}\nfunction taskPending(t,kind){return kind==='audit'?t.audit==='待审核':canWorkspaceFill(t,form(t.fid))}\nfunction activeOverdue(t){const f=form(t.fid);return t.fill==='已逾期'&&f?.published&&f.status==='收集中'&&!f.deleted}\nfunction canWorkspaceFill(t,f){return f.published&&!f.deleted&&f.status==='收集中'&&(['未填报','填报中','已驳回'].includes(t.fill)||(t.fill==='已逾期'&&f.late==='允许补填并标记逾期'))}\nfunction taskButton(t,kind){const f=form(t.fid);return kind==='audit'?(t.audit==='待审核'?'去审核':'查看审核'):canWorkspaceFill(t,f)?(t.fill==='填报中'?'继续填写':t.fill==='已驳回'?'修改重交':'去填报'):'查看任务'}\nfunction taskStatus(text){return '<span class=\"task-status '+(['待审核','未填报','填报中'].includes(text)?'pending':['已驳回','已逾期'].includes(text)?'attention':['已完成','已通过'].includes(text)?'success':'')+'\">'+esc(text)+'<\/span>'}\nfunction openWorkspaceTask(id,kind){\n const s=state(),t=s.tasks?.find(t=>t.id===id);if(!t)return;kind=kind||ui.taskKind||(t.audit==='待审核'?'audit':'fill');\n if(!workspaceTasks(kind).some(x=>x.id===id))return toast('当前没有此任务的办理权限');\n const f=form(t.fid);FormLinkState.update(s=>{if(!s.hub.readMessages.includes(id))s.hub.readMessages.push(id)});\n parent.Prototype.navigate('#/participate?'+new URLSearchParams({type:'form',formView:kind,form:f.id,ctx:JSON.stringify(f),origin:route==='portal'?'portal':route==='messages'?'messages':'reporting',returnTo:parent.Prototype.current.hash,...(kind==='audit'?{review:id}:{task:id})}));\n}\nfunction workspaceNotifications(){\n const reminders=new Map();\n for(const kind of ['fill','audit'])for(const t of workspaceTasks(kind).filter(t=>taskPending(t,kind)||(kind==='fill'&&activeOverdue(t))))reminders.set(kind+':'+t.id,{t,kind});\n return [...reminders.values()];\n}\nfunction reportAccess(f){\n const d=(state().documents||[]).find(d=>d.fid===f.id),permission=d?.permission||(f.owner==='高源'?'管理':'查看');\n const member=f.permissionRows?.find(p=>p.name==='高源');\n const cfg=HUB_DATA_ACCESS[f.id]||(permission==='管理'?{data:member?!!member.data:true,statistics:member?!!member.stats:true,scope:member?.scope==='全部授权范围'?'all':member?.scope||'all'}:{});\n return {stats:!!cfg.statistics&&['管理','编辑','查看'].includes(permission),data:!!cfg.data&&['管理','编辑','查看'].includes(permission),scope:cfg.scope||'all'};\n}\nfunction progressItems(){\n const s=state(),out=[];\n for(const f of allForms().filter(f=>f.published&&!f.deleted)){\n  const access=reportAccess(f);if(!access.stats)continue;\n  let tasks=(s.tasks||[]).filter(t=>t.fid===f.id),records=(s.records||[]).filter(r=>r.fid===f.id&&!r.withdrawn);\n  if(access.scope!=='all'){tasks=tasks.filter(t=>t.dept===access.scope);records=records.filter(r=>(s.tasks?.find(t=>t.id===r.tid)?.dept||r.dept)===access.scope)}\n  const cycles=ui.progressPeriod==='all'?[...new Set([...tasks.map(t=>t.cycle),...records.map(r=>r.cycle)])]:[hubCycleKey(f)];\n  for(const cycle of cycles){const currentTasks=tasks.filter(t=>t.cycle===cycle),currentRecords=records.filter(r=>r.cycle===cycle);out.push({f,access,cycle,tasks:currentTasks,records:currentRecords,anonymous:f.identity!=='实名填报',done:currentTasks.filter(t=>['已提交','已完成'].includes(t.fill)).length})}\n }\n return out.filter(x=>!ui.reportQuery||x.f.name.includes(ui.reportQuery));\n}\nfunction openProgress(id,cycle){\n const x=progressItems().find(x=>x.f.id===id&&x.cycle===cycle);if(!x)return;\n const scope=x.access.scope==='all'?'全部授权范围':x.access.scope;\n const statsLink=link(x.f,'statistics',{role:x.access.scope!=='all'?'department':'statistics',origin:'reporting',cycle:x.cycle,returnTo:parent.Prototype.current.hash});\n const counts='<div class=\"detail-metrics\">'+[['应填对象',x.anonymous?'—':x.tasks.length],['已提交',x.anonymous?x.records.length:x.done],['未提交',x.anonymous?'—':x.tasks.length-x.done]].map(([n,v])=>'<div><small>'+n+'<\/small><strong>'+v+'<\/strong><\/div>').join('')+'<\/div>';\n let body='<div class=\"progress-detail-head\"><strong>'+esc(x.f.name)+'<\/strong><span>'+esc(x.cycle)+' · '+esc(scope)+'<\/span><\/div>'+counts;\n if(x.anonymous)body+='<div class=\"privacy-note\">'+icon('shield-lock')+'匿名收集，仅展示响应汇总，不展示人员与组织身份。<\/div>';\n else if(!x.access.data)body+='<div class=\"privacy-note\">'+icon('lock')+'当前仅有统计权限，不展示人员明细。<\/div>';\n else body+='<div class=\"progress-detail-table\"><table><thead><tr><th>填报人<\/th><th>所属单位<\/th><th>填报状态<\/th><th>提交时间<\/th><\/tr><\/thead><tbody>'+x.tasks.map(t=>'<tr><td>'+esc(t.person)+'<\/td><td>'+esc(t.dept)+'<\/td><td>'+taskStatus(t.fill)+'<\/td><td>'+esc(t.submitted||'—')+'<\/td><\/tr>').join('')+'<\/tbody><\/table>'+(x.tasks.length?'':'<div class=\"small-empty\">本周期尚未生成填报任务<\/div>')+'<\/div>';\n body+='<div class=\"detail-link\"><a href=\"'+esc(statsLink)+'\">打开统计分析 '+icon('arrow-up-right')+'<\/a><\/div>';\n modal('填报进度',body);\n}\nfunction reportSync(){const q=new URLSearchParams();q.set('view',ui.reportView);if(ui.reportStatus!=='all')q.set('status',ui.reportStatus);if(ui.reportQuery)q.set('q',ui.reportQuery);if(ui.progressPeriod==='all')q.set('period','all');parent.Prototype.sync('reporting','?'+q)}\nfunction renderReporting(){\n ui.reportView=ui.reportView||(['fill','audit','progress'].includes(params.get('view'))?params.get('view'):'fill');ui.taskKind=ui.reportView==='audit'?'audit':'fill';\n ui.reportStatus=ui.reportStatus||params.get('status')||'all';ui.reportQuery=ui.reportQuery??params.get('q')??'';ui.progressPeriod=ui.progressPeriod||params.get('period')||'current';\n const view=ui.reportView;$('hubMain').setAttribute('aria-label',view==='audit'?'我的审核':view==='progress'?'填报进度':'我的填报');\n let toolbar='<label class=\"search-box\">'+icon('search')+'<input id=\"reportSearch\" aria-label=\"搜索填报任务\" placeholder=\"搜索表单名称\" value=\"'+esc(ui.reportQuery)+'\"><\/label>';\n if(view==='progress')toolbar+='<select id=\"progressPeriod\" aria-label=\"统计周期\"><option value=\"current\"'+(ui.progressPeriod==='current'?' selected':'')+'>当前周期<\/option><option value=\"all\"'+(ui.progressPeriod==='all'?' selected':'')+'>全部周期<\/option><\/select>';\n else toolbar+='<select id=\"reportStatus\" aria-label=\"任务状态\">'+(view==='audit'?[['all','全部审核状态'],['待审核','待审核'],['已通过','已通过'],['已驳回','已驳回']]:[['all','全部填报状态'],['pending','待我填报'],['未填报','未填报'],['填报中','填报中'],['已提交','已提交'],['已完成','已完成'],['已驳回','已驳回'],['已逾期','已逾期']]).map(([v,n])=>'<option value=\"'+v+'\"'+(ui.reportStatus===v?' selected':'')+'>'+n+'<\/option>').join('')+'<\/select>';\n let headers,body,total;\n if(view==='progress'){\n  const list=progressItems();total=list.length;headers=['表单名称','填报周期','应填 / 已填 / 未填','完成率','操作'];body=list.map(x=>{const p=x.tasks.length?Math.round(x.done/x.tasks.length*100):null;return '<tr><td><div class=\"task-name\">'+icon(x.f.type==='流程表单'?'git-branch':'forms')+'<div><strong>'+esc(x.f.name)+'<\/strong><small>'+esc(x.access.scope==='all'?'全部授权范围':x.access.scope)+'<\/small><\/div><\/div><\/td><td>'+esc(x.cycle)+'<\/td><td>'+(x.anonymous?'<span class=\"muted\">匿名响应<\/span> <strong>'+x.records.length+'<\/strong>':'<span class=\"count-triple\">'+x.tasks.length+' <span>/<\/span> '+x.done+' <span>/<\/span> '+(x.tasks.length-x.done)+'<\/span>')+'<\/td><td>'+(x.anonymous?'<span class=\"muted\">仅汇总响应<\/span>':p===null?'<span class=\"muted\">未生成任务<\/span>':'<div class=\"completion\"><div><span style=\"width:'+p+'%\"><\/span><\/div><span>'+p+'%<\/span><\/div>')+'<\/td><td>'+button('查看进度','progress-detail','data-id=\"'+esc(x.f.id)+'\" data-cycle=\"'+esc(x.cycle)+'\"','text-button')+'<\/td><\/tr>'}).join('');\n }else{\n  let tasks=workspaceTasks(view);if(ui.reportStatus!=='all')tasks=tasks.filter(t=>ui.reportStatus==='pending'?taskPending(t,view):(view==='audit'?t.audit:t.fill)===ui.reportStatus);if(ui.reportQuery)tasks=tasks.filter(t=>form(t.fid).name.includes(ui.reportQuery));total=tasks.length;\n  tasks.sort((a,b)=>(taskPending(b,view)?1:0)-(taskPending(a,view)?1:0)||a.due.localeCompare(b.due));\n  headers=view==='audit'?['表单名称','提交人','填报周期','当前节点','审核状态','操作']:['表单名称','填报周期','截止时间','填报状态','审核状态','操作'];\n  body=tasks.map(t=>{const f=form(t.fid);return '<tr data-report-task=\"'+esc(t.id)+'\"><td><div class=\"task-name\">'+icon(view==='audit'?'rubber-stamp':'clipboard-list')+'<div><strong>'+esc(f.name)+'<\/strong><small>'+esc(f.type)+'<\/small><\/div><\/div><\/td>'+(view==='audit'?'<td>'+esc(f.identity==='实名填报'?t.person:'匿名提交')+'<\/td><td>'+esc(t.cycle)+'<\/td><td>'+esc(t.node||'—')+'<\/td><td>'+taskStatus(t.audit)+'<\/td>':'<td>'+esc(t.cycle)+'<\/td><td class=\"deadline '+(t.fill==='已逾期'?'late':'')+'\">'+esc(t.due)+'<\/td><td>'+taskStatus(t.fill)+'<\/td><td>'+taskStatus(t.audit)+'<\/td>')+'<td>'+button(taskButton(t,view),'workspace-task','data-id=\"'+esc(t.id)+'\" data-kind=\"'+view+'\"','text-button')+'<\/td><\/tr>'}).join('');\n }\n $('hubMain').innerHTML='<header class=\"hub-page-heading\"><h1>'+esc($('hubMain').getAttribute('aria-label'))+'<\/h1><\/header><section class=\"task-panel\"><div class=\"workspace-toolbar\"><span class=\"list-total\">'+total+'<span>项'+(view==='progress'?'填报计划':'任务')+'<\/span><\/span><div class=\"toolbar-controls\">'+toolbar+'<\/div><\/div><div class=\"task-table-wrap\"><table class=\"task-table\"><thead><tr>'+headers.map(h=>'<th>'+h+'<\/th>').join('')+'<\/tr><\/thead><tbody>'+body+'<\/tbody><\/table>'+(total?'':'<div class=\"empty-state\">'+icon('circle-check')+'<h2>'+(view==='progress'?'暂无匹配的填报计划':'暂无匹配的任务')+'<\/h2>'+((ui.reportQuery||ui.reportStatus!=='all')?'<p>调整搜索或状态筛选后重试。<\/p>':'')+'<\/div>')+'<\/div><\/section>';\n for(const row of document.querySelectorAll('.task-table tbody tr'))[...row.cells].forEach((cell,i)=>cell.dataset.label=headers[i]);\n $('reportSearch').addEventListener('input',e=>{const n=e.target.selectionStart;ui.reportQuery=e.target.value;reportSync();renderReporting();$('reportSearch').focus();$('reportSearch').setSelectionRange(n,n)});\n $('reportStatus')?.addEventListener('change',e=>{ui.reportStatus=e.target.value;reportSync();renderReporting()});$('progressPeriod')?.addEventListener('change',e=>{ui.progressPeriod=e.target.value;reportSync();renderReporting()});\n document.title=(view==='audit'?'我的审核':view==='progress'?'填报进度':'我的填报')+' · 竹简应用中台';\n}\nfunction portalTaskRow(t,kind){const f=form(t.fid);return '<div class=\"portal-task\"><div><strong>'+esc(f.name)+'<\/strong><small>'+esc(kind==='audit'?(f.identity==='实名填报'?t.person:'匿名提交')+' · '+t.node:t.cycle+' · 截止 '+t.due.slice(5))+'<\/small><\/div>'+taskStatus(kind==='audit'?t.audit:t.fill)+button(taskButton(t,kind),'workspace-task','data-id=\"'+esc(t.id)+'\" data-kind=\"'+kind+'\" data-primary=\"'+(['去填报','去审核'].includes(taskButton(t,kind)))+'\"','text-button')+'<\/div>'}\nfunction renderMessages(){\n const s=state(),all=workspaceNotifications(),notes=all.filter(({t})=>ui.messageTab!=='unread'||!s.hub.readMessages.includes(t.id));\n $('hubMain').innerHTML='<header class=\"hub-page-heading\"><h1>消息<\/h1><\/header><section class=\"message-panel\"><div class=\"workspace-toolbar\"><div class=\"list-tabs\">'+[['all','全部消息'],['unread','未读消息']].map(([v,n])=>button(n,'message-tab','data-tab=\"'+v+'\"',ui.messageTab===v?'selected':'')).join('')+'<\/div>'+button('全部标为已读','read-all','','secondary')+'<\/div><div class=\"message-list\">'+notes.map(({t,kind})=>'<article class=\"message-row '+(s.hub.readMessages.includes(t.id)?'read':'')+'\"><span class=\"message-symbol\">'+icon(kind==='audit'?'rubber-stamp':'clipboard-list')+'<\/span><div><h2>'+(!s.hub.readMessages.includes(t.id)?'<span class=\"unread-dot\"><\/span>':'')+(kind==='audit'?'审核提醒':'填报提醒')+'<\/h2><p>'+esc(form(t.fid).name)+'<span> · '+esc(t.cycle)+'<\/span><\/p><small>'+(kind==='audit'?'提交人：'+esc(form(t.fid).identity==='实名填报'?t.person:'匿名提交'):'截止时间：'+esc(t.due))+'<\/small><\/div>'+button('查看任务','workspace-task','data-id=\"'+esc(t.id)+'\" data-kind=\"'+kind+'\"','secondary')+'<\/article>').join('')+(notes.length?'':'<div class=\"empty-state\">'+icon('bell-check')+'<h2>暂无未读消息<\/h2><\/div>')+'<\/div><\/section>';\n}\nfunction handleWorkspaceAction(a,b){\n if(a==='workspace-task'){openWorkspaceTask(b.dataset.id,b.dataset.kind);return true}\n if(a==='portal-settings'){parent.Prototype.navigate('#/portal-settings?section=home');return true}\n if(a==='portal-tab'){ui.portalKind=b.dataset.kind;parent.Prototype.sync('portal','?work='+ui.portalKind);renderPortal();return true}\n if(a==='portal-metric'){const view=b.dataset.view;parent.Prototype.navigate('#/reporting?view='+(view==='audit'?'audit':'fill')+'&status='+(view==='overdue'?'已逾期':view==='audit'?'待审核':'pending'));return true}\n if(a==='progress-detail'){openProgress(b.dataset.id,b.dataset.cycle);return true}\n\n return false;\n}\n"}},"routes":{"portal":["hub","portal","应用门户","应用门户.html"],"home":["hub","home","首页","工作台.html"],"mine":["hub","mine","我的表单","文档中心-我的文档.html"],"team":["hub","team","团队表单","文档中心-团队文档.html"],"wiki":["hub","wiki","知识库","文档中心-知识库.html"],"trash":["hub","trash","回收站","回收站.html"],"center":["hub","center","表单中心","表单中心.html"],"reporting":["hub","reporting","填报中心","填报中心.html"],"templates":["hub","templates","模板中心","模板中心.html"],"messages":["hub","messages","消息","消息.html"],"overview":["forms","overview","基本信息","文档中心-表单详情-基本信息.html"],"design":["forms","design","表单设计","文档中心-表单详情-表单设计.html"],"settings":["forms","settings","填报设置","文档中心-表单详情-填报设置.html"],"permissions":["forms","permissions","授权管理","文档中心-表单详情-授权管理.html"],"workflow":["forms","workflow","审核流程","文档中心-表单详情-审核流程.html"],"records":["forms","records","填报数据","文档中心-表单详情-填报数据.html"],"statistics":["forms","statistics","统计分析","文档中心-表单详情-统计分析.html"],"publish":["forms","publish","发布管理","文档中心-表单详情-发布管理.html"],"logs":["forms","logs","操作日志","文档中心-表单详情-操作日志.html"],"publish-config":["forms","publish-config","表单发布","表单配置-表单发布.html"],"portal-settings":["hub","portal-settings","设置中心","门户管理-设置中心.html"],"participate":["docs","mine","填报与审核","在线表单-填写.html"]}}</script>
<script>(() => {
  'use strict';
  const data = JSON.parse(document.getElementById('prototypeData').textContent);
  const commonStyle=document.createElement('style');commonStyle.textContent=data.common;document.head.prepend(commonStyle);
  const frame = document.getElementById('prototypeView');
  const error = document.getElementById('routeError');
  const fileRoutes = new Map(Object.entries(data.routes).map(([key, value]) => [value[3], key]));
  const storageKey = 'smart-forms-standalone-v1';
  let state = {};
  try { state = JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch { /* file: storage can be unavailable. */ }
  if (!state || typeof state !== 'object' || Array.isArray(state)) state = {};
  const clone = value => JSON.parse(JSON.stringify(value));
  const save = () => { try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch { /* Keep the active session functional. */ } };
  const linked = {
    read: () => clone(state),
    update(callback) { const next = clone(state); callback(next); state = clone(next); save(); updateBadge(); }
  };
  let renderedHash = null;
  let rendering = false;
  let current = null;

  function resolve(target) {
    const text = String(target || '#/portal');
    let route, query;
    if (text.startsWith('#/')) {
      const end = text.indexOf('?');
      route = text.slice(2, end < 0 ? undefined : end);
      query = end < 0 ? '' : text.slice(end);
    } else {
      const base = new URL(current ? current.file : data.routes.portal[3], location.href.split('#')[0]);
      const url = new URL(text, base);
      if (url.hash.startsWith('#/')) return resolve(url.hash);
      const file = decodeURIComponent(url.pathname.split('/').pop());
      route = fileRoutes.get(file);
      query = url.search;
      if (!route) throw new Error('未收录的原型页面：' + file);
    }
    const options=new URLSearchParams(query||'');
    if(['mine','participate'].includes(route)&&['fill','audit'].includes(options.get('formView'))&&!options.has('task')&&!options.has('review')&&!options.has('preview')){
      const translated=new URLSearchParams({view:options.get('formView')});
      if(options.get('fillStatus'))translated.set('status',options.get('fillStatus'));
      const formId=options.get('form');if(formId&&state.forms?.[formId])translated.set('q',state.forms[formId].name);
      route='reporting';query='?'+translated;
    }else if(route==='mine'&&(options.has('task')||options.has('review')||options.has('preview')))route='participate';
    if(route==='mine'&&options.get('view')==='recent')route='home';
    if(route==='mine'&&options.get('view')==='trash')route='trash';
    if (!Object.hasOwn(data.routes, route)) throw new Error('未收录的原型路由：' + route);
    const [family, page, title, file] = data.routes[route];
    return {route, family, page, title, file, search: query || '', hash: '#/' + route + (query || '')};
  }

  function url(target) {
    const route = resolve(target);
    const address = new URL(location.href);
    address.search = '';
    address.hash = route.hash;
    return address.href;
  }

  function snapshot() {
    if (current && frame.contentWindow?.PrototypeSnapshot) frame.contentWindow.PrototypeSnapshot();
  }

  function childBridge(route) {
    const routeJSON = JSON.stringify(route).replace(/</g, '\\u003c');
    return `
const __prototypeRoute=${routeJSON};
const FormLinkState=parent.Prototype.linked;
const __prototypeLocation={
 get search(){return parent.Prototype.current.search;},
 get pathname(){return '/'+__prototypeRoute.file;},
 get href(){return new URL(__prototypeRoute.file+this.search,parent.location.href.split('#')[0]).href;},
 set href(value){parent.Prototype.navigate(value);},
 assign(value){parent.Prototype.navigate(value);},
 replace(value){parent.Prototype.navigate(value,true);},
 reload(){parent.Prototype.reload();}
};
const __prototypeHistory={replaceState(_state,_title,value){
 const next=new URL(value,__prototypeLocation.href);
 parent.Prototype.sync(__prototypeRoute.route,next.search);
}};
const __prototypeNav={mine:'文档中心-我的文档.html',team:'文档中心-团队文档.html',wiki:'文档中心-知识库.html',recent:'文档中心-我的文档.html?view=recent',trash:'文档中心-我的文档.html?view=trash'};
const __prototypeKnown=new Set(${JSON.stringify([...fileRoutes.keys()])});
function __prototypeTarget(anchor){
 const raw=anchor.getAttribute('href')||'';
 if(anchor.hasAttribute('download')||/^(blob:|data:|mailto:|tel:)/i.test(raw))return null;
 if(anchor.dataset.nav&&__prototypeNav[anchor.dataset.nav])return __prototypeNav[anchor.dataset.nav];
 if(!raw||(raw.startsWith('#')&&!raw.startsWith('#/')))return null;
 try{
  const address=new URL(raw,__prototypeLocation.href);
  if(address.hash.startsWith('#/'))return address.hash;
  const name=decodeURIComponent(address.pathname.split('/').pop());
  if(__prototypeKnown.has(name))return name+address.search;
 }catch{}
 return null;
}
function __prototypeNormalizeLinks(){
 for(const anchor of document.querySelectorAll('a[href]')){
  const target=__prototypeTarget(anchor);
  if(!target)continue;
  const address=parent.Prototype.url(target);
  if(anchor.getAttribute('href')!==address)anchor.setAttribute('href',address);
 }
 parent.document.title=document.title||__prototypeRoute.title+' · 竹简应用中台';
}
document.addEventListener('click',event=>{
 const anchor=event.target.closest('a[href]');
 if(anchor){
  let target=__prototypeTarget(anchor);
  if(target){
   if(anchor.dataset.route&&typeof href==='function'&&typeof formById==='function'){
    const form=formById(anchor.dataset.formRef);
    if(form)target=href(anchor.dataset.route,form,JSON.parse(anchor.dataset.routeExtra||'{}'));
   }
   anchor.href=parent.Prototype.url(target);
   if(__prototypeRoute.family==='docs'&&anchor.dataset.nav&&__prototypeNav[anchor.dataset.nav]){
    if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||anchor.target==='_blank'){
     event.stopImmediatePropagation();return;
    }
    queueMicrotask(()=>{
     const next=window.PrototypeCurrentRoute?.();
     if(next)parent.Prototype.sync(next.route,next.search);
    });
    return;
   }
   if(!event.ctrlKey&&!event.metaKey&&!event.shiftKey&&!event.altKey&&anchor.target!=='_blank'){
    event.preventDefault();event.stopImmediatePropagation();parent.Prototype.navigate(target);
   }
  }
 }
 const workbench=event.target.closest('[data-action="wb-tab"]');
 if(workbench)queueMicrotask(()=>parent.Prototype.sync('portal','?tab='+encodeURIComponent(workbench.dataset.tab)));
},true);
new MutationObserver(__prototypeNormalizeLinks).observe(document.documentElement,{childList:true,subtree:true});
document.addEventListener('DOMContentLoaded',__prototypeNormalizeLinks);
`;
  }

  function renderDocument(route) {
    const bundle = data.bundles[route.family];
    const code = childBridge(route) + '\n' + bundle.script;
    return '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>' + route.title + ' · 竹简应用中台</title><style>' + data.common + bundle.css + '</style></head><body' + bundle.attrs + (route.family === 'forms' ? ' data-page="' + route.page + '"' : '') + '>' + bundle.body + '<script>' + code.replace(/<\/script/gi, '<\\/script') + '<' + '/script></body></html>';
  }

  function render(force = false) {
    if (rendering || (!force && renderedHash === location.hash)) return;
    rendering = true;
    try {
      snapshot();
      current = resolve(location.hash || '#/portal');
      renderChrome(current);
      renderedHash = current.hash;
      document.title = current.title + ' · 竹简应用中台';
      frame.title = current.title + ' · 在线表单独立原型';
      error.hidden = true;
      frame.hidden = false;
      frame.srcdoc = renderDocument(current);
    } catch (failure) {
      frame.hidden = true;
      error.hidden = false;
      error.textContent = failure.message;
      const home = document.createElement('a');
      home.href = '#/home'; home.textContent = '返回工作台';
      error.append(document.createElement('br'), home);
    } finally { rendering = false; }
  }

  function navigate(target, replace = false) {
    const next = resolve(target);
    if (next.hash === location.hash) { render(true); return; }
    if (replace) location.replace(next.hash);
    else location.hash = next.hash;
    render();
  }

  function assignedTasks(kind){const s=linked.read();return (s.tasks||[]).filter(t=>{const f=s.forms?.[t.fid];if(!f||f.deleted)return false;return kind==='audit'?f.type==='流程表单'&&(t.reviewAssignee||'高源')==='高源'&&t.audit!=='—':t.person==='高源'&&f.identity!=='完全匿名'})}
function updateBadge(){const s=linked.read();const tasks=[...assignedTasks('fill').filter(t=>s.forms?.[t.fid]?.published&&s.forms[t.fid].status==='收集中'&&['未填报','填报中','已逾期','已驳回'].includes(t.fill)),...assignedTasks('audit').filter(t=>t.audit==='待审核')];const n=new Set(tasks.filter(t=>!(s.hub?.readMessages||[]).includes(t.id)).map(t=>t.id)).size;const badge=document.querySelector('.message-count');badge.textContent=String(n);badge.hidden=!n}
function renderChrome(route){
 const detail=route.family!=='hub';document.body.classList.toggle('detail-page',detail);document.body.classList.remove('sidebar-open');
 const origin=new URLSearchParams(route.search).get('origin');
 const top=['portal','portal-settings'].includes(route.route)?'portal':route.route==='templates'?'templates':route.route==='messages'?'messages':route.route==='reporting'||route.route==='participate'||origin==='reporting'?'reporting':'center';
 document.body.classList.toggle('wide-page',['portal','portal-settings','templates','messages'].includes(route.route));
 const reporting=route.route==='reporting';document.body.classList.toggle('reporting-page',reporting);
 const nav=document.querySelector('.side-nav'),createButton=document.querySelector('.new-form');
 createButton.hidden=reporting;
 const view=new URLSearchParams(route.search).get('view')||'fill';
 const entries=reporting?[['fill','我的填报','clipboard-list'],['audit','我的审核','rubber-stamp'],['progress','填报进度','chart-bar']]:[['home','首页','home'],['mine','我的表单','forms'],['team','团队表单','folders'],['wiki','知识库','book'],['trash','回收站','trash']];
 nav.setAttribute('aria-label',reporting?'填报导航':'表单导航');
 nav.innerHTML=entries.map(([id,n,ic])=>'<a data-app-nav data-side="'+id+'" href="'+(reporting?'#/reporting?view='+id:'#/'+id)+'" class="'+((reporting?view:(route.route==='center'?'home':route.route))===id?'active':'')+'"><i class="ti ti-'+ic+'" aria-hidden="true"></i>'+n+'</a>').join('');
 for(const a of document.querySelectorAll('[data-side]')){if(a.classList.contains('active'))a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')}
 for(const a of document.querySelectorAll('[data-top]'))a.classList.toggle('active',a.dataset.top===top);
 for(const a of document.querySelectorAll('[data-top]')){if(a.dataset.top===top)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')}
 document.getElementById('accountMenu').hidden=true;
 document.getElementById('roleButton').setAttribute('aria-expanded','false');
 updateBadge();
}
const accountButton=document.getElementById('roleButton'),accountMenu=document.getElementById('accountMenu'),userCenter=document.getElementById('userCenter');
document.addEventListener('click',event=>{
 const anchor=event.target.closest('a[data-app-nav]');if(anchor&&!event.ctrlKey&&!event.metaKey&&!event.shiftKey&&!event.altKey){event.preventDefault();navigate(anchor.getAttribute('href'));return}
 const b=event.target.closest('[data-chrome-action]');
 if(!b){if(!event.target.closest('#accountMenu')){accountMenu.hidden=true;accountButton.setAttribute('aria-expanded','false')}return}
 const action=b.dataset.chromeAction;
 if(action==='role'){accountMenu.hidden=!accountMenu.hidden;accountButton.setAttribute('aria-expanded',String(!accountMenu.hidden))}
 if(action==='user-center'){accountMenu.hidden=true;const p=linked.read().hub?.profile||{name:'高源',account:'admin',role:'系统管理员',department:'信息工程学院'};document.getElementById('profileInfo').innerHTML=[['姓名',p.name],['账号',p.account],['系统角色',p.role],['所属部门',p.department]].map(([a,v])=>'<dt>'+a+'</dt><dd>'+v+'</dd>').join('');userCenter.hidden=false;document.getElementById('closeUserCenter').focus()}
 if(action==='close-profile'){userCenter.hidden=true;accountButton.focus()}
 if(action==='settings'){accountMenu.hidden=true;navigate('#/portal-settings?section=home')}
 if(action==='new'){if(current?.family==='hub'&&frame.contentWindow?.HubOpenCreate)frame.contentWindow.HubOpenCreate();else navigate('#/mine?create=1')}
 if(action==='toggle-side')document.body.classList.toggle('sidebar-open');
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){accountMenu.hidden=true;userCenter.hidden=true;document.body.classList.remove('sidebar-open');accountButton.setAttribute('aria-expanded','false')}if(e.key==='Tab'&&!userCenter.hidden){const buttons=[...userCenter.querySelectorAll('button')];if(e.shiftKey&&document.activeElement===buttons[0]){e.preventDefault();buttons.at(-1).focus()}else if(!e.shiftKey&&document.activeElement===buttons.at(-1)){e.preventDefault();buttons[0].focus()}}});
userCenter.addEventListener('click',e=>{if(e.target===userCenter){userCenter.hidden=true;accountButton.focus()}});
const helpDock=document.getElementById('helpDock'),helpButton=document.getElementById('helpButton'),helpMenu=document.getElementById('helpMenu'),helpDialog=document.getElementById('helpDialog');
function setHelpMenu(open){helpMenu.hidden=!open;helpButton.setAttribute('aria-expanded',String(open))}
helpDock.addEventListener('mouseenter',()=>setHelpMenu(true));
helpDock.addEventListener('mouseleave',()=>setHelpMenu(false));
helpDock.addEventListener('focusout',e=>{if(!helpDock.contains(e.relatedTarget))setHelpMenu(false)});
helpButton.addEventListener('click',()=>setHelpMenu(true));
helpMenu.addEventListener('click',e=>{
 const item=e.target.closest('[data-help-content]');if(!item)return;
 for(const image of helpDialog.querySelectorAll('[data-help-image]'))image.hidden=image.dataset.helpImage!==item.dataset.helpContent;
 document.getElementById('helpDialogTitle').textContent=item.textContent.trim();
 setHelpMenu(false);helpDialog.showModal();document.getElementById('closeHelpDialog').focus();
});
helpDock.addEventListener('keydown',e=>{
 if(e.key==='Escape'){setHelpMenu(false);helpButton.focus();return}
 if(e.target===helpButton&&e.key==='ArrowDown'){e.preventDefault();setHelpMenu(true);helpMenu.querySelector('button').focus();return}
 if(!e.target.closest('#helpMenu')||!['ArrowDown','ArrowUp','Home','End'].includes(e.key))return;
 e.preventDefault();const items=[...helpMenu.querySelectorAll('button')],index=items.indexOf(e.target),next=e.key==='Home'?0:e.key==='End'?items.length-1:(index+(e.key==='ArrowDown'?1:-1)+items.length)%items.length;items[next].focus();
});
document.getElementById('closeHelpDialog').addEventListener('click',()=>helpDialog.close());
helpDialog.addEventListener('click',e=>{if(e.target===helpDialog)helpDialog.close()});
helpDialog.addEventListener('close',()=>helpButton.focus());


  window.Prototype = {
    linked, tasks:assignedTasks, session: {}, get current() { return current; },
    navigate, resolve, url, renderDocument,
    reload: () => render(true),
    sync(route, search) {
      const next = resolve('#/' + route + search);
      location.replace(next.hash);
      current = next; renderedHash = next.hash;
    }
  };
  window.addEventListener('hashchange', () => render());
  window.addEventListener('popstate', () => render());
  window.addEventListener('pagehide', snapshot);
  if (!location.hash) location.replace('#/portal');
  render();
})();

</script></body></html>
