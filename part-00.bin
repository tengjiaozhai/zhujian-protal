<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="竹简应用中台在线表单独立原型，包含首页、表单中心、模板中心、消息、表单设计与发布。"><title>应用门户 · 竹简应用中台</title><style>:root{--primary:#07599f;--primary-hover:#03477f;--ink:#172f4c;--muted:#526980;--border:#dce5ed;--soft:#f4f8fc;--masthead:#194972;--topbar:72px}
*{box-sizing:border-box}html,body{margin:0;height:100%;width:100%;overflow:hidden;font-family:"Microsoft YaHei","PingFang SC",sans-serif;color:var(--ink);background:#fff;font-size:14px}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:default;opacity:.45}a{text-decoration:none;color:inherit}button:focus-visible,a:focus-visible{outline:2px solid #81c6f1;outline-offset:4px}::selection{background:#d5eafb;color:#102e4c}.ti{font-size:20px;vertical-align:middle;line-height:1}
.topbar{height:var(--topbar);display:flex;align-items:center;padding:0 48px;gap:32px;background:var(--masthead);color:#fff;position:relative;z-index:2}.product-brand{display:flex;align-items:center;gap:16px;flex-shrink:0}.product-brand strong{font-size:20px;font-weight:600;letter-spacing:1px;white-space:nowrap;color:#fff}.product-brand .brand-symbol{display:grid;place-items:center;background:#f6fbff;color:#07599f;width:40px;height:44px;font-size:28px;border-radius:4px}.product-tagline{display:none}
.topnav{height:100%;display:flex;align-items:stretch;gap:40px;margin-left:32px}.topnav a{position:relative;display:flex;align-items:center;font-size:16px;white-space:nowrap;padding:0 2px;color:#e1edf7;transition:color .3s cubic-bezier(.22,1,.36,1)}.topnav a:hover,.topnav a.active{color:#fff}.topnav a.active{font-weight:600}.topnav a.active:after{content:"";height:4px;background:#83c8ec;position:absolute;bottom:0;left:0;right:0}.message-count{font-size:12px;min-width:20px;height:20px;padding:0 4px;line-height:20px;text-align:center;border-radius:12px;background:#b84c32;color:#fff;position:absolute;top:12px;right:-20px}.message-count[hidden]{display:none}
.role-wrap{display:flex;align-items:center;border-left:1px solid #65839e;padding-left:32px;margin-left:auto}.role-button{display:flex;align-items:center;gap:8px;border:0;background:none;color:#fff;white-space:nowrap;padding:8px 0;font-size:14px}.role-button .ti{font-size:16px;color:#e1edf7}.role-caption{font-size:12px;color:#d4e5f3}.role-name{font-weight:500}
.account-avatar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#f4f8fc;color:var(--primary)}.role-button .account-avatar .ti{font-size:20px;color:var(--primary)}
.main-shell{display:flex;height:calc(100% - var(--topbar))}.global-sidebar{width:216px;flex:0 0 216px;background:#f5f8fc;border-right:1px solid var(--border);display:flex;flex-direction:column;padding:24px 16px 16px}.new-form{min-height:40px;display:flex;justify-content:center;align-items:center;gap:8px;border:1px solid var(--primary);border-radius:4px;background:var(--primary);color:#fff;font-size:14px;width:100%;margin-bottom:24px}.new-form[hidden]{display:none}.new-form:hover{background:var(--primary-hover)}.new-form .ti{font-size:20px}
.side-nav{display:flex;flex-direction:column;gap:8px}.side-nav a{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 16px;color:var(--muted);border-radius:4px;font-size:14px}.side-nav a .ti{font-size:20px;color:#6685a5}.side-nav a.active{color:var(--primary);background:#e5eff9;font-weight:600}.side-nav a.active .ti{color:var(--primary)}.side-nav a:hover{background:#eaf2fa}.side-nav a[data-side=trash]{margin-top:16px}.sidebar-bottom{margin-top:auto;border-top:1px solid var(--border);padding:16px 8px 0;color:var(--muted);font-size:12px;line-height:1.8}.sidebar-bottom strong{display:block;font-size:12px;font-weight:500}
.prototype-stage{flex:1;min-width:0;position:relative}#prototypeView{display:block;border:0;width:100%;height:100%;background:#fff}body.detail-page .global-sidebar,body.wide-page .global-sidebar{display:none}#routeError{padding:48px;font-size:14px;line-height:1.8}#routeError[hidden],#prototypeView[hidden]{display:none}
#accountMenu{position:fixed;top:64px;right:32px;width:240px;background:white;box-shadow:0 8px 24px #1636521a;border:1px solid var(--border);border-radius:4px;padding:8px;z-index:10}#accountMenu[hidden]{display:none}.account-summary{padding:16px 12px;border-bottom:1px solid var(--border);margin-bottom:4px}.account-summary strong{font-size:16px;display:block}.account-summary small{font-size:12px;color:var(--muted);display:block;margin-top:4px}.account-menu-item{width:100%;display:flex;align-items:center;gap:12px;text-align:left;border:0;border-radius:4px;padding:12px;background:none;font-size:14px;color:var(--ink)}.account-menu-item:hover{background:var(--soft);color:var(--primary)}
#userCenter{position:fixed;inset:0;z-index:20;background:#142e4866;display:flex;align-items:center;justify-content:center;padding:24px}#userCenter[hidden]{display:none}.profile-dialog{width:480px;max-width:100%;border-radius:8px;background:#fff;box-shadow:0 16px 48px #16365226}.profile-dialog>header{padding:24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}.profile-dialog h2{font-size:24px;font-weight:600;margin:0;color:var(--ink)}.close-profile{border:0;background:none;color:var(--muted);padding:4px}.profile-body{padding:32px}.profile-avatar{background:#e8f2fb;color:var(--primary);width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px}.profile-avatar .ti{font-size:32px}.profile-body dl{display:grid;grid-template-columns:104px 1fr;font-size:14px;row-gap:24px}.profile-body dt{color:var(--muted)}.profile-body dd{margin:0;color:var(--ink)}.profile-dialog footer{padding:16px 24px;border-top:1px solid var(--border);text-align:right}.profile-done{background:var(--primary);color:#fff;border:0;min-height:40px;padding:8px 24px;border-radius:4px}.mobile-side-toggle{display:none;background:none;border:0;color:#e1edf7}
@media(max-width:1200px){.topbar{gap:24px;padding:0 24px}.topnav{gap:24px;margin-left:8px}.role-caption{display:none}.role-wrap{padding-left:24px}.product-brand strong{font-size:18px}}
@media(max-width:900px){.topnav{gap:16px;margin-left:0}.topnav a{font-size:14px}.role-wrap{border:0;padding:0 0 0 12px}.product-brand strong{font-size:16px}.product-brand .brand-symbol{width:32px;height:36px;font-size:24px}.product-brand{gap:8px}.global-sidebar{width:192px;flex-basis:192px}}
@media(max-width:780px){:root{--topbar:112px}.topbar{padding:0 16px;align-items:flex-start;gap:8px;flex-wrap:wrap}.product-brand{height:64px}.topnav{position:absolute;bottom:0;left:16px;right:16px;height:48px;gap:0;justify-content:space-between;margin:0}.topnav a{font-size:14px;padding:0 4px}.role-wrap{height:64px}.role-button{font-size:12px;gap:4px}.role-button .role-name{max-width:80px;overflow:hidden;text-overflow:ellipsis}.mobile-side-toggle{display:block;height:64px;padding:0}.global-sidebar{position:fixed;left:0;top:var(--topbar);bottom:0;z-index:5;width:216px;transform:translateX(-100%);transition:transform .3s cubic-bezier(.22,1,.36,1);box-shadow:8px 0 24px #1636521a}.sidebar-open .global-sidebar{transform:translateX(0)}.message-count{top:0;right:-4px;font-size:10px;min-width:16px;height:16px;line-height:16px}#accountMenu{top:56px;right:16px}body.detail-page .mobile-side-toggle,body.wide-page .mobile-side-toggle{display:none}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
.help-dock{position:fixed;right:16px;top:50%;transform:translateY(-50%);z-index:12}
.help-button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;width:56px;min-height:76px;padding:10px 6px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--primary);box-shadow:0 4px 16px #1636521a;font-size:12px}
.help-button .ti{font-size:28px}.help-button:hover{background:var(--soft);border-color:#93b9d7}
.help-menu{position:absolute;right:calc(100% + 12px);top:50%;transform:translateY(-50%);width:164px;padding:6px;border:1px solid var(--border);border-radius:8px;background:#fff;box-shadow:0 8px 24px #1636521a}
.help-menu:after{content:"";position:absolute;top:0;bottom:0;right:-13px;width:13px}
.help-menu[hidden],.help-image img[hidden]{display:none}
.help-menu button{display:flex;align-items:center;gap:12px;width:100%;min-height:44px;padding:10px 14px;background:#fff;border:0;border-radius:4px;color:var(--ink);text-align:left;font-size:14px}
.help-menu button:hover,.help-menu button:focus-visible{background:var(--soft);color:var(--primary)}
.help-dialog{width:max-content;max-width:calc(100vw - 48px);max-height:calc(100dvh - 48px);margin:auto;padding:0;overflow:hidden;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--ink);box-shadow:0 16px 48px #16365226}
.help-dialog::backdrop{background:#142e4866}
.help-dialog>header{display:flex;align-items:center;justify-content:space-between;gap:24px;height:48px;padding:0 16px;border-bottom:1px solid var(--border)}
.help-dialog h2{font-size:16px;font-weight:600;margin:0}
.help-dialog>header button{display:grid;place-items:center;width:32px;height:32px;padding:0;border:0;border-radius:4px;background:#fff;color:var(--muted)}
.help-dialog>header button:hover{background:var(--soft)}
.help-image img{display:block;width:auto;height:auto;max-width:calc(100vw - 50px);max-height:calc(100dvh - 98px)}
@media(max-width:780px){.help-dock{right:12px}.help-button{width:48px;min-height:64px;gap:4px;padding:8px 4px}.help-button .ti{font-size:24px}}
</style></head><body>
<header class="topbar"><button class="mobile-side-toggle" data-chrome-action="toggle-side" aria-label="展开左侧菜单"><i class="ti ti-menu-2" aria-hidden="true"></i></button><a class="product-brand" data-app-nav href="#/portal"><i class="ti ti-books brand-symbol" aria-hidden="true"></i><strong>竹简应用中台</strong></a><span class="product-tagline">通过建设数据中心生态圈，为在校师生提供舒适便利的数据服务。</span><nav class="topnav" aria-label="系统导航"><a href="#/portal" data-top="portal" data-app-nav>应用门户</a><a href="#/home" data-top="center" data-app-nav>表单中心</a><a href="#/reporting" data-top="reporting" data-app-nav>填报中心</a><a href="#/templates" data-top="templates" data-app-nav>模板中心</a><a href="#/messages" data-top="messages" data-app-nav>消息<span class="message-count">8</span></a></nav><div class="role-wrap"><button id="roleButton" class="role-button" data-chrome-action="role" aria-expanded="false" aria-haspopup="menu"><span class="account-avatar" aria-hidden="true"><i class="ti ti-user"></i></span><span class="role-caption">系统角色</span><span class="role-name">系统管理员</span><i class="ti ti-chevron-down" aria-hidden="true"></i></button></div></header>
<div class="main-shell"><aside class="global-sidebar"><button class="new-form" data-chrome-action="new"><i class="ti ti-plus" aria-hidden="true"></i>新建表单</button><nav class="side-nav" aria-label="表单导航"><a data-app-nav data-side="home" href="#/home"><i class="ti ti-home" aria-hidden="true"></i>首页</a><a data-app-nav data-side="mine" href="#/mine"><i class="ti ti-forms" aria-hidden="true"></i>我的表单</a><a data-app-nav data-side="team" href="#/team"><i class="ti ti-folders" aria-hidden="true"></i>团队表单</a><a data-app-nav data-side="wiki" href="#/wiki"><i class="ti ti-book" aria-hidden="true"></i>知识库</a><a data-app-nav data-side="trash" href="#/trash"><i class="ti ti-trash" aria-hidden="true"></i>回收站</a></nav><div class="sidebar-bottom"><strong>竹简应用中台</strong>独立交互原型</div></aside><div class="prototype-stage"><iframe id="prototypeView" title="在线表单独立原型"></iframe><div id="routeError" role="alert" hidden></div></div></div>
<div id="accountMenu" role="menu" hidden><div class="account-summary"><strong>高源</strong><small>admin · 系统管理员</small></div><button class="account-menu-item" role="menuitem" data-chrome-action="user-center"><i class="ti ti-user-circle" aria-hidden="true"></i>用户中心</button><button class="account-menu-item" role="menuitem" data-chrome-action="settings"><i class="ti ti-settings" aria-hidden="true"></i>设置</button></div><div id="userCenter" hidden><section class="profile-dialog" role="dialog" aria-modal="true" aria-labelledby="profileTitle"><header><h2 id="profileTitle">用户中心</h2><button class="close-profile" id="closeUserCenter" data-chrome-action="close-profile" aria-label="关闭用户中心"><i class="ti ti-x" aria-hidden="true"></i></button></header><div class="profile-body"><div class="profile-avatar"><i class="ti ti-user" aria-hidden="true"></i></div><dl id="profileInfo"></dl></div><footer><button class="profile-done" data-chrome-action="close-profile">完成</button></footer></section></div>
<aside id="helpDock" class="help-dock" aria-label="帮助"><button id="helpButton" class="help-button" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="helpMenu"><i class="ti ti-help-circle" aria-hidden="true"></i><span>帮助</span></button><div id="helpMenu" class="help-menu" role="menu" aria-label="帮助选项" hidden><button type="button" role="menuitem" data-help-content="guide"><i class="ti ti-book" aria-hidden="true"></i>使用指南</button><button type="button" role="menuitem" data-help-content="service"><i class="ti ti-headset" aria-hidden="true"></i>人工服务</button></div></aside>
<dialog id="helpDialog" class="help-dialog" aria-labelledby="helpDialogTitle"><header><h2 id="helpDialogTitle">使用指南</h2><button id="closeHelpDialog" type="button" aria-label="关闭帮助"><i class="ti ti-x" aria-hidden="true"></i></button></header><div class="help-image"><img data-help-image="guide" src="data:image/png;base64," width="946" height="791" alt="使用指南：快速上手说明截图"><img data-help-image="service" src="data:image/png;base64," width="500" height="699" alt="人工服务：ZJU填表助手运维群二维码截图" hidden></div></dialog>
<noscript>请启用 JavaScript 查看交互原型。</noscript><script id="prototypeData" type="application/json">{"common":"/*!\n * Tabler Icons 3.31.0 by tabler - https://tabler.io\n * License - https://github.com/tabler/tabler-icons/blob/master/LICENSE\n */\n@font-face {\n  font-family: \"tabler-icons\";\n  font-style: normal;\n  font-weight: 400;\n  src:url(\"data:font/woff2;base64,