&&t.person==='高源'),{fill:'填报中',equipment:'电子显微镜',value:6,remark:'本期维护记录待补充。'});\nObject.assign(TASKS.find(t=>t.fid==='f11'&&t.person==='高源'),{fill:'已逾期',due:'2026-10-20 18:00'});\nfor(let i=TASKS.length-1;i>=0;i--){if(!FORMS.find(f=>f.id===TASKS[i].fid).published||FORMS.find(f=>f.id===TASKS[i].fid).identity==='完全匿名')TASKS.splice(i,1);}\nTASKS.push({id:'f1-202609-gaoyuan',fid:'f1',person:'高源',dept:'信息工程学院',fill:'已完成',audit:'—',cycle:'2026年9月',start:'2026-09-01 08:00',due:'2026-09-30 18:00',submitted:'2026-09-28 10:00',version:2,node:'—',following:false,value:12,equipment:'教学设备',remark:'9月运行记录已核对。'});\nconst RECORDS = TASKS.filter(t=>['已提交','已完成'].includes(t.fill)).map((t,i)=>({id:'R'+String(i+1).padStart(4,'0'),tid:t.id,fid:t.fid,person:t.person,dept:t.dept,submitted:t.submitted,cycle:t.cycle,audit:t.audit,version:t.version,node:t.node,value:t.value,remark:'设备运行正常，已完成本期信息核对。'}));\nconst LOGS = [\n ['2026-10-23 09:30','高源','修改配置','调整本月填报截止时间','成功','v3'],\n ['2026-10-22 16:40','李静','授权变更','新增理学院统计查看范围','成功','v3'],\n ['2026-10-21 10:15','高源','发布','发布第 3 版，保留历史响应版本','成功','v3'],\n ['2026-10-20 15:20','高源','数据导出','导出授权范围内的填报数据','成功','v2'],\n ['2026-10-19 11:30','高源','发布校验','截止时间早于开始时间，已阻止发布','失败','v2'],\n ['2026-10-18 09:00','系统任务','生成任务','按当前范围生成本周期填报任务','成功','v2'],\n ['2026-10-17 14:20','高源','修改设计','新增设备数量字段，保存为设计草稿','成功','v2']\n].map((x,i)=>({id:i,time:x[0],actor:x[1],action:x[2],detail:x[3],result:x[4],version:x[5]}));\nconst COMPONENTS = window.FormDesigner.catalog;\nconst qp = new URLSearchParams(__prototypeLocation.search);\nlet selected = FORMS.find(f=>f.id===qp.get('form')) || FORMS.find(f=>f.id===(document.body.dataset.page==='workflow'?'f2':'f1'));\nif(qp.has('ctx')){try{const c=JSON.parse(qp.get('ctx'));if(c.id===selected.id||c.id.startsWith('new-'))selected={...selected,...c};}catch{}}\nconst linkedState=FormLinkState.read();\nfor(const saved of Object.values(linkedState.forms||{})){\n const index=FORMS.findIndex(f=>f.id===saved.id);\n if(index>=0)Object.assign(FORMS[index],saved);else FORMS.push(saved);\n}\nif(linkedState.forms?.[selected.id])selected={...selected,...linkedState.forms[selected.id]};\nconst FORM = selected;\nif(Array.isArray(linkedState.tasks))TASKS.splice(0,TASKS.length,...linkedState.tasks);\nif(Array.isArray(linkedState.records))RECORDS.splice(0,RECORDS.length,...linkedState.records);\nif(Array.isArray(linkedState.logs?.[FORM.id]))LOGS.splice(0,LOGS.length,...linkedState.logs[FORM.id]);\nelse if(FORM.id.startsWith('new-'))LOGS.length=0;\nconst store = {active:document.body.dataset.page,tab:'全部',filter:'',category:'全部',categorySearch:'',categoryOpen:true,page:1,pageSize:8,view:'list',status:'全部',selected:new Set(),role:'manager',stat:'收集汇总',statDept:'全部',logAction:'全部',logResult:'全部',logKeyword:'',taskStatus:'全部',auditStatus:'待审核',saved:false,form:FORM,fields:[{id:'c1',type:'department',label:'所属单位',required:true,half:true,hidden:false},{id:'c2',type:'text',label:'设备名称',required:true,half:true,hidden:false},{id:'c3',type:'number',label:'设备数量',required:true,half:true,hidden:false},{id:'c4',type:'select',label:'运行状态',required:true,half:true,hidden:false,options:'正常运行,待维修,已停用'},{id:'c5',type:'textarea',label:'情况说明',required:false,half:false,hidden:false},{id:'c6',type:'attachment',label:'相关附件',required:false,half:false,hidden:false}],fieldId:'c2',componentSearch:'',nodes:[{id:'n1',title:'部门审核',kind:'审批',assigneeType:'指定成员',assignee:'李静',required:true},{id:'n2',title:'资产管理复核',kind:'审批',assigneeType:'指定成员',assignee:'王强',required:true}],nodeId:'n1',permissionRows:[{id:'p1',name:'高源',dept:'表单创建者',design:true,publish:true,fill:true,audit:false,data:true,stats:true,export:true,scope:'全部授权范围',locked:true},{id:'p2',name:'李静',dept:'信息工程学院',design:false,publish:false,fill:true,audit:true,data:false,stats:true,export:false,scope:'信息工程学院'},{id:'p3',name:'王强',dept:'资产管理处',design:false,publish:false,fill:false,audit:true,data:true,stats:false,export:true,scope:'全部授权范围'},{id:'p4',name:'陈晨',dept:'理学院',design:false,publish:false,fill:true,audit:false,data:false,stats:true,export:false,scope:'理学院'}]};\nconst editHistory = {stack:[JSON.stringify(store.fields)],index:0};\nif(Array.isArray(FORM.fields)){store.fields=structuredClone(FORM.fields);store.fieldId=store.fields[0]?.id;editHistory.stack=[JSON.stringify(store.fields)];}\nif(Array.isArray(FORM.permissionRows))store.permissionRows=structuredClone(FORM.permissionRows);\nif(Array.isArray(FORM.nodes)){store.nodes=structuredClone(FORM.nodes);store.nodeId=store.nodes[0]?.id;}\nconst contextualIndex=FORMS.findIndex(f=>f.id===FORM.id);\nif(contextualIndex>=0)FORMS[contextualIndex]=FORM;\nelse FORMS.unshift(FORM);\nlet modalReturnFocus=null,toastTimer=null,modalSubmit=null,modalCleanup=null;\nconst $=id=>document.getElementById(id);\nconst esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst icon=n=>'<i class=\"ti ti-'+n+'\" aria-hidden=\"true\"><\/i>';\nconst tag=(s,c='')=>'<span class=\"tag '+c+'\">'+esc(s)+'<\/span>';\nconst stateTag=s=>tag(s,['已完成','已通过','收集中'].includes(s)?'green':['已逾期','已驳回','失败'].includes(s)?'red':['待审核','未填报','草稿','填报中'].includes(s)?'orange':s==='审核中'?'purple':'gray');\nconst identityTag=()=>tag(FORM.identity,FORM.identity==='实名填报'?'gray':'purple');\nfunction formById(id){return id===FORM.id?FORM:FORMS.find(f=>f.id===id);}\nfunction href(key,f=FORM,extra={}){if(['fill','follow','audit','view'].includes(key)){const q=new URLSearchParams({type:'form',formView:key==='audit'?'audit':key==='view'?'manage':'fill'});if(extra.task||extra.preview||extra.review){q.set('form',f.id);q.set('ctx',JSON.stringify(f));}if(['fill','follow'].includes(key))q.set('fillStatus','pending');if(key==='view')q.set('permission','dataAccess');if(key==='follow')q.set('followed','1');Object.entries(extra).forEach(([k,v])=>q.set(k,v));return '文档中心-我的文档.html?'+q.toString()}if(key==='forms'){const q=new URLSearchParams({type:'form',formView:'manage',ctx:JSON.stringify(f)});return '文档中心-我的文档.html?'+q.toString()}const q=new URLSearchParams();q.set('form',f.id);q.set('ctx',JSON.stringify(f));Object.entries(extra).forEach(([k,v])=>q.set(k,v));return PAGE_META.find(x=>x[0]===key)[2]+'?'+q.toString();}\nfunction link(key,label,f=FORM,cls='',extra={}){return '<a data-route=\"'+key+'\" data-form-ref=\"'+esc(f.id)+'\" data-route-extra=\"'+esc(JSON.stringify(extra))+'\" class=\"'+cls+'\" href=\"'+esc(href(key,f,extra))+'\">'+label+'<\/a>';}\nfunction btn(label,action,cls='',attrs=''){return '<button type=\"button\" class=\"btn '+cls+'\" data-action=\"'+action+'\" '+attrs+'>'+label+'<\/button>';}\nfunction inputSearch(id,placeholder,value=''){return '<label class=\"search\">'+icon('search')+'<input id=\"'+id+'\" aria-label=\"'+placeholder+'\" placeholder=\"'+placeholder+'\" value=\"'+esc(value)+'\"><\/label>';}\nfunction options(values,selected){return values.map(v=>'<option'+(v===selected?' selected':'')+'>'+esc(v)+'<\/option>').join('');}\nfunction select(id,values,value,attrs=''){return '<select id=\"'+id+'\" '+attrs+'>'+options(values,value)+'<\/select>';}\nfunction typeIcon(f){return '<span class=\"type-icon '+(f.type==='流程表单'?'flow':f.type==='业务报表'?'report':'')+'\">'+icon(f.type==='流程表单'?'git-branch':f.type==='业务报表'?'report-analytics':'forms')+'<\/span>';}\nfunction empty(title='暂无符合条件的数据',text='请调整搜索条件或筛选范围。',action=''){return '<div class=\"empty\">'+icon('inbox')+'<h3>'+title+'<\/h3><p>'+text+'<\/p>'+action+'<\/div>';}\nfunction notice(text,kind='',title=''){return '<div class=\"notice '+kind+'\">'+icon(kind==='danger'?'alert-circle':kind==='warning'?'alert-triangle':'info-circle')+'<div>'+(title?'<strong>'+title+'<\/strong>':'')+text+'<\/div><\/div>';}\nfunction metric(label,value,meta=''){return '<div class=\"metric\"><div class=\"label\">'+label+'<\/div><div class=\"value\">'+value+'<\/div><div class=\"meta\">'+meta+'<\/div><\/div>';}\nfunction panel(title,body,action=''){return '<section class=\"panel\"><div class=\"panel-head\"><h2>'+title+'<\/h2>'+action+'<\/div><div class=\"panel-body\">'+body+'<\/div><\/section>';}\nfunction field(label,body,hint='',full=false){return '<div class=\"field'+(full?' full':'')+'\"><div class=\"field-label\">'+label+'<\/div>'+body+(hint?'<span class=\"hint\">'+hint+'<\/span>':'')+'<\/div>';}\nfunction head(title,desc='',actions=''){if(['填报数据','操作日志','发布管理','统计分析'].includes(title))return actions?'<div class=\"page-head compact-page-actions\"><div class=\"actions\">'+actions+'<\/div><\/div>':'';return '<div class=\"page-head\"><div><h1>'+title+'<\/h1>'+(desc?'<p>'+desc+'<\/p>':'')+'<\/div><div class=\"actions\">'+actions+'<\/div><\/div>';}\nfunction table(headers,rows,cls=''){return '<div class=\"table-card\"><div class=\"table-wrap\"><table class=\"'+cls+'\"><thead><tr>'+headers.map(x=>'<th>'+x+'<\/th>').join('')+'<\/tr><\/thead><tbody>'+rows.join('')+'<\/tbody><\/table><\/div>'+(rows.length?'':empty())+'<\/div>';}\nfunction row(cells){return '<tr>'+cells.map(c=>'<td>'+c+'<\/td>').join('')+'<\/tr>';}\nfunction pageItems(items){const max=Math.max(1,Math.ceil(items.length/store.pageSize));store.page=Math.min(max,Math.max(1,store.page));return items.slice((store.page-1)*store.pageSize,store.page*store.pageSize);}\nfunction pagination(total){const max=Math.max(1,Math.ceil(total/store.pageSize));return '<div class=\"pagination\"><span>共 '+total+' 条<\/span>'+btn(icon('chevron-left'),'prev','small icon-btn','aria-label=\"上一页\" '+(store.page<=1?'disabled':''))+'<span class=\"page-number\">'+store.page+'<\/span><span>/ '+max+'<\/span>'+btn(icon('chevron-right'),'next','small icon-btn','aria-label=\"下一页\" '+(store.page>=max?'disabled':''))+select('pageSize',['8','16','24'],String(store.pageSize),'aria-label=\"每页条数\"')+'<span>条 / 页<\/span><\/div>';}\nfunction toast(message){clearTimeout(toastTimer);$('toast').textContent=message;$('toast').classList.add('show');toastTimer=setTimeout(()=>$('toast').classList.remove('show'),3200);}\nfunction openModal(title,body,submitLabel='',submit=null,width=680){modalReturnFocus=document.activeElement;modalSubmit=submit;$('modalMask').innerHTML='<section class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modalTitle\" style=\"width:'+width+'px\"><div class=\"modal-head\"><h2 class=\"modal-title\" id=\"modalTitle\">'+title+'<\/h2>'+btn(icon('x'),'close-modal','icon-btn','aria-label=\"关闭弹框\"')+'<\/div><div class=\"modal-body\">'+body+'<div class=\"error\" id=\"modalError\" role=\"alert\"><\/div><\/div><div class=\"modal-foot\">'+btn(submitLabel?'取消':'关闭','close-modal')+(submitLabel?btn(submitLabel,'modal-submit','primary'):'')+'<\/div><\/section>';$('modalMask').classList.add('open');const focus=$('modalMask').querySelector('input:not([type=hidden]),select,textarea,button');focus?.focus();}\nfunction closeModal(){if(modalCleanup){modalCleanup();modalCleanup=null;}$('modalMask').classList.remove('open');$('modalMask').innerHTML='';modalSubmit=null;modalReturnFocus?.focus();}\nfunction modalError(message){$('modalError').textContent=message;}\nfunction resetList(){store.page=1;store.selected.clear();renderPage(store.active);}\nfunction persistForm(){if(!['overview','design','settings','permissions','workflow','records','statistics','publish','logs'].includes(store.active))return;FormLinkState.update(state=>{state.forms=state.forms||{};state.forms[FORM.id]=FORM;state.logs=state.logs||{};state.logs[FORM.id]=LOGS;state.tasks=TASKS;state.records=RECORDS;});}\nwindow.addEventListener('pagehide',persistForm);\nfunction addLog(action,detail,result='成功'){LOGS.unshift({id:Date.now(),time:'2026-10-23 10:30',actor:'高源',action,detail,result,version:'v'+FORM.version});persistForm();}\nfunction csvDownload(name,headers,rows){const text='\\ufeff'+[headers,...rows].map(r=>r.map(v=>'\"'+String(v??'').replace(/\"/g,'\"\"')+'\"').join(',')).join('\\r\\n');const url=URL.createObjectURL(new Blob([text],{type:'text/csv;charset=utf-8;'}));const a=document.createElement('a');a.href=url;a.download=name+'.csv';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);addLog('数据导出','导出当前授权范围内的数据');toast('已生成 CSV 文件');}\nfunction currentTasks(){return TASKS.filter(t=>t.fid===FORM.id);}\nfunction currentRecords(){return RECORDS.filter(r=>r.fid===FORM.id);}\nfunction mineTasks(){return TASKS.filter(t=>t.person==='高源'&&!formById(t.fid).deleted&&['收集中','已暂停','已结束'].includes(formById(t.fid).status));}\nfunction canFill(t){return !formById(t.fid).deleted&&formById(t.fid).status==='收集中'&&['未填报','填报中','已驳回'].includes(t.fill);}\nfunction cycleKey(f){return ({单次:'本次填报',日报:'2026-10-23',周报:'2026年第43周',月报:'2026年10月',年报:'2026年度'})[f.cycle];}\nfunction taskCount(f){return TASKS.filter(t=>t.fid===f.id&&['已提交','已完成'].includes(t.fill)).length;}\nconst DETAIL_TABS=[['overview','基本信息'],['records','填报数据'],['statistics','统计分析'],['publish','发布管理'],['logs','操作日志']];\nconst CONFIGURATION_MENUS=[['design','表单设计'],['settings','填报设置'],['permissions','授权管理'],['workflow','审核流程'],['publish-config','表单发布']];\nfunction shell(){\n const p=store.active,configuration=CONFIGURATION_MENUS.some(([key])=>key===p);\n const menus=CONFIGURATION_MENUS.filter(([key])=>key!=='workflow'||FORM.type!=='普通表单');\n const context=Object.fromEntries(['origin','returnTo'].filter(k=>qp.has(k)).map(k=>[k,qp.get(k)]));\n const returnPath=qp.get('returnTo')||'',safeReturn=/^#\\/reporting(?:\\?|$)/.test(returnPath)?returnPath:'#/reporting?view=progress';\n const back=qp.get('origin')==='reporting'?safeReturn:'#/home',backLabel=qp.get('origin')==='reporting'?'返回填报进度':'返回表单中心';\n document.body.classList.toggle('form-configuration',configuration);\n document.body.classList.toggle('design-focus',p==='design'&&FORM.type!=='业务报表');\n document.body.classList.toggle('workflow-focus',p==='workflow'&&FORM.type==='流程表单');\n const heading=configuration?'<header class=\"config-topbar\"><div class=\"config-identity\"><a class=\"config-back\" href=\"'+href('overview',FORM,context)+'\" aria-label=\"返回表单详情\" title=\"返回表单详情\">'+icon('arrow-left')+'<\/a><h1 title=\"'+esc(FORM.name)+'\">'+esc(FORM.name)+'<\/h1><\/div><nav class=\"config-tabs\" aria-label=\"表单配置\">'+menus.map(([key,name])=>link(key,name,FORM,p===key?'active':'',context)).join('')+'<\/nav><\/header>':'<header class=\"form-detail-toolbar\"><a class=\"detail-back\" href=\"'+back+'\" aria-label=\"'+backLabel+'\" title=\"'+backLabel+'\">'+icon('arrow-left')+'<\/a><h1 class=\"detail-form-name\" title=\"'+esc(FORM.name)+'\">'+esc(FORM.name)+'<\/h1><nav class=\"form-detail-tabs\" aria-label=\"表单详情\">'+link('design',icon('edit')+' 编辑',FORM,'detail-edit',context)+DETAIL_TABS.map(([key,name])=>link(key,name,FORM,p===key?'active':'',context)).join('')+'<\/nav><\/header>';\n $('app').innerHTML='<div class=\"workspace '+(configuration?'form-config-workspace':'form-detail-workspace')+'\"><main class=\"main\">'+heading+'<section class=\"content\" id=\"content\"><\/section><\/main><\/div>';\n for(const a of document.querySelectorAll('.form-detail-tabs a.active,.config-tabs a.active'))a.setAttribute('aria-current','page');\n}\n\nfunction prototypeInfo(){openModal('产品逻辑与合并决策',\"<span class=\\\"tag orange\\\">原型设计中 · 2026-10-24<\/span><h3>现状与证据<\/h3><p>竹简定位为数据能力与应用搭建平台，包含基础填报、模型、指标和应用制作。现有在线文档依应用、页面关联，富文本编辑与保存已见代码；运行行为待产品验证。<\/p><h3>本轮确认的产品决策<\/h3><ol><li>文档中心承接原表单中心全部业务，表单与富文本、Word、Excel 统一组织。<\/li><li>应用门户改为工作台，使用我的工作、我的应用与部门空间标签组织内容。<\/li><li>模型、指标、应用管理保留平台独立入口。应用内表单保留来源与授权，复用填报基础能力。<\/li><li>保留普通表单、流程表单、专属业务报表、三种身份模式、周期任务、审核、独立的数据和统计权限。<\/li><li>内容收藏与任务关注分开；知识库引用和部门入口不会自动授予源文档、填报或数据权限。<\/li><\/ol><h3>对标依据<\/h3><p>DFM 填报场景、既有填报业务域合并方案与截图，以及<a href=\\\"https://alidocs.dingtalk.com/i/nodes/G1DKw2zgV2ARyGdohM3RAR0OWB5r9YAn\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">钉钉文档学习中心<\/a>的个人、团队和知识组织方式。<\/p><h3>工作台布局修正<\/h3><p>删除顶部进入文档中心按钮与横幅内三个快捷按钮。部门卡片增加部门文件，跳转至文件管理的部门文件栏目并定位对应部门。<\/p><p>我的应用与部门空间在桌面均为四列，分别补充项目协作应用与数据运营部。数据运营部为暂无已发布内容的示例空间。<\/p><p>我的工作删除常用能力；待填报、待审核、最近使用、工作提醒在桌面同一行等宽展示。中小屏按二列或单列排列。<\/p><h3>本次入口修正<\/h3><p>工作台标签顺序为我的工作、我的应用、部门空间；我的工作不重复展示应用和部门卡片。我的填报归入我的文档，工作台仅提供待办快捷访问。部门文档仍由文档中心管理。<\/p><h3>在线表单与填报合并<\/h3><p>取消独立我的填报菜单、文档列表与我的填报双页签；我的文档中的在线表单统一承接表单管理、填报任务与提交记录。待我填写与我的提交合并为我的填报，按填报及审核状态筛选。任务关注收进只看关注。个人、团队和应用的原归属与权限继续保留。<\/p><p>同一表单、不同周期分别保留任务与提交记录；完全匿名表单不生成人员任务。工作台通过任务编号直接进入我的填报并打开对应任务。仅允许按提交规则修改，流程审批中的记录通过审核规则处理。<\/p><h3>审核与数据入口合并<\/h3><p>按截图确认：我的审核、数据查看移入我的文档的在线表单标签页，移除左侧协作与数据分组。在线表单各业务视图共用当前页面中的表单、任务和提交数据。工作台待审核按任务编号打开审核面板。<\/p><p>审核任务按当前处理人校验；明细、统计、导出独立授权，部门范围分别过滤，匿名身份在明细与导出中保持隐藏。授权和角色数据为交互演示样例，正式校验待后端验证。<\/p><h3>表单与数据入口合并 · 2026-10-26<\/h3><p>我管理的与数据查看统一为表单管理。原数据查看链接进入表单管理并筛选数据与统计授权，仍独立校验管理、明细、统计、导出和数据范围权限；我的填报与我的审核入口保留。<\/p><h3>待研发确认<\/h3><p>Word / Excel 引擎、格式保真、多人协同、团队与源权限合并、匿名身份隔离、报表引擎、统一任务服务、发布版本与跨入口资源一致性。<\/p><p>本单文件整合当前目录的 14 个页面。文档、表单配置、填报记录、审批结果、收藏和任务关注在单文件内联动；浏览器允许本地存储时，刷新后仍会保留。部门文件的上传内容仅在本次会话中保留。应用管理、模型和指标仅展示入口说明。未修改正式业务代码或用户知识库。<\/p>\",'',null,760);}\nfunction renderPage(page){store.active=page;shell();const views={portal:renderPortal,forms:renderForms,overview:renderOverview,design:renderDesign,settings:renderSettings,permissions:renderPermissions,workflow:renderWorkflow,records:renderRecords,statistics:renderStatistics,publish:renderPublish,'publish-config':renderPublicationSettings,logs:renderLogs,fill:renderFill,audit:renderAudit,view:renderView,follow:renderFollow};views[page]();}\nfunction bindFilter(id,key){const el=$(id);if(el)el.addEventListener('change',()=>{store[key]=el.value;resetList();});}\nfunction keepSearch(id,key,render){const el=$(id);if(el)el.addEventListener('input',()=>{const pos=el.selectionStart;store[key]=el.value;store.page=1;render();const next=$(id);next.focus();next.setSelectionRange(pos,pos);});}\nfunction boot(){renderPage(store.active);document.addEventListener('click',e=>{const el=e.target.closest('[data-action]');if(!el||el.disabled)return;const action=el.dataset.action;if(action==='close-modal'){closeModal();return;}if(action==='modal-submit'){modalSubmit?.();return;}if(action==='wb-tab'){store.workbenchTab=el.dataset.tab;renderPortal();return;}if(action==='preview-department'){openModal('数据运营部 · '+esc(el.dataset.kind),empty('暂无已发布内容','数据运营部尚未发布可访问的'+esc(el.dataset.kind)+'。'),'',null,540);return;}if(action==='platform-entry'){platformEntry(el.dataset.entry);return;}if(action==='prototype'){prototypeInfo();return;}if(action==='prev'||action==='next'){store.page+=action==='prev'?-1:1;renderPage(store.active);return;}if(handleManagement(action,el)||handleConfiguration(action,el)||handleData(action,el)||handleParticipation(action,el))return;});document.addEventListener('change',e=>{if(e.target.id==='pageSize'){store.pageSize=Number(e.target.value);store.page=1;renderPage(store.active);}});$('modalMask').addEventListener('click',e=>{if(e.target===$('modalMask'))closeModal();});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();if(e.key==='Tab'&&$('modalMask').classList.contains('open')){const list=[...$('modalMask').querySelectorAll('button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),a[href]')];if(!list.length)return;const first=list[0],last=list.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}if(store.active==='design'&&(e.ctrlKey||e.metaKey)){if(e.key.toLowerCase()==='z'){e.preventDefault();restoreFields(e.shiftKey?1:-1);}if(e.key.toLowerCase()==='y'){e.preventDefault();restoreFields(1);}if(e.key.toLowerCase()==='s'){e.preventDefault();saveDesign();}}});if(qp.get('task')&&store.active==='fill'){const t=TASKS.find(t=>t.id===qp.get('task'));if(t)openTask(t.id);}}\n\nfunction platformEntry(key){if(key==='file'){__prototypeLocation.href='文件管理-部门文件.html';return}const data={apps:['应用管理','创建、设计、发布和管理业务应用。应用可以收集、展示和分析数据。'],model:['模型管理','维护实体、字段和数据来源，作为平台共享数据能力供填报和应用使用。'],metric:['指标管理','维护指标定义与计算口径，支持数据分析和应用展示。'],market:['应用市场','查看和复用应用模板。'],file:['文件管理','管理平台文件和业务附件。']};const [name,text]=data[key];openModal(name,'<p>'+text+'<\/p>'+notice('本轮保留独立平台入口，详情页面未在本组原型中展开。'),'',null,540);}\nfunction renderPortal(){const pending=mineTasks().filter(canFill),reviews=TASKS.filter(t=>t.audit==='待审核'),personal=mineTasks(),department=store.workbenchTab==='department',applications=store.workbenchTab==='apps';const resourceLink=(file,label,cls='')=>'<a class=\"'+cls+'\" href=\"'+file+'\">'+label+'<\/a>';const deptCards=[['产品设计团队','需求方案、设计规范与业务收集','palette',0,'f4'],['平台研发团队','研发文档、协作知识与安全填报','code',1,'f11'],['综合管理部','制度、人事与行政公共资料','building',2,null],['数据运营部','指标口径、数据规范与运营资料','chart-dots',null,null]].map(([name,desc,ic,i,fid])=>'<article class=\"department-card\"><div class=\"dept-title\"><span class=\"dept-icon\">'+icon(ic)+'<\/span><div><h3>'+name+'<\/h3><small>我可访问的组织空间<\/small><\/div><\/div><p>'+desc+'<\/p><div class=\"dept-links\">'+resourceLink('文件管理-部门文件.html?dept='+['product','development','administration','data'][i===null?3:i],'部门文件 '+icon('arrow-up-right'))+(i===null?btn('部门文档 '+icon('arrow-up-right'),'preview-department','link','data-kind=\"部门文档\"')+btn('知识库 '+icon('arrow-up-right'),'preview-department','link','data-kind=\"知识库\"'):resourceLink('文档中心-团队文档.html?team='+i,'部门文档 '+icon('arrow-up-right'))+resourceLink('文档中心-知识库.html?wiki='+i,'知识库 '+icon('arrow-up-right'))+(fid?resourceLink('文档中心-团队文档.html?team='+i+'&type=form','部门表单 '+icon('arrow-up-right')):''))+'<\/div><\/article>').join('');const todos=panel('待填报 <span class=\"pill-stat\">'+pending.length+' 项<\/span>',pending.slice(0,3).map(t=>'<div class=\"portal-task\"><div><strong>'+esc(formById(t.fid).name)+'<\/strong><small>'+esc(t.cycle)+' · 截止 '+t.due+'<\/small><\/div>'+link('fill','去填报',formById(t.fid),'',{task:t.id})+'<\/div>').join('')||empty('暂无待填报任务','当前任务均已处理。'),link('fill','查看全部 '+icon('chevron-right')))+panel('待审核 <span class=\"pill-stat\">'+reviews.length+' 项<\/span>',reviews.slice(0,3).map(t=>'<div class=\"portal-task\"><div><strong>'+esc(formById(t.fid).name)+'<\/strong><small>'+esc(t.person)+' · '+esc(t.node)+'<\/small><\/div>'+link('audit','去审核',formById(t.fid),'',{review:t.id})+'<\/div>').join(''),link('audit','查看全部 '+icon('chevron-right')));\n$('content').innerHTML='<div class=\"portal-content\">'+head('你好，高源','从工作台进入应用、部门资料和待办事项。')+'<section class=\"workbench-intro\"><div><span class=\"eyebrow\">竹简工作台<\/span><h2>连接数据，开展工作<\/h2><p>收集业务数据，协作维护内容，通过应用展示与分析成果。<\/p><\/div><\/section><div class=\"tabs\"><button class=\"tab '+(!department&&!applications?'active':'')+'\" data-action=\"wb-tab\" data-tab=\"mine\">我的工作<\/button><button class=\"tab '+(applications?'active':'')+'\" data-action=\"wb-tab\" data-tab=\"apps\">我的应用<\/button><button class=\"tab '+(department?'active':'')+'\" data-action=\"wb-tab\" data-tab=\"department\">部门空间<\/button><\/div>'+(department?head('部门空间','按授权访问部门文件、在线文档、知识库和表单。')+'<div class=\"department-grid\">'+deptCards+'<\/div>'+notice('部门文件由文件管理维护；在线文档、知识库与表单由文档中心管理，分别校验访问权限。'):applications?panel('我的应用','<div class=\"application-grid\">'+[['访客管理','登记、审批与访问记录','id'],['设备运行监测','收集运行数据并展示分析','device-desktop-analytics'],['教学质量分析','指标展示与业务分析','chart-bar'],['项目协作','任务进展收集与交付分析','clipboard-data']].map(([n,d,i])=>'<button class=\"application-card\" data-action=\"platform-entry\" data-entry=\"apps\"><span class=\"dept-icon\">'+icon(i)+'<\/span><strong>'+n+'<\/strong><small>'+d+'<\/small><span class=\"muted\">应用入口 '+icon('arrow-up-right')+'<\/span><\/button>').join('')+'<\/div>',btn('全部应用 '+icon('chevron-right'),'platform-entry','link','data-entry=\"apps\"')):'<div class=\"count-grid\">'+metric('待填报',pending.length,'按对象、周期分配任务')+metric('待审核',reviews.length,'按当前审核节点处理')+metric('已提交任务',personal.filter(t=>['已提交','已完成'].includes(t.fill)).length,'填报状态与审核状态分别记录')+metric('已加入空间',4,'部门和协作团队 · 示例数据')+'<\/div><div class=\"workbench-layout\">'+todos+panel('最近使用',resourceLink('文档中心-我的文档.html?open=1','<div class=\"recent-item\">'+icon('file-text')+'<div><strong>文档中心模块需求说明<\/strong><small>富文本 · 我的文档<\/small><\/div>'+icon('arrow-up-right')+'<\/div>')+resourceLink('文档中心-我的文档.html?open=3','<div class=\"recent-item\">'+icon('file-type-xls')+'<div><strong>四季度项目资源计划<\/strong><small>Excel · 我的文档<\/small><\/div>'+icon('arrow-up-right')+'<\/div>')+link('overview','<div class=\"recent-item\">'+icon('forms')+'<div><strong>'+esc(FORMS[0].name)+'<\/strong><small>普通表单 · 收集中<\/small><\/div>'+icon('arrow-up-right')+'<\/div>',FORMS[0]))+panel('工作提醒','<div class=\"activity\">'+icon('calendar-event')+'<div>10 月设备填报将于 31 日截止<small style=\"display:block;margin-top:5px\">请关注各任务的周期和截止时间。<\/small><\/div><\/div><div class=\"activity\">'+icon('shield-check')+'<div>在授权范围内访问部门资料<small style=\"display:block;margin-top:5px\">填报数据、统计和文档分别授权。<\/small><\/div><\/div>')+'<\/div>')+'<\/div>';}\nfunction categories(items){const groups=['信息采集','教育教学','设备管理','行政事务'];return '<aside class=\"category\"><div class=\"category-head\"><h2>表单分类<\/h2>'+''+'<\/div>'+inputSearch('categorySearch','按分类名称搜索',store.categorySearch)+'<div class=\"category-tree\"><button class=\"category-row '+(store.category==='全部'?'active':'')+'\" data-action=\"category\" data-category=\"全部\">'+icon('folders')+'全部<span class=\"count\">'+items.length+'<\/span><\/button>'+groups.filter(c=>c.includes(store.categorySearch)).map(c=>'<button class=\"category-row '+(store.category===c?'active':'')+'\" data-action=\"category\" data-category=\"'+c+'\">'+icon('folder')+c+'<span class=\"count\">'+items.filter(x=>(x.category||formById(x.fid)?.category)===c).length+'<\/span><\/button>').join('')+(groups.every(c=>!c.includes(store.categorySearch))?'<p class=\"muted\" style=\"padding:12px\">未找到分类<\/p>':'')+'<\/div><\/aside>';}\nfunction filteredForms(){return FORMS.filter(f=>store.tab==='recycle'?f.deleted:!f.deleted).filter(f=>store.tab==='favorite'?f.favorite:store.tab==='shared'?f.shared:store.tab==='all'||store.tab==='recycle'?true:f.owner==='高源').filter(f=>store.category==='全部'||f.category===store.category).filter(f=>['普通表单','流程表单','业务报表'].includes(store.tab)?f.type===store.tab:true).filter(f=>f.name.toLowerCase().includes(store.filter.toLowerCase())).filter(f=>store.status==='全部'||f.status===store.status);}\nfunction formActions(f){if(store.tab==='recycle')return btn('恢复','restore-form','small','data-id=\"'+f.id+'\"');return '<div class=\"row-actions\">'+link('overview','管理',f)+link('design',f.type==='业务报表'?'报表':'设计',f)+link('publish','发布',f)+'<button class=\"link\" data-action=\"more-form\" data-id=\"'+f.id+'\">更多 '+icon('chevron-down')+'<\/button><\/div>';}\nfunction renderForms(){const filtered=filteredForms();const items=pageItems(filtered);const all=FORMS.filter(f=>store.tab==='recycle'?f.deleted:!f.deleted).filter(f=>store.tab==='favorite'?f.favorite:store.tab==='shared'?f.shared:store.tab==='all'||store.tab==='recycle'?true:f.owner==='高源');const title=({favorite:'我的收藏',shared:'共享表单',all:'所有表单',recycle:'回收站'})[store.tab]||'我的表单';const typeTabs=['全部','普通表单','流程表单','业务报表'];const tabSelected=typeTabs.includes(store.tab)?store.tab:'全部';$('content').innerHTML=head(title,'统一管理独立表单、流程表单及业务报表。',store.tab==='recycle'?'':btn(icon('plus')+' 新建表单','new-form','primary'))+'<div class=\"list-layout\">'+categories(all)+'<div><div class=\"toolbar\"><div class=\"inline\">'+inputSearch('formSearch','按表单名称搜索',store.filter)+select('formStatus',['全部','草稿','未发布','收集中','已暂停','已结束','已归档'],store.status,'aria-label=\"发布状态筛选\"')+'<\/div><div class=\"inline\">'+(store.tab==='recycle'?'':btn(icon('arrows-move')+' 批量移动','move-forms','',!store.selected.size?'disabled':'')+btn(icon('upload')+' 导入表单','import-form'))+'<div class=\"toggle-group\">'+btn(icon('list'),'list-view',store.view==='list'?'active':'','aria-label=\"列表视图\"')+btn(icon('layout-grid'),'card-view',store.view==='card'?'active':'','aria-label=\"卡片视图\"')+'<\/div><\/div><\/div>'+(!['favorite','shared','all','recycle'].includes(store.tab)?'<div class=\"tabs\">'+typeTabs.map(t=>'<button class=\"tab '+(tabSelected===t?'active':'')+'\" data-action=\"type-tab\" data-type=\"'+t+'\">'+t+' <small>'+all.filter(f=>(t==='全部'||f.type===t)&&f.owner==='高源').length+'<\/small><\/button>').join('')+'<\/div>':'')+(store.view==='list'?'<div class=\"table-card\"><div class=\"table-wrap\"><table><thead><tr><th><input type=\"checkbox\" id=\"selectAllForms\" aria-label=\"选择当前页全部表单\" '+(items.length&&items.every(f=>store.selected.has(f.id))?'checked':'')+'><\/th><th>表单名称<\/th><th>类型<\/th><th>更新时间<\/th><th>发布状态<\/th><th>已提交 / 应填<\/th><th>操作<\/th><\/tr><\/thead><tbody>'+items.map(f=>'<tr><td><input type=\"checkbox\" class=\"form-check\" data-id=\"'+f.id+'\" aria-label=\"选择'+esc(f.name)+'\" '+(store.selected.has(f.id)?'checked':'')+'><\/td><td class=\"name-cell\"><div class=\"row-name\"><button class=\"favorite '+(f.favorite?'on':'')+'\" data-action=\"favorite-form\" data-id=\"'+f.id+'\" aria-label=\"'+(f.favorite?'取消收藏':'收藏')+esc(f.name)+'\">'+icon('star')+'<\/button>'+typeIcon(f)+'<div>'+link('overview','<strong>'+esc(f.name)+'<\/strong>',f)+'<small>'+esc(f.category)+' · '+esc(f.owner)+'<\/small><\/div><\/div><\/td><td>'+tag(f.type,f.type==='流程表单'?'purple':f.type==='业务报表'?'orange':'')+'<\/td><td>'+f.updated.replace(' ','<br>')+'<\/td><td>'+stateTag(f.status)+'<\/td><td>'+taskCount(f)+' / '+TASKS.filter(t=>t.fid===f.id).length+'<\/td><td>'+formActions(f)+'<\/td><\/tr>').join('')+'<\/tbody><\/table><\/div>'+(items.length?'':empty())+pagination(filtered.length)+'<\/div>':(items.length?'<div class=\"card-grid\">'+items.map(f=>'<div class=\"form-card\"><div class=\"inline\">'+typeIcon(f)+stateTag(f.status)+'<\/div><h3>'+link('overview',esc(f.name),f)+'<\/h3><small>'+esc(f.category)+' · '+esc(f.type)+'<\/small><p class=\"muted\" style=\"margin-top:12px\">'+f.updated+' 更新<\/p><div class=\"card-actions\">'+formActions(f)+'<\/div><\/div>').join('')+'<\/div>'+pagination(filtered.length):empty()))+'<\/div><\/div>';\nkeepSearch('formSearch','filter',renderForms);keepSearch('categorySearch','categorySearch',renderForms);bindFilter('formStatus','status');$('selectAllForms')?.addEventListener('change',e=>{items.forEach(f=>e.target.checked?store.selected.add(f.id):store.selected.delete(f.id));renderForms();});document.querySelectorAll('.form-check').forEach(el=>el.addEventListener('change',()=>{el.checked?store.selected.add(el.dataset.id):store.selected.delete(el.dataset.id);renderForms();}));}\nlet basicFormEntry=null;\nfunction applyFormPresentation(paper,entryRoot,config){\n const runtime=entryRoot.matches('[data-fd-runtime]')?entryRoot:entryRoot.querySelector('[data-fd-runtime]');\n paper.style.fontFamily=config.font;paper.style.letterSpacing=Number(config.letterSpacing||0)+'px';\n if(config.background){paper.style.backgroundColor=runtime.style.backgroundColor;paper.style.backgroundImage=runtime.style.backgroundImage;runtime.style.removeProperty('background-color');runtime.style.removeProperty('background-image');}\n const title=document.createElement('h2');title.className='basic-form-title';title.textContent=config.name||FORM.name;\n Object.assign(title.style,{fontFamily:config.font,fontSize:Number(config.nameSize||22)+'px',color:config.nameColor,textAlign:({'左对齐':'left','居中':'center','右对齐':'right'}[config.nameAlign]||'center'),fontWeight:config.nameBold?'600':'400'});\n const lead=runtime.querySelector('.fd-banner')||runtime.querySelector('.fd-cover');if(lead)lead.after(title);else runtime.prepend(title);\n}\nfunction basicInformationTask(){\n const current=TASKS.find(t=>t.fid===FORM.id&&t.person==='高源'&&t.cycle===cycleKey(FORM)&&t.version===FORM.version&&canFill(t));\n return current||{id:'basic-preview-'+FORM.id,fid:FORM.id,person:'高源',dept:'信息工程学院',cycle:cycleKey(FORM),version:FORM.version,preview:true,...structuredClone(FormLinkState.read().formEntryDrafts?.[FORM.id]||{})};\n}\nfunction renderOverview(){\n const t=basicInformationTask(),schema=FD.schema(FORM,FORM.version,true),values=formEntryValuesFor(t),options={prefix:'basic-',rows:t.batchRows};\n const content=$('content');content.classList.add('basic-information-content');\n content.innerHTML='<div class=\"basic-form-fields\">'+FD.renderEntry(schema.fields,schema.design,values,options)+'<\/div><div id=\"basicFormError\" class=\"fill-error\" role=\"alert\"><\/div>';\n const entryRoot=content.querySelector('[data-fd-entries],[data-fd-runtime]');\n applyFormPresentation(content.querySelector('.basic-form-fields'),entryRoot,schema.design);\n const renderer=FD.mountEntry(entryRoot,schema.fields,schema.design,{...options,values,records:RECORDS,newRecord:!t.values,context:{formId:FORM.id}});\n basicFormEntry={task:t,schema,renderer};\n content.insertAdjacentHTML('afterend','<footer class=\"basic-form-actions\"><button type=\"button\" class=\"btn primary\" data-basic-entry=\"submit\">提交<\/button><button type=\"button\" class=\"btn\" data-basic-entry=\"draft\">保存草稿<\/button><span class=\"basic-form-status\" role=\"status\">'+(t.preview?'填写预览，提交不生成正式记录':'')+'<\/span><\/footer>');\n document.querySelector('.basic-form-actions').addEventListener('click',e=>{const action=e.target.closest('[data-basic-entry]')?.dataset.basicEntry;if(action)saveBasicInformation(action);});\n}\nfunction saveBasicInformation(action){\n const {task:t,schema,renderer}=basicFormEntry;\n if(!t.preview&&!canFill(t))return toast('当前任务已不可填写，请刷新页面');\n if(action==='draft'){\n  saveFormEntryDraft(t,renderer);\n  if(t.preview)FormLinkState.update(state=>{state.formEntryDrafts=state.formEntryDrafts||{};state.formEntryDrafts[FORM.id]=structuredClone(t);});else persistForm();\n  $('basicFormError').textContent='';document.querySelector('.basic-form-status').textContent='草稿已保存'+(t.preview?' · 填写预览':'');toast('草稿已保存，未计入有效提交');return;\n }\n const result=submitFormEntry(t,FORM,renderer,schema,RECORDS,RECORDS.find(r=>r.tid===t.id));\n if(result.errors){$('basicFormError').textContent='请检查标红的填写项';return;}\n $('basicFormError').textContent='';\n if(result.preview){document.querySelector('.basic-form-status').textContent='预览提交成功，未生成正式记录';toast('预览提交成功，不生成个人任务或提交记录');return;}\n persistForm();document.querySelector('.basic-form-status').textContent=FORM.type==='流程表单'?'已提交，等待审核':'提交成功，可在填报数据中查看';\n document.querySelectorAll('[data-basic-entry]').forEach(b=>b.disabled=true);toast(FORM.type==='流程表单'?'已提交，等待审核':'填报已完成');\n}\n\nfunction newForm(){openModal('新建表单','<div class=\"field-grid\">'+field('表单名称<span class=\"required\">*<\/span>','<input id=\"newFormName\" maxlength=\"60\" placeholder=\"例如：院系月度工作情况填报\">','最多 60 个字',true)+field('表单类型',select('newFormType',['普通表单','流程表单','业务报表'],'普通表单'),'普通、流程表单复用轻流程设计器。',true)+field('所属分类',select('newFormCategory',['信息采集','教育教学','设备管理','行政事务'],'信息采集'),'',true)+'<\/div>','创建并设计',()=>{const name=$('newFormName').value.trim();if(!name)return modalError('请输入表单名称。');const f={...FORMS[0],id:'new-'+Date.now(),name,type:$('newFormType').value,category:$('newFormCategory').value,status:'草稿',published:false,version:1};__prototypeLocation.href=href('design',f);});}\nfunction openMoreForm(id){const f=formById(id);openModal(esc(f.name),'<div class=\"grid-2\">'+btn(icon('copy')+' 复制表单','copy-form','','data-id=\"'+id+'\"')+btn(icon('pencil')+' 重命名','rename-form','','data-id=\"'+id+'\"')+btn(icon('archive')+' 归档','archive-form','','data-id=\"'+id+'\"')+btn(icon('trash')+' 移入回收站','delete-form','danger','data-id=\"'+id+'\"')+'<\/div><p class=\"foot-note\">复制会创建新草稿，重新设置发布、权限与任务，不复制填报数据。<\/p>');}\nfunction handleManagement(action,el){const id=el.dataset.id;if(action==='forms-nav'){store.tab=el.dataset.tab;store.category='全部';store.status='全部';resetList();return true;}if(action==='category'){store.category=el.dataset.category;resetList();return true;}if(action==='type-tab'){store.tab=el.dataset.type;resetList();return true;}if(action==='list-view'||action==='card-view'){store.view=action==='list-view'?'list':'card';renderForms();return true;}if(action==='favorite-form'){const f=formById(id);f.favorite=!f.favorite;renderForms();return true;}if(action==='new-form'){newForm();return true;}if(action==='more-form'){openMoreForm(id);return true;}if(action==='restore-form'){formById(id).deleted=false;renderForms();toast('表单已恢复');return true;}if(action==='move-forms'){openModal('批量移动 '+store.selected.size+' 个表单',field('目标分类',select('moveCategory',['信息采集','教育教学','设备管理','行政事务'],'信息采集')),'确认移动',()=>{FORMS.filter(f=>store.selected.has(f.id)).forEach(f=>f.category=$('moveCategory').value);closeModal();store.selected.clear();renderForms();toast('所选表单已移动');});return true;}if(action==='add-category'){openModal('分类管理',notice('当前使用信息采集、教育教学、设备管理、行政事务四个业务分类。分类维护由系统管理员统一管理。')+'<div class=\"grid-2\">'+['信息采集','教育教学','设备管理','行政事务'].map(c=>'<div class=\"recent-item\">'+icon('folder')+c+'<\/div>').join('')+'<\/div>');return true;}if(action==='import-form'){openModal('导入表单配置',notice('导入用于建立新草稿，不迁移旧接口、授权、周期任务及历史流程记录。','warning')+field('选择配置文件','<input type=\"file\" id=\"importConfig\" accept=\".json\">','支持包含 name、type、fields 的 JSON 配置文件。',true)+'<p class=\"foot-note\">业务数据在“填报数据”中单独导入。<\/p>','校验并导入',async()=>{const file=$('importConfig').files[0];if(!file)return modalError('请选择 JSON 配置文件。');try{const obj=JSON.parse(await file.text());if(!obj.name||typeof obj.name!=='string'||!['普通表单','流程表单'].includes(obj.type)||!Array.isArray(obj.fields)||!obj.fields.length||obj.fields.length>30||obj.fields.some(x=>!x||typeof x.label!=='string'||!COMPONENTS.some(c=>c.type===x.type)))return modalError('配置需包含名称、类型及 1 至 30 个支持的字段，每个字段须有 label 和 type。');const f={...FORMS[0],id:'new-'+Date.now(),name:obj.name.slice(0,60),type:obj.type,status:'草稿',published:false,version:1,fields:obj.fields.slice(0,30).map((x,i)=>({id:'import-'+i,type:x.type,label:String(x.label||'导入字段'+(i+1)),required:!!x.required,hidden:!!x.hidden,half:!!x.half,options:String(x.options||'选项一,选项二')}))};FORMS.unshift(f);closeModal();renderForms();toast('已导入为新草稿，请在设计页重新核对字段和布局');}catch{modalError('无法解析配置文件，请检查 JSON 格式。');}});return true;}if(['copy-form','rename-form','archive-form','delete-form'].includes(action)){const f=formById(id);if(action==='copy-form'){const copy={...f,id:'new-'+Date.now(),name:f.name+'（副本）',status:'草稿',published:false,version:1,owner:'高源',deleted:false};FORMS.unshift(copy);closeModal();renderForms();toast('已创建副本草稿，不包含原填报数据');}else if(action==='rename-form'){openModal('重命名表单',field('表单名称','<input id=\"renameInput\" maxlength=\"60\" value=\"'+esc(f.name)+'\">'),'保存',()=>{const name=$('renameInput').value.trim();if(!name)return modalError('名称不能为空。');f.name=name;closeModal();renderForms();toast('名称已更新');});}else{openModal(action==='delete-form'?'移入回收站':'归档表单',notice(action==='delete-form'?'移入回收站后停止公开收集和任务填报，已有数据保留，可从回收站恢复。':'归档后停止收集，已有记录保留为只读。','warning'),'确认',()=>{if(action==='delete-form')f.deleted=true;else f.status='已归档';closeModal();renderForms();toast('已'+(action==='delete-form'?'移入回收站':'归档'));});}return true;}return false;}\n\nfunction renderBasicSettings(){const anonymous=FORM.identity==='完全匿名';$('content').innerHTML=head('填报设置','配置填写身份、填报周期、次数和提醒规则。',btn(icon('device-floppy')+' 保存设置','save-settings','primary'))+panel('身份与访问方式','<div class=\"choice-cards\">'+[['实名填报','保存提交人身份，用于定向任务、人员统计和审批。'],['登录匿名','登录校验访问资格，对数据和统计查看者隐藏身份。'],['完全匿名','公开链接访问，不建立人员填报任务。']].map(x=>'<button class=\"choice-card '+(FORM.identity===x[0]?'active':'')+'\" data-action=\"identity\" data-value=\"'+x[0]+'\">'+icon(FORM.identity===x[0]?'circle-check':'circle')+'<div><strong>'+x[0]+'<\/strong><p>'+x[1]+'<\/p><\/div><\/button>').join('')+'<\/div>'+(FORM.identity==='登录匿名'?'<div style=\"margin-top:16px\">'+notice('数据明细、统计和导出均隐藏人员身份，不开放人员维度及未填报名单。访问资格与业务响应分开管理。')+'<\/div>':'')) +panel('填报范围与周期','<div class=\"field-grid\">'+field('访问范围',select('settingScope',anonymous?['公开访问']:['指定组织','指定人员','指定角色'],anonymous?'公开访问':FORM.scope),anonymous?'公开匿名按响应数量统计，不计算应填人员。':'发布范围不能超过创建者或协作者被授权管理的范围。')+field('填报对象','<div class=\"inline\"><input id=\"settingAudience\" readonly value=\"'+(anonymous?'公开访问者':esc(FORM.audience.join('、')))+'\">'+btn('选择','choose-audience','',''+(anonymous?'disabled':''))+'<\/div>')+field('填报周期',select('settingCycle',anonymous?['单次']:['单次','日报','周报','月报','年报'],anonymous?'单次':FORM.cycle),'周期模式按对象、周期生成独立任务。')+field('每周期提交次数','<div class=\"inline\"><input type=\"number\" id=\"settingLimit\" min=\"1\" max=\"99\" value=\"'+FORM.limit+'\"><span>次<\/span><\/div>','同一任务的草稿保存不计入有效提交次数。')+field('开始时间','<input type=\"datetime-local\" id=\"settingStart\" value=\"'+FORM.start+'\">')+field('截止时间','<input type=\"datetime-local\" id=\"settingEnd\" value=\"'+FORM.end+'\">')+field('截止后处理',select('settingLate',['禁止提交','允许补填并标记逾期'],FORM.late||'禁止提交'),'补填不会覆盖原周期任务或改变原始截止时间。')+field('历史数据填充',select('settingPrefill',['不自动填充','带入上周期有效数据','带入最近一次有效数据'],FORM.prefill||'不自动填充'),'带入内容只作为本期草稿，需要重新核对并提交。')+'<\/div>')+panel('提醒与提交规则','<div class=\"field-grid\">'+field('任务提醒','<label class=\"check-label\"><input type=\"checkbox\" id=\"settingReminder\" '+(FORM.reminder?'checked':'')+(anonymous?' disabled':'')+'>生成任务时通知填报对象<\/label>')+field('截止提醒','<div class=\"inline\"><label class=\"check-label\"><input type=\"checkbox\" id=\"settingDeadlineReminder\" '+(anonymous?'disabled':FORM.deadlineReminder===false?'':'checked')+'>截止前<\/label><input type=\"number\" id=\"settingDays\" value=\"'+(FORM.reminderDays||3)+'\" min=\"1\" max=\"30\" '+(anonymous?'disabled':'')+'><span>天提醒<\/span><\/div>')+field('提交后修改',select('settingEdit',['截止前允许修改','提交后不可修改'],FORM.edit||'截止前允许修改'))+(FORM.type==='流程表单'?field('提交撤回','<label class=\"check-label\"><input type=\"checkbox\" id=\"settingWithdraw\" '+(FORM.allowWithdraw?'checked':'')+'>审核开始处理前允许撤回<\/label>','撤回后回到原周期任务草稿，保留提交与流程历史。'):'')+field('重复提交规则',select('settingDuplicate',['同一任务只保留有效结果','达到次数限制后禁止提交'],FORM.duplicate||'同一任务只保留有效结果'))+'<\/div>')+'<div class=\"savebar\"><span class=\"muted\" id=\"saveState\">'+(store.saved?'设置已保存在当前浏览器':'更改配置后请保存')+'<\/span><span class=\"muted\">已生成任务的范围和历史截止时间不会被自动覆盖。<\/span><\/div>';}\nfunction readSettings(){if(!validateLotteryBeforeSave())return false;const scope=$('settingScope').value;const cycle=$('settingCycle').value;const limit=Number($('settingLimit').value);const start=$('settingStart').value,end=$('settingEnd').value;if(!start||!end||end<=start){toast('截止时间必须晚于开始时间');return false;}if(!Number.isInteger(limit)||limit<1||limit>99){toast('提交次数须为 1 至 99 的整数');return false;}if($('settingDeadlineReminder').checked&&(!Number.isInteger(Number($('settingDays').value))||Number($('settingDays').value)<1||Number($('settingDays').value)>30)){toast('截止提醒应为 1 至 30 天');return false;}Object.assign(FORM,{lottery:structuredClone(lotteryDraft),scope,cycle,limit,start,end,reminder:$('settingReminder').checked,deadlineReminder:$('settingDeadlineReminder').checked,reminderDays:Number($('settingDays').value),late:$('settingLate').value,prefill:$('settingPrefill').value,edit:$('settingEdit').value,duplicate:$('settingDuplicate').value,allowWithdraw:!!$('settingWithdraw')?.checked});store.saved=true;addLog('修改配置','更新填报规则与抽奖设置');return true;}\nfunction chooseAudience(){let chosen=new Set(FORM.audience);const body=notice('当前创建者可管理信息工程学院和理学院。其他组织不可选择。')+inputSearch('audienceSearch','搜索组织或成员')+'<div class=\"scope-tree\" id=\"audienceTree\">'+['信息工程学院','理学院','机关部门'].map((d,i)=>'<div data-org=\"'+d+'\"><label><input type=\"checkbox\" data-parent=\"'+d+'\" '+(chosen.has(d)?'checked':'')+(i===2?' disabled':'')+'>'+icon('building')+d+(i===2?' <small>无管理权限<\/small>':'')+'<\/label>'+[d+'办公室',d+'教学组'].map(c=>'<label class=\"child\"><input type=\"checkbox\" data-child=\"'+d+'\" value=\"'+c+'\" '+(chosen.has(d)?'checked':'')+(i===2?' disabled':'')+'>'+c+'<\/label>').join('')+'<\/div>').join('')+'<\/div><div class=\"selected-list\" id=\"audienceSelected\"><\/div>';openModal('选择填报对象',body,'确定选择',()=>{const selected=[];document.querySelectorAll('#audienceTree [data-parent]:not(:disabled)').forEach(p=>{if(p.checked)selected.push(p.dataset.parent);else document.querySelectorAll('#audienceTree [data-child=\"'+p.dataset.parent+'\"]:checked').forEach(c=>selected.push(c.value));});if(!selected.length)return modalError('请至少选择一个有管理权限的对象。');FORM.audience=selected;closeModal();if($('settingAudience'))$('settingAudience').value=selected.join('、');if(store.active==='permissions')renderPermissions();});const sync=()=>{$('audienceSelected').innerHTML=[...document.querySelectorAll('#audienceTree [data-parent]:checked')].map(p=>tag(p.dataset.parent)).join('');};$('audienceTree').addEventListener('change',e=>{const el=e.target;if(el.dataset.parent){document.querySelectorAll('#audienceTree [data-child=\"'+el.dataset.parent+'\"]').forEach(c=>c.checked=el.checked);}if(el.dataset.child){const parent=document.querySelector('#audienceTree [data-parent=\"'+el.dataset.child+'\"]');const children=[...document.querySelectorAll('#audienceTree [data-child=\"'+el.dataset.child+'\"]')];parent.checked=children.every(c=>c.checked);parent.indeterminate=children.some(c=>c.checked)&&!parent.checked;}sync();});$('audienceSearch').addEventListener('input',e=>{document.querySelectorAll('#audienceTree>div').forEach(d=>d.hidden=!d.textContent.includes(e.target.value));});sync();}\nfunction renderPermissions(){const keys=['design','publish','fill','audit','data','stats','export'];$('content').innerHTML=head('授权管理','按管理、填报、审核、数据与统计分别授权。',btn(icon('device-floppy')+' 保存授权','save-permissions','primary'))+notice('统计查看权限独立于明细数据权限。导出权限仍受对应数据范围约束，不能扩大可见范围。')+panel('协作成员','<div class=\"toolbar\">'+inputSearch('permissionSearch','搜索成员或部门')+btn(icon('user-plus')+' 添加成员','add-member')+'<\/div>'+table(['成员 / 部门','设计','发布','填报','审核','数据明细','统计','导出','范围与操作'],store.permissionRows.map(p=>'<tr data-member=\"'+esc(p.name+p.dept)+'\"><td><strong>'+esc(p.name)+'<\/strong><small style=\"display:block\">'+esc(p.dept)+'<\/small><\/td>'+keys.map(k=>'<td><input type=\"checkbox\" aria-label=\"'+esc(p.name)+'的'+({design:'设计',publish:'发布',fill:'填报',audit:'审核',data:'明细查看',stats:'统计查看',export:'导出'})[k]+'权限\" data-permission=\"'+p.id+'\" data-key=\"'+k+'\" '+(p[k]?'checked':'')+(p.locked?' disabled':'')+'><\/td>').join('')+'<td><div class=\"row-actions\"><small>'+esc(p.scope)+'<\/small>'+(!p.locked?btn('配置','member-scope','small','data-id=\"'+p.id+'\"'):'<small>创建者<\/small>')+'<\/div><\/td><\/tr>'),'permission-table'))+panel('权限规则','<div class=\"grid-3\"><div><h3>'+icon('forms')+' 表单管理<\/h3><p class=\"muted\" style=\"margin-top:9px\">设计、发布、授权均可分别配置；协作者可操作范围不得超出授予范围。<\/p><\/div><div><h3>'+icon('table')+' 明细与字段<\/h3><p class=\"muted\" style=\"margin-top:9px\">数据明细按行范围与字段权限过滤，匿名模式隐藏提交人身份。<\/p><\/div><div><h3>'+icon('chart-bar')+' 统计与导出<\/h3><p class=\"muted\" style=\"margin-top:9px\">仅授予统计的成员可查看汇总，不能由统计页进入未授权明细。<\/p><\/div><\/div>')+'<div class=\"savebar\"><span class=\"muted\" id=\"permissionSaved\">修改后点击保存授权<\/span>'+link('statistics','预览仅统计角色的效果',FORM,'btn',{role:'statistics'})+'<\/div>';\n $('permissionSearch').addEventListener('input',e=>document.querySelectorAll('[data-member]').forEach(r=>r.hidden=!r.dataset.member.includes(e.target.value)));document.querySelectorAll('[data-permission]').forEach(c=>c.addEventListener('change',()=>{const p=store.permissionRows.find(x=>x.id===c.dataset.permission);p[c.dataset.key]=c.checked;}));}\nfunction memberScope(id){const p=store.permissionRows.find(x=>x.id===id);openModal('配置 '+esc(p.name)+' 的数据范围','<div class=\"field-grid\">'+field('数据明细范围',select('memberDataScope',['仅本人提交','本部门','全部授权范围'],p.scope==='全部授权范围'?p.scope:'本部门'))+field('统计范围',select('memberStatScope',['本部门','全部授权范围'],p.scope==='全部授权范围'?p.scope:'本部门'))+field('可见字段','<div class=\"radio-row\"><label><input type=\"checkbox\" checked disabled>所属单位<\/label><label><input type=\"checkbox\" id=\"memberQty\" checked>设备数量<\/label><label><input type=\"checkbox\" id=\"memberNote\" checked>情况说明<\/label><\/div>','提交人身份仍受匿名策略控制。',true)+'<\/div>','保存范围',()=>{p.scope=$('memberStatScope').value==='本部门'?p.dept:$('memberStatScope').value;p.dataScope=$('memberDataScope').value;p.fields=[$('memberQty').checked?'设备数量':'',$('memberNote').checked?'情况说明':''].filter(Boolean);closeModal();renderPermissions();toast('范围配置已更新，请保存授权');});}\n\n\n\n\n\n\n\n\n\n\n\n\n\nfunction renderWorkflow(){document.body.classList.toggle('workflow-focus',FORM.type==='流程表单');if(FORM.type!=='流程表单'){$('content').innerHTML=head('审核流程')+empty('此表单无需审核流程','流程表单可配置审核节点和处理人。',link('workflow','查看审核流程示例',formById('f2'),'btn'));return;}const node=store.nodes.find(n=>n.id===store.nodeId);$('content').innerHTML='<div class=\"editor workflow-editor\"><div class=\"editor-toolbar\"><div class=\"editor-left\">'+link('overview',icon('arrow-left')+' 表单详情',FORM,'btn')+'<\/div><div class=\"editor-tabs\"><strong>审核流程<\/strong>'+tag('设计版本 v'+FORM.version,'gray')+'<\/div><div class=\"editor-right\">'+btn('校验','validate-flow')+btn('保存流程','save-flow','primary')+'<\/div><\/div><div class=\"editor-body\"><aside class=\"palette\"><h2>流程节点<\/h2><div class=\"palette-grid\">'+btn(icon('rubber-stamp')+' 审批节点','add-node','','data-kind=\"审批\"')+btn(icon('copy')+' 抄送节点','add-node','','data-kind=\"抄送\"')+'<\/div>'+notice('当前展示顺序审核场景。条件、并行等复杂编排可继续沿用现有流程设计器能力。')+'<h3 style=\"margin-top:20px\">身份模式<\/h3><div style=\"margin-top:12px\">'+select('workflowIdentity',['实名填报','登录匿名','完全匿名'],FORM.identity)+'<\/div><p class=\"foot-note\">匿名模式不能按发起人部门找审核人，也不能退回或通知匿名发起人。<\/p><\/aside><div class=\"canvas-wrap\"><div class=\"flowline\"><div class=\"flow-node start\">提交表单<\/div>'+store.nodes.map(n=>'<div class=\"flow-connector\"><button data-action=\"add-node\" data-after=\"'+n.id+'\" data-kind=\"审批\" aria-label=\"添加审批节点\">+<\/button><\/div><button class=\"flow-node '+(n.id===store.nodeId?'selected':'')+'\" data-action=\"select-node\" data-id=\"'+n.id+'\"><div class=\"inline\">'+icon(n.kind==='审批'?'rubber-stamp':'copy')+'<strong>'+esc(n.title)+'<\/strong><\/div><p>'+esc(n.assigneeType)+' · '+esc(n.assignee||'未设置')+'<\/p><\/button>').join('')+'<div class=\"flow-connector\"><\/div><div class=\"flow-node end\">流程结束<\/div><\/div><\/div><aside class=\"properties\"><h2 style=\"margin-bottom:20px\">节点配置<\/h2>'+(node?'<div class=\"field\"><label for=\"nodeName\">节点名称<\/label><input id=\"nodeName\" value=\"'+esc(node.title)+'\"><\/div><div class=\"field\"><label>节点类型<\/label><span>'+node.kind+'<\/span><\/div><div class=\"field\"><label for=\"nodeAssigneeType\">处理人来源<\/label>'+select('nodeAssigneeType',['指定成员','发起人部门负责人','指定角色','表单字段'],node.assigneeType)+'<\/div><div class=\"field\"><label for=\"nodeAssignee\">处理人 / 角色<\/label><input id=\"nodeAssignee\" value=\"'+esc(node.assignee)+'\" placeholder=\"选择或输入处理人\"><\/div><div class=\"field\"><label>处理规则<\/label>'+select('nodeRule',['任一人通过','所有人通过'],node.rule||'任一人通过')+'<\/div><div class=\"field\"><label class=\"check-label\"><input type=\"checkbox\" id=\"nodeReturn\" '+(node.returnToStarter?'checked':'')+'>允许退回发起人修改<\/label><\/div><div class=\"inline\">'+btn('应用配置','apply-node')+btn('删除节点','delete-node','danger','data-id=\"'+node.id+'\"')+'<\/div>':notice('点击流程节点查看配置。'))+'<div class=\"help-source\"><strong>任务与版本<\/strong><p>填报任务和审批任务分别保留类型与业务记录，统一进入事务中心。正在运行的实例继续使用原流程版本。<\/p><\/div><div id=\"flowIssues\" class=\"error\"><\/div><\/aside><\/div><\/div>';$('workflowIdentity').addEventListener('change',e=>{FORM.identity=e.target.value;validateWorkflow();});}\nfunction applyNode(){const n=store.nodes.find(x=>x.id===store.nodeId);if(!n)return true;const title=$('nodeName').value.trim(),assignee=$('nodeAssignee').value.trim();if(!title||!assignee){toast('节点名称和处理人不能为空');return false;}Object.assign(n,{title,assignee,assigneeType:$('nodeAssigneeType').value,rule:$('nodeRule').value,returnToStarter:$('nodeReturn').checked});return true;}\nfunction flowIssues(){const errors=[];if(!store.nodes.some(n=>n.kind==='审批'))errors.push('至少配置一个审批节点');store.nodes.forEach(n=>{if(!n.assignee)errors.push(n.title+'未设置处理人');if(FORM.identity!=='实名填报'&&(n.assigneeType==='发起人部门负责人'||n.returnToStarter))errors.push(n.title+'依赖发起人身份，请改为实名或调整节点规则');});return errors;}\nfunction validateWorkflow(){const errors=flowIssues();if($('flowIssues'))$('flowIssues').textContent=errors.join('；');if(!errors.length)toast('流程校验通过');return !errors.length;}\nfunction handleConfiguration(action,el){if(action==='save-settings'){if(readSettings()){renderSettings();toast('填报设置已保存，历史任务保持原记录');}return true;}if(action==='identity'){FORM.identity=el.dataset.value;if(FORM.identity==='完全匿名'){FORM.scope='公开访问';FORM.cycle='单次';}else if(FORM.scope==='公开访问')FORM.scope='指定组织';renderSettings();return true;}if(action==='choose-audience'){chooseAudience();return true;}if(action==='save-permissions'){const invalid=store.permissionRows.find(p=>p.export&&!p.data&&!p.stats);if(invalid){toast(invalid.name+'需先拥有数据或统计权限，才能授权导出');return true;}FORM.permissionRows=structuredClone(store.permissionRows);addLog('授权变更','保存协作成员的数据与统计独立授权');$('permissionSaved').textContent='授权已保存在当前浏览器';toast('授权已保存');return true;}if(action==='member-scope'){memberScope(el.dataset.id);return true;}if(action==='add-member'){openModal('添加协作成员',field('成员姓名','<input id=\"memberName\" placeholder=\"请输入成员姓名\">')+'<div style=\"margin-top:16px\">'+field('所属部门',select('memberDept',DEPARTMENTS,'信息工程学院'))+'<\/div>','添加',()=>{const name=$('memberName').value.trim();if(!name)return modalError('请输入成员姓名。');if(store.permissionRows.some(p=>p.name===name))return modalError('该成员已在协作列表中。');store.permissionRows.push({id:'p'+Date.now(),name,dept:$('memberDept').value,design:false,publish:false,fill:true,audit:false,data:false,stats:false,export:false,scope:$('memberDept').value});closeModal();renderPermissions();toast('已添加成员，请配置权限并保存');});return true;}if(action==='add-component'){addComponent(el.dataset.type);return true;}if(['clone-component','delete-component','toggle-required','toggle-hidden'].includes(action)){const id=el.dataset.id;const f=store.fields.find(x=>x.id===id);if(!f)return true;if(action==='clone-component'){const copy={...structuredClone(f),id:'c'+Date.now(),label:f.label+'（副本）'};store.fields.splice(store.fields.indexOf(f)+1,0,copy);store.fieldId=copy.id;}if(action==='delete-component'){store.fields=store.fields.filter(x=>x.id!==id);store.fieldId=store.fields[0]?.id;}if(action==='toggle-required')f.required=!f.required;if(action==='toggle-hidden')f.hidden=!f.hidden;snapshotFields();renderDesign();return true;}if(action==='undo'||action==='redo'){restoreFields(action==='undo'?-1:1);return true;}if(action==='save-design'){saveDesign();return true;}if(action==='preview-design'){previewDesign();return true;}if(action==='select-node'){if(!applyNode())return true;store.nodeId=el.dataset.id;renderWorkflow();return true;}if(action==='add-node'){if(!applyNode())return true;const n={id:'n'+Date.now(),title:el.dataset.kind==='抄送'?'抄送通知':'新增审批',kind:el.dataset.kind,assigneeType:'指定成员',assignee:'',required:true};const index=el.dataset.after?store.nodes.findIndex(x=>x.id===el.dataset.after):store.nodes.length-1;store.nodes.splice(index+1,0,n);store.nodeId=n.id;renderWorkflow();return true;}if(action==='delete-node'){store.nodes=store.nodes.filter(n=>n.id!==el.dataset.id);store.nodeId=store.nodes[0]?.id;renderWorkflow();return true;}if(action==='apply-node'){if(applyNode()){renderWorkflow();validateWorkflow();}return true;}if(action==='validate-flow'||action==='save-flow'){if(!applyNode()||!validateWorkflow())return true;if(action==='save-flow'){if(FORM.published&&!FORM.draftVersion){FORM.publishedVersion=FORM.version;FORM.version++;FORM.draftVersion=FORM.version;}FORM.nodes=store.nodes;addLog('修改流程','保存流程草稿 v'+FORM.version);renderWorkflow();toast('流程草稿已保存，运行实例仍使用原版本');}return true;}return false;}\n\nfunction effectiveRole(){return ['statistics','department'].includes(qp.get('role'))&&store.role==='manager'?qp.get('role'):store.role;}\nfunction roleSelect(){return '<div class=\"inline\"><small>角色预览<\/small>'+select('dataRole',['manager','statistics','department'].map(x=>({manager:'表单管理员',statistics:'仅统计查看者',department:'部门数据管理员'})[x]),{manager:'表单管理员',statistics:'仅统计查看者',department:'部门数据管理员'}[effectiveRole()])+'<\/div>';}\nfunction bindRole(render){$('dataRole')?.addEventListener('change',e=>{store.role={'表单管理员':'manager','仅统计查看者':'statistics','部门数据管理员':'department'}[e.target.value];qp.delete('role');store.page=1;render();});}\nfunction scopedRecords(allForms=false){let records=RECORDS.filter(r=>allForms||r.fid===FORM.id);if(effectiveRole()==='department')records=records.filter(r=>r.dept==='信息工程学院');return records;}\nfunction maskedRecord(r){const f=formById(r.fid);const anon=f.identity!=='实名填报';return {...r,person:anon?'匿名提交':r.person,dept:anon?'不展示组织身份':r.dept};}\nfunction recordRows(records,allForms=false){return records.map(r=>{const m=maskedRecord(r);return row([tag(r.id,'gray'),...(allForms?[esc(formById(r.fid).name)]:[]),esc(m.person),esc(m.dept),esc(r.cycle),String(r.value),esc(r.submitted),stateTag(r.audit==='—'?'已提交':r.audit),'<span class=\"mono\">v'+r.version+'<\/span>',btn('查看','record-detail','small','data-id=\"'+r.id+'\"')]);});}\n\n\nfunction accessDenied(){return '<div class=\"access-denied\">'+icon('lock')+'<h2>当前角色没有数据明细查看权限<\/h2><p>已授予统计查看权限，可查看授权范围内的汇总结果。<\/p>'+link('statistics','前往统计分析',FORM,'btn',{role:'statistics'})+'<\/div>';}\nfunction renderRecords(){const role=effectiveRole();const records=scopedRecords().filter(r=>[r.id,maskedRecord(r).person,maskedRecord(r).dept].join(' ').includes(store.filter));const items=pageItems(records);$('content').innerHTML=head('填报数据','查看有效提交记录及对应版本。填报任务与响应记录分别管理。',roleSelect())+(role==='statistics'?accessDenied():(FORM.identity!=='实名填报'?notice('匿名模式：提交人和组织身份不展示；导出按相同规则隐藏。'):'')+'<div class=\"toolbar\"><div class=\"inline\">'+inputSearch('recordSearch','搜索编号、人员或单位',store.filter)+tag(role==='department'?'信息工程学院范围':'全部授权范围','gray')+'<\/div><div class=\"inline\">'+btn(icon('upload')+' 导入数据','import-records')+btn(icon('download')+' 导出当前结果','export-records')+'<\/div><\/div>'+table(['编号','提交人','所属单位','填报周期','设备数量','提交时间','审核状态','版本','操作'],recordRows(items))+pagination(records.length)+'<p class=\"foot-note\">历史记录使用提交时的表单版本；导入数据不自动补建历史授权、填报任务或审批实例。<\/p>');bindRole(renderRecords);keepSearch('recordSearch','filter',renderRecords);}\n\n\nfunction renderStatistics(){const role=effectiveRole(),anon=FORM.identity!=='实名填报';const {tasks,records}=statisticsData();const submissionExample=records.length===0&&statisticsCycle()===cycleKey(FORM);const submissionRecords=submissionExample?submissionExampleRecords():records;const done=tasks.filter(t=>['已提交','已完成'].includes(t.fill)).length;const total=tasks.length;const overdue=tasks.filter(t=>t.fill==='已逾期').length;const tabs=['收集汇总','填报进度','人员统计','流程统计','字段分析'];const tab=anon&&store.stat==='人员统计'?'收集汇总':store.stat;let body='';if(tab==='收集汇总'||tab==='字段分析'){const bars=tab==='字段分析'?[['0–10 台',records.filter(r=>r.value<=10).length],['11–20 台',records.filter(r=>r.value>10&&r.value<=20).length],['20 台以上',records.filter(r=>r.value>20).length]]:FORM.type==='流程表单'?[['本期提交',submissionRecords.length],['已通过',submissionRecords.filter(r=>r.audit==='已通过').length],['待审核',submissionRecords.filter(r=>r.audit==='待审核').length],['已驳回',submissionRecords.filter(r=>r.audit==='已驳回').length]]:[['本期提交',submissionRecords.length],['有效提交',submissionRecords.length],['无需审核',submissionRecords.filter(r=>r.audit==='—').length],['修改过的提交',submissionRecords.filter(r=>(r.revision||1)>1).length]];body='<div class=\"grid-2\">'+panel(tab==='字段分析'?'设备数量分布':'提交情况',(tab==='收集汇总'&&submissionExample?notice('当前表单本期暂无正式提交，以下展示提交情况示例。示例不计入任务、记录和正式导出。','','示例数据'):'')+bars.map(([name,n])=>'<div class=\"chart-bar\"><span class=\"name\">'+name+'<\/span><div class=\"bar\"><span style=\"width:'+((tab==='字段分析'?records:submissionRecords).length?n/(tab==='字段分析'?records:submissionRecords).length*100:0)+'%\"><\/span><\/div><span class=\"amount\">'+n+' 条<\/span><\/div>').join('')+(tab==='收集汇总'?submissionSummary(submissionRecords):''))+panel('统计范围','<dl class=\"description\"><dt>权限范围<\/dt><dd>'+esc(role==='department'?'信息工程学院':'全部授权范围')+'<\/dd><dt>统计对象<\/dt><dd>'+esc(FORM.name)+'<\/dd><dt>周期<\/dt><dd>'+esc(FORM.cycle)+'<\/dd><dt>身份策略<\/dt><dd>'+esc(FORM.identity)+'<\/dd><dt>明细权限<\/dt><dd>'+esc(role==='statistics'?'未授权':'已授权')+'<\/dd><\/dl>')+'<\/div>';}if(tab==='填报进度'){body=anon?notice('匿名模式仅展示响应汇总；不展示可识别个人的完成率、人员进度或未填报名单。','warning'):table(['范围','应填','已提交','未提交','逾期','完成率','操作'],[row(['当前范围',total,done,total-done,overdue,(total?Math.round(done/total*100):0)+'%',role==='statistics'?'<span class=\"muted\">仅汇总<\/span>':link('fill','查看我的任务')])]);}if(tab==='人员统计'){body=table(['人员','所属单位','周期','填报状态','提交时间','操作'],tasks.map(t=>row([esc(t.person),esc(t.dept),esc(t.cycle),stateTag(t.fill),t.submitted,role==='statistics'?'<span class=\"muted\">仅进度<\/span>':btn('任务信息','task-info','small','data-id=\"'+t.id+'\"')])));}if(tab==='流程统计'){body=FORM.type==='流程表单'?table(['审核节点','流程版本','待审核','已通过','已驳回','操作'],[row(['部门审核','v3',tasks.filter(t=>t.audit==='待审核').length,tasks.filter(t=>t.audit==='已通过').length,tasks.filter(t=>t.audit==='已驳回').length,role==='statistics'?'<span class=\"muted\">仅汇总<\/span>':link('audit','进入审核')])]):empty('普通表单无需流程审核','本表单没有流程节点统计。');}\n $('content').innerHTML=head('统计分析','先按统计权限过滤范围，再进行汇总。',roleSelect())+(anon?notice('当前为'+FORM.identity+'：隐藏人员与组织身份，不开放人员统计、未填报名单及实名导出。','warning'):'')+(role==='statistics'?notice('当前预览“仅统计查看者”：允许查看汇总，不授予数据明细权限。'):'')+'<div class=\"count-grid\">'+metric('有效响应',records.length,'当前授权范围')+metric(anon?'匿名响应':'应填任务',anon?records.length:total,anon?'身份不参与统计':'对象 × 填报周期')+metric(anon?'本期提交量':'完成率',anon?records.length:(total?Math.round(done/total*100):0)+'%',anon?'按响应记录计数':done+' 项已提交')+metric('待审核',tasks.filter(t=>t.audit==='待审核').length,'与填报任务分开记录')+'<\/div><div class=\"toolbar\"><div class=\"inline\">'+select('statDept',anon?['全部']:role==='department'?['信息工程学院']:['全部',...DEPARTMENTS],anon?'全部':role==='department'?'信息工程学院':store.statDept,'aria-label=\"统计组织范围\"')+tag((statisticsCycle()===cycleKey(FORM)?'当前周期 · ':'历史周期 · ')+statisticsCycle(),'gray')+'<\/div>'+btn(icon('download')+' 导出汇总','export-statistics')+'<\/div><div class=\"tabs\">'+tabs.map(t=>'<button class=\"tab '+(t===tab?'active':'')+'\" data-action=\"stat-tab\" data-value=\"'+t+'\" '+(anon&&t==='人员统计'?'disabled title=\"匿名模式不提供人员维度\"':'')+'>'+t+'<\/button>').join('')+'<\/div>'+body;bindRole(renderStatistics);$('statDept').addEventListener('change',e=>{store.statDept=e.target.value;renderStatistics();});}\nfunction publishErrors(){const errors=[];if(!FORM.name.trim())errors.push('表单名称不能为空');if(!FORM.start||!FORM.end||FORM.end<=FORM.start)errors.push('截止时间必须晚于开始时间');if(FORM.identity!=='完全匿名'&&!FORM.audience.length)errors.push('请设置发布对象');if(FORM.type==='流程表单')errors.push(...flowIssues());return errors;}\nfunction seedDemonstrationData(){\n let changed=false;\n for(const fid of ['f1','f2']){\n  const f=formById(fid);\n  if(!f||!f.published||f.deleted||f.identity==='完全匿名')continue;\n  const flow=f.type==='流程表单';\n  const people=[['陈佳','信息工程学院',8],['周宁','理学院',12],['许欣','信息工程学院',6]];\n  people.forEach(([person,dept,value],i)=>{\n   const id=fid+'-sample-202610-'+i;\n   let task=TASKS.find(t=>t.id===id);\n   if(!task){\n    const audit=flow?['已通过','待审核','已驳回'][i]:'—';\n    task={id,fid,person,dept,fill:flow?['已完成','已提交','已驳回'][i]:'已完成',audit,cycle:cycleKey(f),start:f.start.replace('T',' '),due:f.end.replace('T',' '),submitted:['2026-10-24 10:20','2026-10-26 14:35','2026-10-28 09:15'][i],version:f.publishedVersion||f.version,node:flow?'部门审核':'—',following:false,equipment:['教学一体机','实验室工作站','电子显微镜'][i],running:'正常运行',value,remark:'示例记录：设备运行情况已核对。',sample:true};\n    TASKS.push(task);changed=true;\n   }\n   if(!RECORDS.some(r=>r.tid===id)&&['已提交','已完成','已驳回'].includes(task.fill)){\n    const record={id:'SAMPLE-'+id,tid:id,fid,person:f.identity==='实名填报'?task.person:'匿名提交',dept:f.identity==='实名填报'?task.dept:'不展示组织身份',cycle:task.cycle,submitted:task.submitted,audit:task.audit,version:task.version,node:task.node,equipment:task.equipment,running:task.running,value:task.value,remark:task.remark,revision:1,history:[],sample:true};\n    if(!flow&&i===1){record.history=[{...record,value:10,submitted:'2026-10-25 09:00',history:[]}];record.revision=2;}\n    RECORDS.push(record);changed=true;\n   }\n  });\n }\n if(changed)FormLinkState.update(state=>{state.tasks=TASKS;state.records=RECORDS;});\n}\n\nfunction releaseHistory(){\n if(!Array.isArray(FORM.releases)){\n  const version=FORM.publishedVersion||FORM.version;\n  FORM.releases=FORM.published?Array.from({length:Math.min(3,version)},(_,i)=>({id:FORM.id+'-release-v'+(version-i),version:version-i,time:['2026-10-21 10:15','2026-09-21 09:00','2026-08-20 14:30'][i],actor:i===1?'李静':'高源',note:['调整本期填报范围，完善设备状态和附件说明。','更新上期字段说明，保留历史提交及审核记录。','首次发布表单，开放指定组织填写。'][i],scope:FORM.identity==='完全匿名'?'公开访问':FORM.audience.join('、'),sample:true})):[];\n }\n return FORM.releases;\n}\n\nfunction statisticsCycle(){return qp.get('cycle')||cycleKey(FORM);}\nfunction statisticsData(){\n const cycle=statisticsCycle(),role=effectiveRole(),anon=FORM.identity!=='实名填报';\n let tasks=currentTasks().filter(t=>t.cycle===cycle),records=currentRecords().filter(r=>r.cycle===cycle&&!r.withdrawn);\n if(role==='department'){tasks=tasks.filter(t=>t.dept==='信息工程学院');records=records.filter(r=>(TASKS.find(t=>t.id===r.tid)?.dept||r.dept)==='信息工程学院');}\n if(store.statDept!=='全部'&&!anon){tasks=tasks.filter(t=>t.dept===store.statDept);records=records.filter(r=>r.dept===store.statDept);}\n return {tasks,records};\n}\n\nfunction submissionSummary(records){\n const dates=[...new Set(records.map(r=>r.submitted.slice(0,10)))].sort().slice(-4);\n const rows=dates.map(date=>{const group=records.filter(r=>r.submitted.startsWith(date));return row([esc(date),group.length+' 条',group.reduce((sum,r)=>sum+Number(r.value||0),0)+' 台']);});\n return '<div class=\"submission-summary\"><div class=\"summary-caption\">'+tag(statisticsCycle(),'gray')+'<span class=\"muted\">按当前授权范围汇总<\/span><\/div>'+table(['提交日期','提交数量','设备数量合计'],rows)+'<\/div>';\n}\n\nfunction demonstrationReleases(){\n return [3,2,1].map((version,i)=>({id:FORM.id+'-illustrative-v'+version,version,time:['2026-10-26 10:15','2026-10-20 09:00','2026-10-12 14:30'][i],actor:['高源','李静','高源'][i],note:['示例：更新填报范围与字段说明。','示例：完善审核说明并保留历史响应。','示例：首次发布并开放指定范围填写。'][i],scope:FORM.identity==='完全匿名'?'公开访问':FORM.audience.join('、'),sample:true,illustration:true}));\n}\nfunction displayedReleaseHistory(){const records=releaseHistory();return records.length?records:demonstrationReleases();}\nfunction submissionExampleRecords(){\n const dates=FORM.cycle==='日报'?['2026-10-23 09:15','2026-10-23 10:20','2026-10-23 15:30']:FORM.cycle==='周报'?['2026-10-19 09:15','2026-10-21 10:20','2026-10-23 15:30']:['2026-10-24 09:15','2026-10-26 10:20','2026-10-28 15:30'];\n return dates.map((submitted,i)=>({submitted,value:[8,12,6][i],audit:FORM.type==='流程表单'?['已通过','待审核','已驳回'][i]:'—',revision:i===1?2:1}));\n}\nfunction renderPublish(){\n const running=FORM.status==='收集中',previewOptions={preview:'1',...(!FORM.published?{demo:'1'}:{})},preview=href('fill',FORM,previewOptions),history=displayedReleaseHistory(),illustrativeHistory=history.every(r=>r.illustration===true);\n const collection=(!FORM.published?notice('当前表单尚未发布，以下为收集入口样例。可填写预览，不会开启正式收集。','','示例入口'):'')+'<div class=\"collection-example\"><div class=\"collection-example-head\"><div class=\"row-name\">'+typeIcon(FORM)+'<div><strong>'+esc(FORM.name)+'<\/strong><small>'+esc(cycleKey(FORM))+' · '+esc(FORM.identity)+' · 原型示例入口<\/small><\/div><\/div>'+stateTag(FORM.status)+'<\/div><div class=\"field-grid\">'+field('示例填写链接','<div class=\"inline\"><input id=\"collectionLink\" aria-label=\"示例填写链接\" readonly value=\"'+esc(parent.Prototype.url(preview))+'\">'+btn(icon('copy')+' 复制链接','copy-link')+'<\/div>','用于原型演示；预览提交不生成正式任务或提交记录。',true)+field('填写预览',link('fill','打开填写预览 '+icon('external-link'),FORM,'btn primary',previewOptions))+field('我的填报',!FORM.published?'<span class=\"muted\">发布后生成正式填报任务<\/span>':FORM.identity==='完全匿名'?'<span class=\"muted\">完全匿名模式不建立个人任务<\/span>':link('fill','查看当前表单的任务 '+icon('arrow-up-right'),FORM,'btn',{form:FORM.id}))+field('运行状态',FORM.published?'<div class=\"inline\">'+stateTag(FORM.status)+(running?btn('暂停收集','pause-form'):FORM.status==='已暂停'?btn('恢复收集','resume-form'):'')+(!['已结束','已归档'].includes(FORM.status)?btn('结束收集','end-form','danger'):'')+'<\/div>':'<div class=\"inline\">'+stateTag(FORM.status)+tag('未开启正式收集','gray')+'<\/div>',FORM.published?'暂停或结束后，已有提交和历史版本仍保留。':'示例预览不会改变当前发布状态。',true)+'<\/div><\/div>';\n const historyBody=(illustrativeHistory?notice(FORM.published?'当前还没有发布历史，以下为发布记录样例。':'以下为发布记录样例，不表示当前表单已经发布。','','示例发布记录'):'')+table(['版本','发布时间','发布人','变更说明','操作'],history.map(release=>row(['<span class=\"release-version\">v'+release.version+'<\/span> '+tag(release.sample?'示例':'本次发布','gray'),esc(release.time),esc(release.actor),'<span class=\"release-note\">'+esc(release.note)+'<\/span>',btn('查看说明','version-note','small','data-release=\"'+esc(release.id)+'\"')])));\n $('content').innerHTML=head('发布管理','管理当前收集状态、版本和访问入口。',link('publish-config',icon('send')+' '+(FORM.published?'发布新版本':'发布表单'),FORM,'btn primary'))+'<div class=\"tag-row\" style=\"margin-bottom:18px\">'+stateTag(FORM.status)+tag('设计版本 v'+FORM.version,'gray')+tag('运行版本 '+(FORM.published?'v'+(FORM.publishedVersion||FORM.version):'尚未发布'),'gray')+'<\/div>'+panel('收集入口',collection)+panel('发布记录<span id=\"releaseHistoryAnchor\" aria-hidden=\"true\"><\/span>',historyBody,'<span class=\"muted\">共 '+history.length+' 条'+(illustrativeHistory?'示例':'发布')+'记录<\/span>')+notice('周期任务依据填报对象和周期独立生成。重新发布不重复生成同一对象、同一周期的任务；已提交数据保留提交时的表单版本。');\n if(qp.get('section')==='history')$('releaseHistoryAnchor').closest('.panel').scrollIntoView({block:'start'});\n}\nfunction renderPublicationSettings(){\n $('content').innerHTML=head('表单发布','确认发布范围、收集时间和本次版本说明。',btn(icon('send')+' '+(FORM.published?'发布新版本':'发布表单'),'publish-form','primary'))+panel('发布配置','<div class=\"field-grid\">'+field('发布对象','<span>'+esc(FORM.identity==='完全匿名'?'公开访问':FORM.audience.join('、'))+'<\/span>',link('settings','前往填报设置调整范围'))+field('身份模式',identityTag())+field('开始时间','<input type=\"datetime-local\" id=\"publishStart\" value=\"'+FORM.start+'\">')+field('截止时间','<input type=\"datetime-local\" id=\"publishEnd\" value=\"'+FORM.end+'\">')+field('发布说明','<textarea id=\"publishNote\" placeholder=\"填写本次版本变更说明\">'+esc(FORM.releaseNote||'完善本期填报内容与范围。')+'<\/textarea>','修改字段或流程时使用新发布版本，历史响应保留原版本。',true)+'<\/div>')+notice('发布后开始使用当前设计版本。已有任务及响应保留原周期、版本与处理记录。');\n}\n\nfunction publishForm(){FORM.start=$('publishStart').value;FORM.end=$('publishEnd').value;FORM.releaseNote=$('publishNote').value.trim();const errors=publishErrors();if(errors.length){openModal('发布校验未通过',notice(errors.map(x=>esc(x)).join('<br>'),'danger'));return;}openModal('确认发布', '<dl class=\"description\"><dt>表单<\/dt><dd>'+esc(FORM.name)+'<\/dd><dt>设计版本<\/dt><dd>v'+FORM.version+'<\/dd><dt>身份模式<\/dt><dd>'+esc(FORM.identity)+'<\/dd><dt>发布范围<\/dt><dd>'+esc(FORM.identity==='完全匿名'?'公开访问':FORM.audience.join('、'))+'<\/dd><dt>截止时间<\/dt><dd>'+FORM.end.replace('T',' ')+'<\/dd><\/dl><div style=\"margin-top:18px\">'+notice('发布后开始使用当前设计版本。已有任务及响应保留原周期、版本与处理记录。')+'<\/div>','确认发布',()=>{const releases=releaseHistory();FORM.status='收集中';FORM.published=true;FORM.publishedVersion=FORM.version;FORM.draftVersion=null;const time=new Date();const stamp=[time.getFullYear(),String(time.getMonth()+1).padStart(2,'0'),String(time.getDate()).padStart(2,'0')].join('-')+' '+String(time.getHours()).padStart(2,'0')+':'+String(time.getMinutes()).padStart(2,'0');releases.unshift({id:FORM.id+'-release-'+Date.now(),version:FORM.version,time:stamp,actor:'高源',note:FORM.releaseNote||'发布当前版本，更新填报内容和收集规则。',scope:FORM.identity==='完全匿名'?'公开访问':FORM.audience.join('、'),sample:false});let generated=0;if(FORM.identity!=='完全匿名'){FORM.audience.forEach((dept,i)=>{const existing=TASKS.some(t=>t.fid===FORM.id&&t.person===PEOPLE[i%PEOPLE.length]&&t.dept===dept&&t.cycle===cycleKey(FORM));if(!existing){TASKS.push({id:FORM.id+'-generated-'+i,fid:FORM.id,person:PEOPLE[i%PEOPLE.length],dept,fill:'未填报',audit:'—',cycle:cycleKey(FORM),start:FORM.start.replace('T',' '),due:FORM.end.replace('T',' '),submitted:'—',version:FORM.version,node:'部门审核',following:false,value:0});generated++;}});}addLog('发布','发布 v'+FORM.version+'，新增任务 '+generated+' 项');closeModal();renderPage('publish-config');toast('已发布 v'+FORM.version+'，当前页面新增 '+generated+' 个任务');});}\nfunction renderLogs(){const logs=LOGS.filter(l=>(store.logAction==='全部'||l.action===store.logAction)&&(store.logResult==='全部'||l.result===store.logResult)&&[l.actor,l.detail].join(' ').includes(store.logKeyword));$('content').innerHTML=head('操作日志','查看设计、发布、授权、任务和数据操作记录。',btn(icon('download')+' 导出日志','export-logs'))+'<div class=\"toolbar\"><div class=\"inline\">'+inputSearch('logSearch','搜索操作人或内容',store.logKeyword)+select('logAction',['全部',...new Set(LOGS.map(l=>l.action))],store.logAction,'aria-label=\"操作类型筛选\"')+select('logResult',['全部','成功','失败'],store.logResult,'aria-label=\"操作结果筛选\"')+'<\/div><small>当前表单 · 最近操作<\/small><\/div>'+table(['操作时间','操作人','操作类型','内容','关联版本','结果','操作'],pageItems(logs).map(l=>row([l.time,esc(l.actor),esc(l.action),'<span style=\"white-space:normal;display:block;max-width:400px\">'+esc(l.detail)+'<\/span>',esc(l.version),stateTag(l.result),btn('详情','log-detail','small','data-id=\"'+l.id+'\"')])))+pagination(logs.length);keepSearch('logSearch','logKeyword',renderLogs);bindFilter('logAction','logAction');bindFilter('logResult','logResult');}\nfunction handleData(action,el){if(action==='record-detail'){recordDetail(el.dataset.id);return true;}if(action==='export-records'){exportRecords(store.active==='view');return true;}if(action==='import-records'){openModal('导入历史数据',notice('仅导入数据，不迁移旧授权、任务、统计配置及审批记录。请先核对字段映射。','warning')+field('JSON 数据文件','<input type=\"file\" id=\"recordImport\" accept=\".json\">','数组项包含 person、dept、quantity、remark。匿名表单将移除 person、dept。')+'<dl class=\"description\" style=\"margin-top:18px\"><dt>quantity<\/dt><dd>→ 设备数量（必填数字）<\/dd><dt>remark<\/dt><dd>→ 情况说明<\/dd><\/dl>','校验并导入',async()=>{const file=$('recordImport').files[0];if(!file)return modalError('请选择数据文件。');try{const rows=JSON.parse(await file.text());if(!Array.isArray(rows)||!rows.length||rows.length>500)return modalError('请输入包含 1 至 500 项的数组。');const bad=rows.findIndex(r=>!r||r.quantity===null||r.quantity===undefined||r.quantity===''||!Number.isFinite(Number(r.quantity))||Number(r.quantity)<0);if(bad!==-1)return modalError('第 '+(bad+1)+' 行设备数量无效。');rows.forEach((r,i)=>RECORDS.push({id:'IMP'+Date.now()+i,fid:FORM.id,person:FORM.identity==='实名填报'?String(r.person||'导入记录'):'匿名提交',dept:FORM.identity==='实名填报'?String(r.dept||'信息工程学院'):'不展示组织身份',cycle:'历史导入',value:Number(r.quantity),remark:String(r.remark||''),submitted:'2026-10-23 10:30',audit:'—',version:FORM.version,node:'—'}));addLog('数据导入','导入历史数据 '+rows.length+' 条');closeModal();renderRecords();toast('已导入 '+rows.length+' 条记录');}catch{modalError('文件内容不是有效 JSON。');}});return true;}if(action==='stat-tab'){store.stat=el.dataset.value;renderStatistics();return true;}if(action==='export-statistics'){const {tasks,records}=statisticsData();const anon=FORM.identity!=='实名填报';csvDownload('统计汇总_'+FORM.name,['指标','数量'],[['有效响应',records.length],...(!anon?[['应填任务',tasks.length],['已提交任务',tasks.filter(t=>['已提交','已完成'].includes(t.fill)).length],['逾期任务',tasks.filter(t=>t.fill==='已逾期').length]]:[]),['待审核',tasks.filter(t=>t.audit==='待审核').length]]);return true;}if(action==='publish-form'){publishForm();return true;}if(action==='pause-form'||action==='resume-form'||action==='end-form'){const status=action==='pause-form'?'已暂停':action==='resume-form'?'收集中':'已结束';openModal(action==='end-form'?'结束收集':'调整收集状态',notice(action==='end-form'?'结束后不再接受提交，已有数据和任务记录保留。':'调整状态不改变历史数据及任务的原始周期。','warning'),'确认',()=>{FORM.status=status;addLog('发布状态','收集状态调整为'+status);closeModal();renderPublish();toast('当前状态：'+status);});return true;}if(action==='copy-link'){navigator.clipboard.writeText($('collectionLink').value).then(()=>toast('原型预览链接已复制')).catch(()=>{const input=$('collectionLink');input.select();toast('请选择并复制链接文本');});return true;}if(action==='version-note'){const release=displayedReleaseHistory().find(r=>r.id===el.dataset.release);if(!release)return true;openModal('发布版本 v'+release.version+' · 说明',notice('历史响应继续关联提交时的发布版本，当前设计草稿不覆盖历史版本。')+'<dl class=\"description\"><dt>版本<\/dt><dd>v'+release.version+'<\/dd><dt>发布时间<\/dt><dd>'+esc(release.time)+'<\/dd><dt>发布人<\/dt><dd>'+esc(release.actor)+'<\/dd><dt>发布范围<\/dt><dd>'+esc(release.scope)+'<\/dd><dt>变更内容<\/dt><dd>'+esc(release.note)+'<\/dd><\/dl>');return true;}if(action==='log-detail'){const l=LOGS.find(x=>String(x.id)===el.dataset.id);openModal('操作日志详情','<dl class=\"description\">'+[['操作时间',l.time],['操作人',l.actor],['操作类型',l.action],['操作内容',l.detail],['结果',l.result],['版本',l.version]].map(x=>'<dt>'+x[0]+'<\/dt><dd>'+esc(x[1])+'<\/dd>').join('')+'<\/dl>');return true;}if(action==='export-logs'){const logs=LOGS.filter(l=>(store.logAction==='全部'||l.action===store.logAction)&&(store.logResult==='全部'||l.result===store.logResult)&&[l.actor,l.detail].join(' ').includes(store.logKeyword));csvDownload('表单操作日志',['时间','操作人','类型','内容','结果','版本'],logs.map(l=>[l.time,l.actor,l.action,l.detail,l.result,l.version]));return true;}return false;}\n\nfunction fillAction(t){if(canFill(t))return btn(t.fill==='填报中'?'继续填写':'填报','open-task','small','data-id=\"'+t.id+'\"');return btn('查看','open-task','small','data-id=\"'+t.id+'\"');}\nfunction taskRows(tasks){return tasks.map(t=>{const f=formById(t.fid);return row(['<button class=\"favorite '+(t.following?'on':'')+'\" data-action=\"follow-task\" data-id=\"'+t.id+'\" aria-label=\"'+(t.following?'取消关注':'关注')+esc(f.name)+'\">'+icon('heart')+'<\/button>','<div class=\"row-name\">'+typeIcon(f)+'<div class=\"name-cell\"><strong>'+esc(f.name)+'<\/strong><small>'+esc(f.category)+'<\/small><\/div><\/div>',esc(t.cycle),t.start.replace(' ','<br>'),t.due.replace(' ','<br>'),t.submitted.replace(' ','<br>'),stateTag(t.fill),t.audit==='—'?'<span class=\"muted\">无需审核<\/span>':stateTag(t.audit),fillAction(t)]);});}\nfunction renderFill(){const all=mineTasks();const filtered=all.filter(t=>(store.category==='全部'||formById(t.fid).category===store.category)&&formById(t.fid).name.includes(store.filter)&&(store.taskStatus==='全部'||t.fill===store.taskStatus));$('content').innerHTML=head('我的填报','我的文档中的填报任务，按周期查看和提交。',tag('当前填报人 · 高源','gray'))+'<nav class=\"tabs personal-tabs\" aria-label=\"我的文档功能\"><a class=\"tab\" href=\"文档中心-我的文档.html\">文档列表<\/a><span class=\"tab active\" aria-current=\"page\">我的填报<\/span><\/nav>'+'<div class=\"list-layout\">'+categories(all)+'<div><div class=\"toolbar\"><div class=\"inline\">'+inputSearch('taskSearch','按表单名称搜索',store.filter)+select('taskStatus',['全部','未填报','填报中','已提交','已完成','已逾期','已驳回'],store.taskStatus,'aria-label=\"填报状态筛选\"')+'<\/div><small>独立任务 · 保留周期与截止时间<\/small><\/div>'+table(['关注','名称','填报周期','开始时间','截止时间','提交时间','填报状态','审核状态','操作'],taskRows(pageItems(filtered)))+pagination(filtered.length)+'<\/div><\/div>';keepSearch('taskSearch','filter',renderFill);keepSearch('categorySearch','categorySearch',renderFill);bindFilter('taskStatus','taskStatus');if(qp.get('preview')==='1'&&!store.previewOpened){store.previewOpened=true;openPublicPreview();}}\nfunction openPublicPreview(){const task={id:'preview-task',fid:FORM.id,person:'高源',dept:'信息工程学院',fill:'未填报',audit:'—',cycle:FORM.cycle==='单次'?'本次收集':'2026年10月',start:FORM.start.replace('T',' '),due:FORM.end.replace('T',' '),submitted:'—',version:FORM.version,node:'部门审核',value:0,preview:true};openFillDialog(task,true);}\nfunction openTask(id){const t=TASKS.find(x=>x.id===id);if(!t)return;if(t.person!=='高源'&&store.active!=='statistics'){toast('此任务不属于当前填报人');return;}openFillDialog(t,false);}\nfunction taskDetailBody(t,f){return '<dl class=\"description\"><dt>填报周期<\/dt><dd>'+esc(t.cycle)+'<\/dd><dt>截止时间<\/dt><dd>'+esc(t.due)+'<\/dd><dt>填报状态<\/dt><dd>'+stateTag(t.fill)+'<\/dd><dt>审核状态<\/dt><dd>'+stateTag(t.audit==='—'?'无需审核':t.audit)+'<\/dd><dt>设备数量<\/dt><dd>'+t.value+' 台<\/dd><dt>情况说明<\/dt><dd>'+esc(t.remark||'设备运行正常。')+'<\/dd><dt>表单版本<\/dt><dd>v'+t.version+'<\/dd><\/dl>';}\nfunction openFillDialog(t,preview=false){const f=formById(t.fid);const editable=preview?f.status==='收集中':canFill(t);if(!editable){const reason=f.status!=='收集中'?'表单当前'+f.status+'，不可提交。':t.fill==='已逾期'?'该任务已逾期，当前策略禁止补填。':'已提交任务仅查看记录。';openModal(esc(f.name),notice(reason,t.fill==='已逾期'?'warning':'')+taskDetailBody(t,f));return;}\n const body=(preview?notice('填写预览：用于演示发布后的访问和提交，不写入正式系统。'):'')+(f.identity!=='实名填报'?notice(f.identity==='登录匿名'?'已登录并校验访问资格。提交结果对数据和统计查看者隐藏人员身份。':'此表单为匿名收集，不保存提交人身份。'):'<div class=\"tag-row\" style=\"margin-bottom:18px\">'+tag(t.cycle,'gray')+tag('截止 '+t.due,'orange')+'<\/div>')+'<div class=\"field-grid\">'+field('所属单位<span class=\"required\">*<\/span>',select('fillDepartment',DEPARTMENTS,t.dept||'信息工程学院'))+field('设备名称<span class=\"required\">*<\/span>','<input id=\"fillEquipment\" maxlength=\"60\" value=\"'+esc(t.equipment||'')+'\" placeholder=\"请输入设备名称\">')+field('设备数量<span class=\"required\">*<\/span>','<input id=\"fillQuantity\" type=\"number\" min=\"0\" max=\"999999\" value=\"'+(t.fill==='填报中'?t.value:'')+'\" placeholder=\"请输入数量\">')+field('运行状态',select('fillRunning',['正常运行','待维修','已停用'],t.running||'正常运行'))+field('情况说明','<textarea id=\"fillRemark\" maxlength=\"500\" placeholder=\"补充设备运行情况\">'+esc(t.remark||'')+'<\/textarea>','最多 500 个字',true)+'<\/div><div class=\"inline\" style=\"margin-top:16px\">'+btn('保存草稿','save-task-draft','','data-id=\"'+t.id+'\"')+'<small>草稿不计入有效提交次数。<\/small><\/div>';\n store.openTask=t;openModal(esc(f.name),body,'提交填报',()=>submitTask(t));}\nfunction taskValues(){return {dept:$('fillDepartment').value,equipment:$('fillEquipment').value.trim(),value:Number($('fillQuantity').value),running:$('fillRunning').value,remark:$('fillRemark').value.trim()};}\nfunction submitTask(t){const v=taskValues();if(!v.equipment)return modalError('请输入设备名称。');if(!$('fillQuantity').value||!Number.isInteger(v.value)||v.value<0||v.value>999999)return modalError('设备数量须为 0 至 999999 的整数。');const f=formById(t.fid);Object.assign(t,v,{fill:f.type==='流程表单'?'已提交':'已完成',audit:f.type==='流程表单'?'待审核':'—',submitted:'2026-10-23 10:30'});if(!t.preview){const old=RECORDS.find(r=>r.tid===t.id);const data={id:old?.id||'R'+Date.now(),tid:t.id,fid:t.fid,person:f.identity==='实名填报'?t.person:'匿名提交',dept:f.identity==='实名填报'?t.dept:'不展示组织身份',cycle:t.cycle,value:t.value,remark:t.remark,submitted:t.submitted,audit:t.audit,version:t.version,node:t.node};if(old)Object.assign(old,data);else RECORDS.push(data);}closeModal();renderPage(store.active);toast(t.preview?'预览提交成功':f.type==='流程表单'?'已提交，等待审核':'填报已完成');}\nfunction reviewTasks(){return TASKS.filter(t=>formById(t.fid).type==='流程表单'&&t.audit!=='—').filter(t=>formById(t.fid).name.includes(store.filter)&&(store.auditStatus==='全部'||t.audit===store.auditStatus));}\nfunction renderAudit(){const tasks=reviewTasks();$('content').innerHTML=head('我的审核','展示当前处理人有权办理的审批任务。填报与审批分别记录状态。',tag('当前审核人 · 高源','gray'))+'<div class=\"toolbar\"><div class=\"inline\">'+inputSearch('auditSearch','按表单名称搜索',store.filter)+select('auditStatus',['待审核','已通过','已驳回','全部'],store.auditStatus,'aria-label=\"审核状态筛选\"')+'<\/div><small>同一条记录保留流程版本与当前审核节点<\/small><\/div>'+table(['表单名称','提交人','所属单位','填报周期','当前节点','流程版本','审核状态','操作'],pageItems(tasks).map(t=>{const f=formById(t.fid);return row(['<div class=\"row-name\">'+typeIcon(f)+'<strong>'+esc(f.name)+'<\/strong><\/div>',esc(f.identity==='实名填报'?t.person:'匿名提交'),esc(f.identity==='实名填报'?t.dept:'不展示组织身份'),esc(t.cycle),esc(t.node),'v'+t.version,stateTag(t.audit),btn(t.audit==='待审核'?'去审核':'查看记录','review-task','small','data-id=\"'+t.id+'\"')]);}))+pagination(tasks.length);keepSearch('auditSearch','filter',renderAudit);bindFilter('auditStatus','auditStatus');if(qp.get('review')&&!store.reviewOpened){store.reviewOpened=true;const t=TASKS.find(t=>t.id===qp.get('review'));if(t)reviewTask(t.id);}}\nfunction reviewTask(id){const t=TASKS.find(t=>t.id===id);if(!t||formById(t.fid).type!=='流程表单')return;const f=formById(t.fid),record=RECORDS.find(r=>r.tid===t.id);store.reviewTask=t;const body='<div class=\"tag-row\" style=\"margin-bottom:18px\">'+tag(t.node,'purple')+tag('流程版本 v'+t.version,'gray')+stateTag(t.audit)+'<\/div><dl class=\"description\"><dt>提交人<\/dt><dd>'+esc(f.identity==='实名填报'?t.person:'匿名提交')+'<\/dd><dt>所属单位<\/dt><dd>'+esc(f.identity==='实名填报'?t.dept:'不展示组织身份')+'<\/dd><dt>设备数量<\/dt><dd>'+t.value+' 台<\/dd><dt>情况说明<\/dt><dd>'+esc(record?.remark||'设备采购申请，附件与数量已核对。')+'<\/dd><\/dl>'+(t.audit==='待审核'?'<div style=\"margin-top:22px\">'+field('处理结果','<div class=\"radio-row\"><label><input type=\"radio\" name=\"reviewDecision\" value=\"通过\" checked>通过<\/label><label><input type=\"radio\" name=\"reviewDecision\" value=\"驳回\">驳回<\/label><\/div>')+'<\/div><div style=\"margin-top:16px\">'+field('审核意见','<textarea id=\"reviewOpinion\" maxlength=\"300\" placeholder=\"驳回时必填，请说明修改要求\"><\/textarea>')+'<\/div>':'<div style=\"margin-top:20px\">'+notice('处理结果：'+esc(t.audit)+'；意见：'+esc(t.reviewOpinion||'已核对并确认。'))+'<\/div>');openModal(esc(f.name)+' · 审核',body,t.audit==='待审核'?'确认处理':'',t.audit==='待审核'?()=>{const decision=document.querySelector('input[name=reviewDecision]:checked').value;const opinion=$('reviewOpinion').value.trim();if(decision==='驳回'&&!opinion)return modalError('请输入驳回原因。');t.audit=decision==='通过'?'已通过':'已驳回';t.fill=decision==='通过'?'已完成':'已驳回';t.reviewOpinion=opinion||'同意';if(record)record.audit=t.audit;closeModal();renderAudit();toast('审核已'+decision);}:null,720);}\nfunction renderView(){const role=effectiveRole();const allRecords=scopedRecords(true);const forms=FORMS.filter(f=>!f.deleted&&f.published).filter(f=>(store.category==='全部'||f.category===store.category)&&f.name.includes(store.filter));$('content').innerHTML=head('数据查看','按授权表单进入各自的数据视图，不同表单保留独立字段结构。',roleSelect())+(role==='statistics'?accessDenied():'<div class=\"list-layout\">'+categories(forms)+'<div><div class=\"toolbar\"><div class=\"inline\">'+inputSearch('viewSearch','按表单名称搜索',store.filter)+tag(role==='department'?'信息工程学院范围':'全部授权范围','gray')+'<\/div><small>先选择表单，再查看和导出对应数据<\/small><\/div>'+table(['表单名称','表单类型','身份模式','数据范围','可见记录','最近提交','操作'],pageItems(forms).map(f=>{const records=allRecords.filter(x=>x.fid===f.id);return row(['<div class=\"row-name\">'+typeIcon(f)+'<strong>'+esc(f.name)+'<\/strong><\/div>',tag(f.type),tag(f.identity,f.identity==='实名填报'?'gray':'purple'),role==='department'?'信息工程学院':'全部授权范围',records.length,records.at(-1)?.submitted||'—',link('records','查看数据',f,'btn small',role==='department'?{role:'department'}:{})]);}))+pagination(forms.length)+'<\/div><\/div>');bindRole(renderView);keepSearch('viewSearch','filter',renderView);keepSearch('categorySearch','categorySearch',renderView);}\nfunction renderFollow(){const tasks=mineTasks().filter(t=>t.following&&formById(t.fid).name.includes(store.filter));$('content').innerHTML=head('我的关注','集中查看已关注表单的个人填报任务。')+'<div class=\"toolbar\">'+inputSearch('followSearch','按表单名称搜索',store.filter)+'<small>点击心形图标取消关注<\/small><\/div>'+table(['关注','名称','填报周期','开始时间','截止时间','提交时间','填报状态','审核状态','操作'],taskRows(pageItems(tasks)))+pagination(tasks.length);keepSearch('followSearch','filter',renderFollow);}\nfunction handleParticipation(action,el){if(action==='open-task'){openTask(el.dataset.id);return true;}if(action==='follow-task'){const t=TASKS.find(t=>t.id===el.dataset.id);t.following=!t.following;renderPage(store.active);toast(t.following?'已关注':'已取消关注');return true;}if(action==='save-task-draft'){const t=store.openTask;if(!t)return true;const v=taskValues();Object.assign(t,v,{fill:'填报中'});closeModal();renderPage(store.active);toast('草稿已保存，未计为有效提交');return true;}if(action==='review-task'){reviewTask(el.dataset.id);return true;}if(action==='task-info'){const t=TASKS.find(t=>t.id===el.dataset.id);if(FORM.identity!=='实名填报'){toast('匿名模式不提供人员任务信息');return true;}openModal('任务信息',taskDetailBody(t,FORM));return true;}return false;}\n\nif(['mine','apps','department'].includes(qp.get('tab')))store.workbenchTab=qp.get('tab');\ndocument.addEventListener('click',e=>{const a=e.target.closest('a[data-route]');if(!a||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;const f=formById(a.dataset.formRef);if(!f)return;const extra=JSON.parse(a.dataset.routeExtra||'{}');e.preventDefault();__prototypeLocation.href=href(a.dataset.route,f,extra);});\nconst defaultDesignFields=structuredClone(window.FormDesigner.defaultFields);\nif(!Array.isArray(FORM.fields))store.fields=structuredClone(defaultDesignFields);\nfunction renderBusinessDesign(){if(FORM.type==='业务报表'){$('content').innerHTML=head('业务报表设计','保留专属报表模型及模板运行能力。',link('overview','返回表单详情',FORM,'btn'))+notice('业务报表使用独立模型，不能直接转换为普通表单字段。报表引擎的接入与实际模板迁移待研发验证。','warning')+panel('年度工作报表模板','<div class=\"form-paper\"><h1>'+esc(FORM.name)+'<\/h1><p class=\"muted\" style=\"margin:12px 0 20px\">模板示意 · 2026 年度<\/p><table class=\"formgrid-preview\"><tr><td colspan=\"4\">单位：____________　填报人：____________<\/td><\/tr><tr><td>指标类别<\/td><td>本年数量<\/td><td>上年数量<\/td><td>同比<\/td><\/tr><tr><td>教学工作<\/td><td>128<\/td><td>116<\/td><td>10.3%<\/td><\/tr><tr><td>科研成果<\/td><td>36<\/td><td>30<\/td><td>20.0%<\/td><\/tr><tr><td colspan=\"4\">审核意见：_________________________________<\/td><\/tr><\/table><\/div>');return;}}\n/* Runs inside the existing forms bundle; existing navigation and release actions stay authoritative. */\nconst FD=window.FormDesigner;\nlet designProperties=structuredClone({...FD.formDefaults,...FORM.design,name:FORM.name});\nlet designInspector='component';\nlet designDevice='desktop';\nlet designerPreview=null;\nfunction designSnapshot(){return JSON.stringify({fields:store.fields,properties:designProperties});}\nfunction snapshotFields(){editHistory.stack.length=editHistory.index+1;editHistory.stack.push(designSnapshot());editHistory.index++;store.saved=false;}\nfunction restoreFields(delta){const idx=editHistory.index+delta;if(idx<0||idx>=editHistory.stack.length)return;editHistory.index=idx;const state=JSON.parse(editHistory.stack[idx]);store.fields=state.fields;designProperties=state.properties;store.fieldId=store.fields[0]?.id||null;store.saved=false;renderDesign();}\nfunction designAction(label,action,attrs='',cls=''){return '<button type=\"button\" class=\"btn '+cls+'\" data-fd-action=\"'+action+'\" '+attrs+'>'+label+'<\/button>';}\nfunction propertyControl(p,obj,scope='field'){\n const id='fd-prop-'+scope+'-'+p.key,attrs='id=\"'+id+'\" data-design-property=\"'+p.key+'\" data-design-scope=\"'+scope+'\"',v=obj[p.key]??p.value??'';\n const label='<label for=\"'+id+'\">'+esc(p.label)+'<\/label>';\n if(p.kind==='toggle')return '<div class=\"fd-property toggle\"><label for=\"'+id+'\">'+esc(p.label)+'<\/label><input '+attrs+' type=\"checkbox\" role=\"switch\" '+(v?'checked':'')+'><\/div>';\n if(p.kind==='images')return '<div class=\"fd-property\">'+label+'<input '+attrs+' type=\"file\" accept=\"image/*\" multiple><small>按选项顺序上传图片<\/small><div class=\"fd-option-images\">'+(Array.isArray(v)?v:[]).map((x,i)=>'<img src=\"'+esc(x)+'\" alt=\"选项'+(i+1)+'\">').join('')+'<\/div><\/div>';\n if(p.kind==='lines')return '<div class=\"fd-property\">'+label+'<textarea '+attrs+' rows=\"3\">'+esc(Array.isArray(v)?v.join('\\n'):v)+'<\/textarea><\/div>';\n if(['select','form','field'].includes(p.kind)){const choices=p.kind==='form'?[['','未设置'],...FORMS.filter(x=>x.type!=='业务报表').map(x=>[x.id,x.name]),...Object.entries(FD.sources).map(([id,s])=>[id,s.label+' · 示例源'])]:p.kind==='field'?[['','未设置'],...store.fields.filter(x=>x.id!==obj.id).map(x=>[x.id,x.label])]:p.choices.map(x=>[x,x]);return '<div class=\"fd-property\">'+label+'<select '+attrs+'>'+choices.map(([key,name])=>'<option value=\"'+esc(key)+'\"'+(key===v?' selected':'')+'>'+esc(name)+'<\/option>').join('')+'<\/select><\/div>';}\n if(p.kind==='formula')return '<div class=\"fd-property\">'+label+'<textarea '+attrs+' rows=\"3\" placeholder=\"例如 SUM({{c3}}, 10)\">'+esc(v)+'<\/textarea>'+designAction('变量与函数','formula','data-key=\"'+p.key+'\"')+'<small>字段写作 {{字段标识}}；支持 SUM、AVG、IF、ROUND、CONCAT 等函数。<\/small><\/div>';\n return '<div class=\"fd-property\">'+label+'<input '+attrs+' type=\"'+(['number','date','color'].includes(p.kind)?p.kind:'text')+'\" value=\"'+esc(v)+'\" '+(p.kind==='number'?'step=\"any\"':'')+'><\/div>';\n}\nfunction renderProperties(f){\n if(designInspector==='form')return renderFormProperties();\n if(!f)return '<div class=\"fd-inspector-empty\">'+icon('click')+'<p>选择画布中的组件<\/p><\/div>';\n const def=FD.definition(f.type),n=FD.normalize(f),properties=def.properties.map(p=>['titleFont','titleColor','titleSize','titleBold','titleAlign'].includes(p.key)?{...p,section:'标题样式'}:p).filter(p=>!(['hintMode','hint'].includes(p.key)&&!n.showHint)&&!(p.key==='uniqueForm'&&!n.crossUnique)&&!(p.key==='exclusiveValue'&&!n.exclusive)),groups=['基础设置','校验设置','高级设置','答题设置','标题样式'].filter(g=>properties.some(p=>p.section===g));\n return '<div class=\"fd-component-heading\"><strong>'+esc(def.label)+'<\/strong><code>'+esc(f.id)+'<\/code><\/div><div class=\"fd-property\"><label for=\"fieldLabel\">标题<\/label><input id=\"fieldLabel\" data-design-property=\"label\" data-design-scope=\"field\" maxlength=\"100\" value=\"'+esc(f.label)+'\"><\/div>'+groups.map(group=>'<details class=\"fd-property-section\" '+(group==='标题样式'?'':'open')+'><summary>'+esc(group)+'<\/summary><div>'+properties.filter(p=>p.section===group).map(p=>propertyControl(p,n)).join('')+'<\/div><\/details>').join('')+'<div class=\"fd-inspector-actions\">'+btn(icon('copy')+' 复制','clone-component','','data-id=\"'+f.id+'\"')+btn(icon('trash')+' 删除','delete-component','danger','data-id=\"'+f.id+'\"')+'<\/div>';\n}\nfunction renderFormProperties(){\n const p=designProperties,s=(key,label,kind='text',value='',choices)=>FD.spec(key,label,kind,value,choices),selectProp=(key,label,choices)=>propertyControl(s(key,label,'select',choices[0],choices),p,'form');\n const toggle=(key,label)=>propertyControl(s(key,label,'toggle',false),p,'form');const text=(key,label,kind='text')=>propertyControl(s(key,label,kind),p,'form');\n return '<details class=\"fd-property-section\" open><summary>基础设置<\/summary><div>'+text('name','表单名称')+designAction('表单名称样式','form-title')+selectProp('entryMode','新增数据方式',['默认方式','数据表格'])+toggle('showDescription','表单简介')+(p.showDescription?text('description','简介内容','lines'):'')+designAction('表单布局','form-layout')+'<\/div><\/details><details class=\"fd-property-section\" open><summary>规则设置<\/summary><div>'+[['validationRules','提交校验规则','添加校验条件'],['visibilityRules','字段显隐规则','添加显隐规则'],['uniqueRules','字段唯一性设置','添加唯一性规则']].map(([key,title,button])=>'<div class=\"fd-rule-list\"><strong>'+title+'<\/strong>'+(p[key]||[]).map((r,i)=>'<div><span>'+esc(r.message||r.name||title+' '+(i+1))+'<\/span>'+designAction('编辑','edit-rule','data-key=\"'+key+'\" data-index=\"'+i+'\"')+designAction('移除','remove-rule','data-key=\"'+key+'\" data-index=\"'+i+'\"')+'<\/div>').join('')+designAction('＋ '+button,'add-rule','data-key=\"'+key+'\"')+'<\/div>').join('')+selectProp('hiddenAssignment','不可见字段赋值',['保持原值','空值','始终重新计算'])+designAction('特殊字段赋值规则','hidden-assignment')+'<\/div><\/details><details class=\"fd-property-section\" open><summary>主题设置<\/summary><div>'+toggle('banner','横幅设置')+(p.banner?selectProp('bannerMode','横幅来源',['模板库','纯色','自定义'])+selectProp('bannerTemplate','模板类别',['信息登记','调查问卷','活动报名','在线申请','考试评分'])+text('bannerColor','横幅颜色','color')+(p.bannerMode==='自定义'?text('bannerImage','横幅图片地址'):''):'')+toggle('background','背景设置')+(p.background?selectProp('backgroundMode','背景来源',['纯色','自定义'])+text('backgroundColor','背景颜色','color')+(p.backgroundMode==='自定义'?text('backgroundImage','背景图片地址'):'')+text('backgroundOpacity','不透明度（0~100）','number'):'')+toggle('cover','封面设置')+(p.cover?text('coverText','封面文本','lines')+text('coverButton','按钮文本')+text('coverColor','封面背景颜色','color')+text('coverButtonColor','按钮颜色','color')+text('coverFontSize','字号','number')+selectProp('coverButtonPosition','按钮位置',['左对齐','居中','右对齐']):'')+'<\/div><\/details><details class=\"fd-property-section\" open><summary>事件列表<\/summary><div>'+(p.events||[]).map((ev,i)=>'<div class=\"fd-event-row\"><span>'+esc(ev.name)+'<small>'+(ev.enabled?'已启用':'已停用')+' · '+esc(ev.trigger)+'<\/small><\/span>'+designAction('编辑','event','data-index=\"'+i+'\"')+designAction('移除','remove-event','data-index=\"'+i+'\"')+'<\/div>').join('')+designAction('＋ 添加前端事件','event')+'<\/div><\/details>';\n}\nfunction renderComponent(f){const normalized=FD.normalize(f),width=({'整行':1,'3/4':.75,'2/3':.6667,'1/2':.5,'1/3':.3333,'1/4':.25}[normalized.width]||1)/Math.max(1,Math.min(4,Number(designDevice==='mobile'?designProperties.mobileColumns:designProperties.columns)||1));return '<div class=\"form-component fd-design-component '+(f.hidden?'is-hidden ':'')+(store.fieldId===f.id?'selected':'')+'\" data-field-select=\"'+esc(f.id)+'\" style=\"--fd-width:'+width+'\"><div class=\"comp-actions\">'+designAction(icon('arrow-up'),'move-up','data-id=\"'+f.id+'\" aria-label=\"上移字段\"')+designAction(icon('arrow-down'),'move-down','data-id=\"'+f.id+'\" aria-label=\"下移字段\"')+btn(icon(f.required?'asterisk':'asterisk-simple'),'toggle-required','small','data-id=\"'+f.id+'\" aria-label=\"切换必填\"')+btn(icon(f.hidden?'eye-off':'eye'),'toggle-hidden','small','data-id=\"'+f.id+'\" aria-label=\"切换隐藏\"')+btn(icon('copy'),'clone-component','small','data-id=\"'+f.id+'\" aria-label=\"复制字段\"')+btn(icon('trash'),'delete-component','small','data-id=\"'+f.id+'\" aria-label=\"删除字段\"')+'<\/div>'+FD.render([f],{...designProperties,columns:1,banner:false,background:false,showDescription:false}, {}, {designer:true,prefix:'design-'})+'<\/div>';}\nfunction renderDesign(){\n document.body.classList.add('design-focus');\n if(FORM.type==='业务报表')return renderBusinessDesign();\n $('content').style.padding='0';$('content').style.overflow='hidden';\n const selected=store.fields.find(f=>f.id===store.fieldId),groups=[...new Set(COMPONENTS.map(c=>c.group))];\n $('content').innerHTML='<div class=\"editor fd-editor\"><div class=\"editor-toolbar config-editor-toolbar\">'+configurationActions()+'<\/div><div class=\"editor-body\"><aside class=\"palette\">'+groups.map(group=>'<details open class=\"fd-palette-group\"><summary>'+group+'<\/summary><div class=\"palette-grid\">'+COMPONENTS.filter(c=>c.group===group).map(c=>'<button class=\"palette-item\" draggable=\"true\" data-component=\"'+c.type+'\" data-action=\"add-component\" data-type=\"'+c.type+'\">'+icon(c.icon)+'<span>'+c.label+'<\/span><\/button>').join('')+'<\/div><\/details>').join('')+'<\/aside><div class=\"canvas-wrap '+(designDevice==='mobile'?'fd-mobile-canvas':'')+'\" id=\"designCanvas\"><div class=\"form-paper\"><h1 style=\"font-family:'+esc(designProperties.font)+';font-size:'+Number(designProperties.nameSize||22)+'px;color:'+esc(designProperties.nameColor)+';text-align:'+({左对齐:'left',居中:'center',右对齐:'right'}[designProperties.nameAlign]||'center')+';font-weight:'+(designProperties.nameBold?'600':'400')+'\">'+esc(designProperties.name)+'<\/h1><div class=\"fields-root fd-design-fields\">'+store.fields.map(renderComponent).join('')+'<\/div>'+(!store.fields.length?'<div class=\"fd-canvas-empty\">'+icon('forms')+'<p>从左侧点击或拖入组件<\/p><\/div>':'')+'<div class=\"fd-canvas-submit\"><span class=\"btn primary\">提交<\/span><\/div><\/div><\/div><aside class=\"properties\"><div class=\"fd-inspector-tabs\" role=\"tablist\">'+['component','form'].map(v=>'<button type=\"button\" role=\"tab\" aria-selected=\"'+(designInspector===v)+'\" data-fd-action=\"inspector\" data-value=\"'+v+'\">'+(v==='component'?'组件属性':'表单属性')+'<\/button>').join('')+'<\/div><div class=\"fd-inspector-body\">'+renderProperties(selected)+'<\/div><\/aside><\/div><\/div>';\n const common=FD.commonTemplates;\n document.querySelector('.palette').insertAdjacentHTML('beforeend','<details open class=\"fd-palette-group fd-common-palette\"><summary>常用组件<\/summary><div>'+common.map(t=>'<button type=\"button\" data-fd-action=\"add-common\" data-template=\"'+t.id+'\"><strong>'+esc(t.label)+'<\/strong><small>'+esc(t.fields.join(' · '))+'<\/small><\/button>').join('')+'<\/div><\/details>');\n document.querySelectorAll('[data-component]').forEach(b=>b.addEventListener('dragstart',e=>e.dataTransfer.setData('text/plain',b.dataset.component)));\n document.querySelectorAll('.config-dropdown').forEach(dropdown=>{dropdown.addEventListener('mouseenter',()=>openConfigurationMenu(dropdown.querySelector('[data-config-action=\"menu\"]')));dropdown.addEventListener('mouseleave',()=>closeConfigurationMenus());dropdown.addEventListener('focusout',e=>{if(!dropdown.contains(e.relatedTarget))closeConfigurationMenus();});});\n $('designCanvas').addEventListener('dragover',e=>e.preventDefault());$('designCanvas').addEventListener('drop',e=>{e.preventDefault();const type=e.dataTransfer.getData('text/plain');if(COMPONENTS.some(c=>c.type===type))addComponent(type);});\n document.querySelectorAll('[data-field-select]').forEach(c=>c.addEventListener('click',e=>{if(e.target.closest('[data-action],[data-fd-action]'))return;store.fieldId=c.dataset.fieldSelect;designInspector='component';const scroll=$('designCanvas').scrollTop;renderDesign();$('designCanvas').scrollTop=scroll;}));\n document.querySelectorAll('[data-design-property]').forEach(control=>control.addEventListener('change',async()=>{const key=control.dataset.designProperty,obj=control.dataset.designScope==='form'?designProperties:selected;if(!obj)return;let v=control.type==='checkbox'?control.checked:control.type==='number'?control.value===''?'':Number(control.value):control.value;if(control.type==='file'){v=await Promise.all([...control.files].map(file=>new Promise(resolve=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.readAsDataURL(file);})))}if(['label','name'].includes(key)&&!String(v).trim()){toast('名称不能为空');control.value=obj[key];return;}obj[key]=v;if(key==='width')obj.half=v==='1/2';snapshotFields();const canvas=$('designCanvas').scrollTop,inspector=document.querySelector('.fd-inspector-body').scrollTop;renderDesign();$('designCanvas').scrollTop=canvas;document.querySelector('.fd-inspector-body').scrollTop=inspector;}));\n}\nfunction configurationActions(){\n return '<div class=\"config-editor-actions\"><div class=\"config-dropdown\"><button type=\"button\" class=\"btn\" data-config-action=\"menu\" data-menu=\"preview\" aria-haspopup=\"menu\" aria-expanded=\"false\">预览 '+icon('chevron-down')+'<\/button><div class=\"config-dropdown-panel\" data-config-menu-panel=\"preview\" role=\"menu\" aria-label=\"预览方式\" hidden><button type=\"button\" role=\"menuitem\" data-config-action=\"preview\" data-device=\"desktop\">'+icon('world')+' 网页预览<\/button><button type=\"button\" role=\"menuitem\" data-config-action=\"preview\" data-device=\"mobile\">'+icon('device-mobile')+' 手机预览<\/button><\/div><\/div>'+btn('保存','save-design','primary')+'<button type=\"button\" class=\"btn\" data-config-action=\"publish\">发布<\/button><div class=\"config-dropdown\"><button type=\"button\" class=\"btn\" data-config-action=\"menu\" data-menu=\"more\" aria-haspopup=\"menu\" aria-expanded=\"false\">'+icon('list-details')+' 更多 '+icon('chevron-down')+'<\/button><div class=\"config-dropdown-panel\" data-config-menu-panel=\"more\" role=\"menu\" aria-label=\"更多操作\" hidden><button type=\"button\" role=\"menuitem\" data-config-action=\"batch\">'+icon('square-plus')+' 批量添加<\/button><button type=\"button\" role=\"menuitem\" data-config-action=\"export\">'+icon('download')+' 导出表单<\/button><\/div><\/div><\/div>';\n}\nfunction closeConfigurationMenus(focus=false){\n const trigger=document.querySelector('[data-config-action=\"menu\"][aria-expanded=\"true\"]');\n document.querySelectorAll('[data-config-menu-panel]').forEach(p=>p.hidden=true);\n document.querySelectorAll('[data-config-action=\"menu\"]').forEach(b=>b.setAttribute('aria-expanded','false'));\n if(focus)trigger?.focus();\n}\nfunction openConfigurationMenu(trigger,focus=false){\n const panel=document.querySelector('[data-config-menu-panel=\"'+trigger.dataset.menu+'\"]');\n closeConfigurationMenus();panel.hidden=false;trigger.setAttribute('aria-expanded','true');if(focus)panel.querySelector('button')?.focus();\n}\nfunction previewDesign(device='desktop'){\n const config={...designProperties,name:designProperties.name},mobile=device==='mobile';\n openModal(mobile?'手机预览':'网页预览','<div class=\"config-preview '+(mobile?'config-preview-mobile':'')+'\">'+FD.renderEntry(store.fields,config,{}, {prefix:'preview-'})+'<\/div>','校验填写',()=>{const errors=designerPreview.validate();if(!Object.keys(errors).length)toast('校验通过，此处为设计预览');},mobile?438:1000);\n const paper=$('modalMask').querySelector('.config-preview'),root=paper.querySelector('[data-fd-entries],[data-fd-runtime]');\n applyFormPresentation(paper,root,config);\n designerPreview=FD.mountEntry(root,store.fields,config,{newRecord:true,records:RECORDS,context:{formId:FORM.id},prefix:'preview-'});\n}\nfunction batchAddComponents(){\n openModal('批量添加组件','<div class=\"field\"><label for=\"batchComponentType\">组件类型<\/label><select id=\"batchComponentType\">'+COMPONENTS.map(c=>'<option value=\"'+esc(c.type)+'\">'+esc(c.label)+' · '+esc(c.group)+'<\/option>').join('')+'<\/select><\/div><div class=\"field\"><label for=\"batchComponentNames\">字段名称<\/label><textarea id=\"batchComponentNames\" rows=\"8\" placeholder=\"每行填写一个字段名称，例如：&#10;项目名称&#10;负责人&#10;联系电话\"><\/textarea><small>按输入顺序添加所选类型的组件，每行一个名称。<\/small><\/div>','添加组件',()=>{\n  const names=$('batchComponentNames').value.split(/\\r?\\n/).map(s=>s.trim()).filter(Boolean),type=$('batchComponentType').value;\n  if(!names.length)return modalError('请至少填写一个字段名称。');\n  if(names.some(name=>name.length>100))return modalError('每个字段名称最多 100 个字符。');\n  if(store.fields.length+names.length>120)return modalError('表单最多支持 120 个组件，请减少本次添加数量。');\n  const fields=names.map(label=>({...FD.create(type),label}));store.fields.push(...fields);store.fieldId=fields.at(-1).id;designInspector='component';snapshotFields();closeModal();renderDesign();toast('已添加 '+fields.length+' 个组件');\n },600);\n}\nfunction exportFormDefinition(){\n if(!store.fields.length)return toast('至少保留一个表单组件后再导出');\n const definition={name:designProperties.name,type:FORM.type,fields:structuredClone(store.fields),design:structuredClone(designProperties)},blob=new Blob([JSON.stringify(definition,null,2)],{type:'application/json;charset=utf-8'}),owner=window.parent,doc=owner.document,url=owner.URL.createObjectURL(blob),a=doc.createElement('a');\n a.href=url;a.download=(definition.name||'表单').replace(/[\\\\/:*?\"<>|]/g,'-')+'.json';doc.body.append(a);a.click();a.remove();setTimeout(()=>owner.URL.revokeObjectURL(url),10000);toast('已导出表单定义');\n}\ndocument.addEventListener('click',e=>{\n const button=e.target.closest('[data-config-action]');\n if(!button)return;\n const action=button.dataset.configAction;\n if(action==='menu'){openConfigurationMenu(button,true);return;}\n closeConfigurationMenus();\n if(action==='preview')previewDesign(button.dataset.device);\n if(action==='batch')batchAddComponents();\n if(action==='export')exportFormDefinition();\n if(action==='publish'&&saveDesign()===true)__prototypeLocation.href=href('publish-config',FORM,Object.fromEntries(['origin','returnTo'].filter(k=>qp.has(k)).map(k=>[k,qp.get(k)])));\n});\ndocument.addEventListener('keydown',e=>{\n if(e.key==='Escape')closeConfigurationMenus(true);\n const trigger=e.target.closest('[data-config-action=\"menu\"]');if(trigger&&e.key==='ArrowDown'){e.preventDefault();openConfigurationMenu(trigger,true);}\n const panel=e.target.closest('[data-config-menu-panel]');if(!panel||!['ArrowDown','ArrowUp','Home','End'].includes(e.key))return;\n e.preventDefault();const buttons=[...panel.querySelectorAll('button')],index=buttons.indexOf(e.target),next=e.key==='Home'?0:e.key==='End'?buttons.length-1:(index+(e.key==='ArrowDown'?1:-1)+buttons.length)%buttons.length;buttons[next].focus();\n});\n\nfunction addComponent(type){const f=FD.create(type);store.fields.push(f);store.fieldId=f.id;designInspector='component';snapshotFields();renderDesign();document.querySelector('[data-field-select=\"'+f.id+'\"]').scrollIntoView({block:'nearest'});}\nfunction saveDesign(){\n if(!store.fields.length)return toast('至少保留一个表单组件');\n for(const f of store.fields){if(!f.label?.trim())return toast('组件标题不能为空');if(['formulaJS','calculation'].includes(f.type)){try{const vars=Object.fromEntries(store.fields.map(x=>[x.id,1]));FD.expression(f.formula,vars);}catch(e){return toast(f.label+'：'+e.message);}}}\n FORM.designVersions=FORM.designVersions||{};\n if(FORM.published&&!FORM.draftVersion){FORM.designVersions[FORM.version]={fields:structuredClone(FORM.fields||defaultDesignFields),design:structuredClone(FORM.design||FD.formDefaults)};FORM.publishedVersion=FORM.version;FORM.version++;FORM.draftVersion=FORM.version;}\n FORM.fields=structuredClone(store.fields);FORM.design=structuredClone(designProperties);FORM.name=designProperties.name;FORM.designVersions[FORM.version]={fields:structuredClone(store.fields),design:structuredClone(designProperties)};store.saved=true;addLog('修改设计','保存设计草稿 v'+FORM.version);renderDesign();toast('表单已保存');return true;\n}\n\nfunction openDesignSimple(title,specs){const draft=structuredClone(designProperties);openModal(title,'<div class=\"fd-settings-grid\">'+specs.map(p=>propertyControl(p,draft,'modal')).join('')+'<\/div>','应用配置',()=>{for(const input of document.querySelectorAll('[data-design-scope=\"modal\"]'))draft[input.dataset.designProperty]=input.type==='checkbox'?input.checked:input.type==='number'?Number(input.value):input.value;designProperties=draft;snapshotFields();closeModal();renderDesign();},620);}\nfunction designRuleDialog(key,index){\n const rules=designProperties[key],initial=rules[index]||{match:'所有',conditions:[],targets:'',fields:'',formula:'',message:''};let draft=structuredClone(initial);\n function body(){return '<div class=\"fd-rule-editor\">'+(key==='validationRules'?'<label>不满足校验条件时提示文字<input id=\"fdRuleMessage\" value=\"'+esc(draft.message)+'\"><\/label><label>校验公式<textarea id=\"fdRuleFormula\" placeholder=\"例如 {{字段标识}} > 0\">'+esc(draft.formula)+'<\/textarea><\/label><p class=\"fd-hint\">公式结果为 true 时允许提交。也可使用下面的条件。<\/p>':'')+(key==='uniqueRules'?'<p>所选字段共同组成唯一键，提交时与已有记录校验。<\/p><label>唯一性字段组合<select id=\"fdUniqueFields\" multiple size=\"8\">'+store.fields.filter(f=>!FD.definition(f.type).display).map(f=>'<option value=\"'+f.id+'\"'+(FD.list(draft.fields).includes(f.id)?' selected':'')+'>'+esc(f.label)+'<\/option>').join('')+'<\/select><\/label>':'<label>满足以下<select id=\"fdRuleMatch\">'+['所有','任一'].map(x=>'<option'+(x===draft.match?' selected':'')+'>'+x+'<\/option>').join('')+'<\/select>条件<\/label><div id=\"fdConditions\">'+draft.conditions.map((c,i)=>'<div class=\"fd-condition\"><select data-condition-field=\"'+i+'\">'+store.fields.map(f=>'<option value=\"'+f.id+'\"'+(f.id===c.field?' selected':'')+'>'+esc(f.label)+'<\/option>').join('')+'<\/select><select data-condition-op=\"'+i+'\">'+['等于','不等于','包含','大于','小于','为空','不为空'].map(op=>'<option'+(op===c.op?' selected':'')+'>'+op+'<\/option>').join('')+'<\/select><input data-condition-value=\"'+i+'\" value=\"'+esc(c.value)+'\" aria-label=\"比较值\"><button type=\"button\" data-condition-remove=\"'+i+'\" aria-label=\"删除条件\">×<\/button><\/div>').join('')+'<\/div><button type=\"button\" id=\"fdConditionAdd\" class=\"btn\">＋ 添加条件<\/button>')+(key==='visibilityRules'?'<label>显示以下字段<select id=\"fdRuleTargets\" multiple size=\"7\">'+store.fields.map(f=>'<option value=\"'+f.id+'\"'+(FD.list(draft.targets).includes(f.id)?' selected':'')+'>'+esc(f.label)+'<\/option>').join('')+'<\/select><\/label>':'')+'<p id=\"fdRuleError\" class=\"error\" role=\"alert\"><\/p><\/div>';}\n function readDraft(){draft.match=$('fdRuleMatch')?.value||draft.match;draft.message=$('fdRuleMessage')?.value||'';draft.formula=$('fdRuleFormula')?.value||'';if($('fdUniqueFields'))draft.fields=[...$('fdUniqueFields').selectedOptions].map(x=>x.value);if($('fdRuleTargets'))draft.targets=[...$('fdRuleTargets').selectedOptions].map(x=>x.value);draft.conditions=draft.conditions.map((c,i)=>({field:document.querySelector('[data-condition-field=\"'+i+'\"]').value,op:document.querySelector('[data-condition-op=\"'+i+'\"]').value,value:document.querySelector('[data-condition-value=\"'+i+'\"]').value}));}\n function bind(){if($('fdConditionAdd'))$('fdConditionAdd').onclick=()=>{readDraft();draft.conditions.push({field:store.fields[0]?.id,op:'等于',value:''});document.querySelector('.fd-rule-editor').outerHTML=body();bind();};document.querySelectorAll('[data-condition-remove]').forEach(b=>b.onclick=()=>{readDraft();draft.conditions.splice(Number(b.dataset.conditionRemove),1);document.querySelector('.fd-rule-editor').outerHTML=body();bind();});}\n openModal(({validationRules:'表单校验',visibilityRules:'字段显隐规则',uniqueRules:'字段唯一性设置'})[key],body(),'确定',()=>{readDraft();if(key==='uniqueRules'&&!draft.fields.length||key==='visibilityRules'&&(!draft.conditions.length||!draft.targets.length)||key==='validationRules'&&!draft.formula&&!draft.conditions.length){$('fdRuleError').textContent='请完成规则条件和字段配置';return;}if(draft.formula){try{FD.expression(draft.formula,Object.fromEntries(store.fields.map(f=>[f.id,1])));}catch(e){$('fdRuleError').textContent=e.message;return;}}if(index===undefined)rules.push(draft);else rules[index]=draft;snapshotFields();closeModal();renderDesign();},760);bind();\n}\nfunction designEventDialog(index){\n const draft=structuredClone(designProperties.events[index]||{name:'',enabled:true,description:'',trigger:'页面初始化',watchFields:'',match:'所有',conditions:[],actions:[{type:'字段赋值',target:store.fields[0]?.id,source:'自定义',value:''}]});\n const step=(a,i)=>'<fieldset class=\"fd-event-step\" data-step=\"'+i+'\"><legend>步骤 '+(i+1)+'<\/legend><div class=\"fd-event-step-actions\">'+designAction('上移','step-up','data-index=\"'+i+'\"')+designAction('下移','step-down','data-index=\"'+i+'\"')+designAction('复制','step-copy','data-index=\"'+i+'\"')+designAction('删除','step-remove','data-index=\"'+i+'\"')+'<\/div><label>动作类型<select data-step-key=\"type\">'+['字段赋值','HTTP 请求','表单数据查询返回','模型数据查询返回'].map(x=>'<option'+(a.type===x?' selected':'')+'>'+x+'<\/option>').join('')+'<\/select><\/label>'+(a.type==='字段赋值'?'<label>目标字段<select data-step-key=\"target\">'+store.fields.map(f=>'<option value=\"'+f.id+'\"'+(f.id===a.target?' selected':'')+'>'+esc(f.label)+'<\/option>').join('')+'<\/select><\/label><label>字段取值<select data-step-key=\"source\">'+['自定义','当前用户','当前部门','公式'].map(x=>'<option'+(a.source===x?' selected':'')+'>'+x+'<\/option>').join('')+'<\/select><\/label><label>赋值内容<input data-step-key=\"value\" value=\"'+esc(a.value)+'\"><\/label>':'<label>请求方式<select data-step-key=\"method\">'+['GET','POST','PUT','DELETE'].map(x=>'<option'+(x===a.method?' selected':'')+'>'+x+'<\/option>').join('')+'<\/select><\/label><label>请求地址<input data-step-key=\"url\" value=\"'+esc(a.url)+'\" placeholder=\"https://\"><\/label><label>请求参数（JSON）<textarea data-step-key=\"parameters\">'+esc(a.parameters||'{}')+'<\/textarea><\/label><label>密钥变量名（不保存真实密钥）<input data-step-key=\"secretName\" value=\"'+esc(a.secretName)+'\"><\/label><label>原型返回结果（JSON）<textarea data-step-key=\"mockResponse\">'+esc(a.mockResponse||'{}')+'<\/textarea><\/label><label>回填字段（返回属性=字段标识，每行一项）<textarea data-step-key=\"mapping\">'+esc(a.mapping||'')+'<\/textarea><\/label><small>此原型使用配置的返回结果演示回填，不发送网络请求。<\/small>')+'<\/fieldset>';\n const body=()=>'<div class=\"fd-event-editor\"><div class=\"fd-settings-grid\"><label>事件名称<input id=\"fdEventName\" maxlength=\"50\" value=\"'+esc(draft.name)+'\"><\/label><label><input id=\"fdEventEnabled\" type=\"checkbox\" '+(draft.enabled?'checked':'')+'>启用事件<\/label><label>功能说明<textarea id=\"fdEventDescription\">'+esc(draft.description)+'<\/textarea><\/label><label>触发方式<select id=\"fdEventTrigger\">'+['页面初始化','字段值变化'].map(x=>'<option'+(draft.trigger===x?' selected':'')+'>'+x+'<\/option>').join('')+'<\/select><\/label><label>监听字段（字段标识，每行一个）<textarea id=\"fdEventFields\">'+esc(draft.watchFields||'')+'<\/textarea><\/label><label>执行条件公式（留空表示无条件）<textarea id=\"fdEventCondition\">'+esc(draft.formula||'')+'<\/textarea><\/label><\/div><div id=\"fdEventSteps\">'+draft.actions.map(step).join('')+'<\/div>'+designAction('＋ 添加步骤','step-add')+'<p id=\"fdEventError\" class=\"error\" role=\"alert\"><\/p><\/div>';\n const read=()=>{draft.name=$('fdEventName').value.trim();draft.enabled=$('fdEventEnabled').checked;draft.description=$('fdEventDescription').value;draft.trigger=$('fdEventTrigger').value;draft.watchFields=$('fdEventFields').value;draft.formula=$('fdEventCondition').value;document.querySelectorAll('[data-step]').forEach(el=>{const a=draft.actions[Number(el.dataset.step)];el.querySelectorAll('[data-step-key]').forEach(x=>a[x.dataset.stepKey]=x.value);});};\n function bind(){document.querySelector('.fd-event-editor').addEventListener('click',e=>{const b=e.target.closest('[data-fd-action]');if(!b)return;read();const a=b.dataset.fdAction,i=Number(b.dataset.index);if(a==='step-add')draft.actions.push({type:'字段赋值',target:store.fields[0]?.id,source:'自定义',value:''});if(a==='step-remove')draft.actions.splice(i,1);if(a==='step-copy')draft.actions.splice(i+1,0,structuredClone(draft.actions[i]));if(a==='step-up'&&i>0)[draft.actions[i-1],draft.actions[i]]=[draft.actions[i],draft.actions[i-1]];if(a==='step-down'&&i<draft.actions.length-1)[draft.actions[i],draft.actions[i+1]]=[draft.actions[i+1],draft.actions[i]];document.querySelector('.fd-event-editor').outerHTML=body();bind();});document.querySelectorAll('[data-step-key=\"type\"]').forEach(s=>s.addEventListener('change',()=>{read();document.querySelector('.fd-event-editor').outerHTML=body();bind();}));}\n openModal(index===undefined?'添加前端事件':'编辑前端事件',body(),'确定',()=>{read();if(!draft.name||!draft.actions.length)return $('fdEventError').textContent='请填写事件名称并至少添加一个步骤';try{if(draft.formula)FD.expression(draft.formula,Object.fromEntries(store.fields.map(f=>[f.id,1])));for(const a of draft.actions){if(a.type==='字段赋值'&&!a.target)throw Error('请选择目标字段');if(a.type!=='字段赋值')JSON.parse(a.mockResponse||'{}');}}catch(e){$('fdEventError').textContent=e.message;return;}if(index===undefined)designProperties.events.push(draft);else designProperties.events[index]=draft;snapshotFields();closeModal();renderDesign();},900);bind();\n}\ndocument.addEventListener('click',e=>{\n const b=e.target.closest('[data-fd-action]');if(!b||b.disabled||b.closest('.fd-event-editor'))return;const action=b.dataset.fdAction,index=b.dataset.index===undefined?undefined:Number(b.dataset.index),key=b.dataset.key;\n if(action==='inspector'){designInspector=b.dataset.value;renderDesign();}\n if(action==='add-common'){const template=FD.commonTemplates.find(t=>t.id===b.dataset.template);if(!template)return;const fields=template.fields.map(label=>{const f=FD.create(/人数|数量|年龄|数字|热度|金牌数/.test(label)?'number':/日期|时间/.test(label)?'date':'text');f.label=label;return f;}),source=FD.create('referencedata');source.label=template.label;source.sourceForm='public:'+template.id;source.displayFields=template.fields.join('\\n');source.echoFields=fields.map(f=>f.label+'='+f.id).join('\\n');source.buttonText='读取示例数据';store.fields.push(source,...fields);store.fieldId=source.id;designInspector='component';snapshotFields();renderDesign();}\n if(action==='device'){designDevice=b.dataset.device;renderDesign();}\n if(action==='move-up'||action==='move-down'){const i=store.fields.findIndex(f=>f.id===b.dataset.id),j=i+(action==='move-up'?-1:1);if(j<0||j>=store.fields.length)return;[store.fields[i],store.fields[j]]=[store.fields[j],store.fields[i]];snapshotFields();renderDesign();}\n if(action==='form-title')openDesignSimple('表单名称样式',[FD.spec('font','字体'),FD.spec('nameColor','字体颜色','color'),FD.spec('nameSize','字号','number'),FD.spec('letterSpacing','字间距','number'),FD.spec('nameBold','加粗','toggle'),FD.spec('nameAlign','对齐方式','select','居中',['左对齐','居中','右对齐'])]);\n if(action==='form-layout')openDesignSimple('表单布局',[FD.spec('columns','Web端列数','number'),FD.spec('titlePosition','Web端字段标题位置','select','顶部',['顶部','左侧']),FD.spec('mobileColumns','移动端列数','number'),FD.spec('mobileTitlePosition','移动端字段标题位置','select','顶部',['顶部','左侧'])]);\n if(action==='hidden-assignment')openDesignSimple('特殊字段赋值规则',[FD.spec('hiddenEmpty','不可见时清空的字段标识（每行一个）','lines'),FD.spec('hiddenRecalculate','不可见时始终重新计算的字段标识（每行一个）','lines')]);\n if(action==='add-rule'||action==='edit-rule')designRuleDialog(key,index);\n if(action==='remove-rule'){designProperties[key].splice(index,1);snapshotFields();renderDesign();}\n if(action==='event')designEventDialog(index);\n if(action==='remove-event'){designProperties.events.splice(index,1);snapshotFields();renderDesign();}\n if(action==='formula'){const f=store.fields.find(x=>x.id===store.fieldId);if(!f)return;openModal('公式设置','<label class=\"field\">计算表达式<textarea id=\"fdFormulaText\">'+esc(f[key])+'<\/textarea><\/label><div class=\"fd-formula-tokens\">'+store.fields.map(x=>designAction(esc(x.label),'insert-formula','data-token=\"'+esc('{{'+x.id+'}}')+'\"')).join('')+['+','-','*','/','(',')','SUM(','IF(','ROUND(','CONCAT('].map(x=>designAction(x,'insert-formula','data-token=\"'+esc(x)+'\"')).join('')+'<\/div><p id=\"fdFormulaError\" class=\"error\"><\/p>','应用公式',()=>{const expr=$('fdFormulaText').value;try{FD.expression(expr,Object.fromEntries(store.fields.map(x=>[x.id,1])));}catch(err){$('fdFormulaError').textContent=err.message;return;}f[key]=expr;snapshotFields();closeModal();renderDesign();},680);}\n if(action==='insert-formula'){const input=$('fdFormulaText'),a=input.selectionStart,z=input.selectionEnd;input.value=input.value.slice(0,a)+b.dataset.token+input.value.slice(z);input.focus();input.setSelectionRange(a+b.dataset.token.length,a+b.dataset.token.length);}\n});\neditHistory.stack=[designSnapshot()];editHistory.index=0;\n\nfunction recordDetail(id){\n const r=RECORDS.find(x=>x.id===id);if(!r)return;\n if(effectiveRole()==='statistics'){toast('当前角色没有数据明细权限');return;}\n if(effectiveRole()==='department'&&r.dept!=='信息工程学院'){toast('记录超出当前授权范围');return;}\n const m=maskedRecord(r),f=formById(r.fid),fields=r.fieldSchema;\n const metadata='<dl class=\"description\"><dt>表单<\/dt><dd>'+esc(f.name)+'<\/dd><dt>提交人<\/dt><dd>'+esc(m.person)+'<\/dd><dt>所属单位<\/dt><dd>'+esc(m.dept)+'<\/dd><dt>填报周期<\/dt><dd>'+esc(r.cycle)+'<\/dd><dt>提交时间<\/dt><dd>'+esc(r.submitted)+'<\/dd><dt>版本<\/dt><dd>v'+r.version+'<\/dd><dt>审核状态<\/dt><dd>'+stateTag(r.audit==='—'?'无需审核':r.audit)+'<\/dd><\/dl>';\n openModal('填报记录 · '+r.id,(f.identity!=='实名填报'?notice('当前表单采用'+f.identity+'，明细和导出均隐藏提交人身份。'):'')+metadata+FD.summary(fields,FD.publicValues(r,f)),'',null,800);\n}\nfunction exportRecords(all=false){\n if(effectiveRole()==='statistics')return toast('当前角色不能导出数据明细');\n const records=scopedRecords(all).filter(r=>[r.id,maskedRecord(r).person,maskedRecord(r).dept].join(' ').includes(store.filter)),fields=FD.exportFields(records,FORM);\n csvDownload('填报数据_'+FORM.name,['记录编号','表单','提交人','所属单位','周期','提交时间','审核状态','版本',...fields.map(f=>f.label+' ['+f.id+']')],records.map(r=>{const m=maskedRecord(r),f=formById(r.fid),values=FD.publicValues(r,f);return [r.id,f.name,m.person,m.dept,r.cycle,r.submitted,r.audit,'v'+r.version,...fields.map(field=>FD.exportValue(values[field.id]))];}));\n}\n\n/* Form-scoped lottery configuration and a non-persistent drawing preview. */\nconst lotteryDefaults={enabled:false,wheelCells:3,prizes:[],drawsPerSubmission:1,maxWins:'',timeMode:'immediate',drawAt:'',conditionMode:'none',conditionMatch:'all',conditions:[],prompt:'提交成功，您可以参与抽奖！',buttonText:'参与抽奖',linkMode:'default',customUrl:'',winText:'中奖啦！恭喜你获得{奖品名称}',claimText:'恭喜你，请及时领取奖品',loseText:'很遗憾，与大奖擦肩而过，再接再厉',issuerEnabled:false,issuerName:'',issuerContact:'',redeemMode:'code',phoneField:''};\nlet lotteryDraft=structuredClone({...lotteryDefaults,...FORM.lottery});\nlet lotteryPrizeDraft=null;\nlet lotteryPreviewState=null;\nfunction lotteryFields(){return (FORM.fields||store.fields||[]).filter(f=>!FD.definition(f.type)?.display);}\nfunction lotteryPhoneFields(){return lotteryFields().filter(f=>f.type==='phone');}\nfunction lotteryButton(label,action,attrs='',cls=''){return '<button type=\"button\" class=\"btn '+cls+'\" data-lottery-action=\"'+action+'\" '+attrs+'>'+label+'<\/button>';}\nfunction lotteryHelp(text){return '<span class=\"lottery-help\" tabindex=\"0\" role=\"note\" aria-label=\"'+esc(text)+'\" title=\"'+esc(text)+'\">'+icon('help-circle')+'<\/span>';}\nfunction lotteryInput(key,label,type='text',extra='',maxLength=0){const value=lotteryDraft[key]??'';return '<label class=\"lottery-field\"><span>'+label+'<\/span><div class=\"lottery-input-wrap\"><input type=\"'+type+'\" data-lottery-key=\"'+key+'\" value=\"'+esc(value)+'\" '+extra+(maxLength?' maxlength=\"'+maxLength+'\"':'')+'>'+(maxLength?'<small data-lottery-count=\"'+key+'\">'+String(value).length+'/'+maxLength+'<\/small>':'')+'<\/div><\/label>';}\nfunction lotteryRadios(key,items){return '<div class=\"lottery-radios\">'+items.map(([value,label,disabled=false])=>'<label><input type=\"radio\" name=\"lottery-'+key+'\" data-lottery-key=\"'+key+'\" value=\"'+value+'\"'+(lotteryDraft[key]===value?' checked':'')+(disabled?' disabled':'')+'>'+label+'<\/label>').join('')+'<\/div>';}\nfunction lotteryTotal(){return Math.round(lotteryDraft.prizes.reduce((sum,p)=>sum+Number(p.probability||0),0)*100)/100;}\nfunction showSettingsTab(tab,updateUrl=true){tab=tab==='lottery'?'lottery':'basic';document.querySelectorAll('[data-settings-tab]').forEach(b=>{b.classList.toggle('active',b.dataset.settingsTab===tab);b.setAttribute('aria-selected',String(b.dataset.settingsTab===tab));});$('settingsBasic').hidden=tab!=='basic';$('settingsLottery').hidden=tab!=='lottery';if(updateUrl){qp.set('settingsTab',tab);__prototypeHistory.replaceState(null,'','?'+qp.toString());}}\nfunction renderSettings(){\n renderBasicSettings();const content=$('content'),header=content.querySelector('.page-head'),basic=document.createElement('div');basic.id='settingsBasic';basic.setAttribute('role','tabpanel');basic.setAttribute('aria-label','基础设置');while(header.nextSibling)basic.append(header.nextSibling);content.append(basic);header.insertAdjacentHTML('afterend','<div class=\"lottery-settings-tabs\" role=\"tablist\" aria-label=\"填报设置分类\"><button type=\"button\" role=\"tab\" data-settings-tab=\"basic\">基础设置<\/button><button type=\"button\" role=\"tab\" data-settings-tab=\"lottery\">抽奖设置<\/button><\/div>');content.insertAdjacentHTML('beforeend','<div id=\"settingsLottery\" role=\"tabpanel\" aria-label=\"抽奖设置\"><\/div>');header.querySelector('p').textContent='配置填报规则、抽奖奖品与兑奖信息。';renderLotterySettings();showSettingsTab(qp.get('settingsTab'),false);\n}\nfunction lotteryConditions(){const fields=lotteryFields();return '<div class=\"lottery-conditions\"><label class=\"lottery-inline\">满足<select data-lottery-key=\"conditionMatch\"><option value=\"all\"'+(lotteryDraft.conditionMatch==='all'?' selected':'')+'>全部<\/option><option value=\"any\"'+(lotteryDraft.conditionMatch==='any'?' selected':'')+'>任一<\/option><\/select>条件时允许抽奖<\/label>'+lotteryDraft.conditions.map((c,i)=>'<div class=\"lottery-condition\"><select aria-label=\"条件字段'+(i+1)+'\" data-lottery-condition=\"'+i+'\" data-key=\"field\">'+fields.map(f=>'<option value=\"'+esc(f.id)+'\"'+(c.field===f.id?' selected':'')+'>'+esc(f.label)+'<\/option>').join('')+'<\/select><select aria-label=\"条件运算'+(i+1)+'\" data-lottery-condition=\"'+i+'\" data-key=\"operator\">'+['等于','不等于','包含','大于','小于','不为空'].map(op=>'<option'+(c.operator===op?' selected':'')+'>'+op+'<\/option>').join('')+'<\/select>'+(c.operator==='不为空'?'':'<input aria-label=\"条件值'+(i+1)+'\" data-lottery-condition=\"'+i+'\" data-key=\"value\" value=\"'+esc(c.value||'')+'\" placeholder=\"比较值\">')+lotteryButton('删除','remove-condition','data-index=\"'+i+'\"','danger-text')+'<\/div>').join('')+lotteryButton('＋ 添加条件','add-condition',fields.length?'':'disabled')+(fields.length?'':'<p class=\"lottery-hint\">请先在表单设计中添加可填写字段。<\/p>')+'<\/div>';}\nfunction renderLotterySettings(){\n const p=lotteryDraft,phones=lotteryPhoneFields(),total=lotteryTotal();\n const rows=p.prizes.map((x,i)=>'<tr><td>'+(x.image?'<img class=\"lottery-prize-image\" src=\"'+esc(x.image)+'\" alt=\"'+esc(x.name)+'\">':'<span class=\"lottery-prize-icon\">'+icon('gift')+'<\/span>')+'<\/td><td>'+esc(x.award)+'<\/td><td>'+esc(x.name)+'<\/td><td>'+x.quantity+'<\/td><td>'+x.probability+'%<\/td><td><div class=\"lottery-row-actions\">'+lotteryButton('编辑','edit-prize','data-index=\"'+i+'\"','link')+lotteryButton('删除','remove-prize','data-index=\"'+i+'\"','link danger-text')+'<\/div><\/td><\/tr>').join('');\n $('settingsLottery').innerHTML='<section class=\"panel lottery-panel\"><div class=\"panel-head\"><h2>设置抽奖奖品 '+lotteryHelp('奖品数量和概率分别配置。转盘格子大小不代表中奖概率。')+'<\/h2><\/div><div class=\"panel-body\"><div class=\"lottery-toolbar\"><label class=\"lottery-enable\"><input type=\"checkbox\" role=\"switch\" data-lottery-key=\"enabled\" '+(p.enabled?'checked':'')+'><strong>'+(p.enabled?'已开启':'未开启')+'<\/strong><\/label><div class=\"lottery-inline\">'+lotteryInput('wheelCells','转盘格数','number','min=\"3\" max=\"12\" step=\"1\"')+lotteryButton('预览','preview','','primary')+'<\/div><\/div><div class=\"lottery-table-scroll\"><table class=\"lottery-prizes\"><thead><tr><th>奖品图片<\/th><th>奖项名称<\/th><th>奖品名称<\/th><th>剩余数量<\/th><th>中奖概率 <span class=\"lottery-total '+(total>100?'invalid':'')+'\">（'+total+'%）<\/span><\/th><th>操作<\/th><\/tr><\/thead><tbody>'+rows+'<\/tbody><\/table>'+(rows?'':'<div class=\"lottery-empty\">'+icon('gift')+'<span>暂无奖品<\/span><\/div>')+'<\/div><p class=\"lottery-mobile-hint\">左右滑动查看全部奖品信息<\/p>'+lotteryButton('＋ 添加奖品','add-prize','','lottery-add')+'<p class=\"lottery-hint\">转盘支持 3–12 格；未分配的格子显示“谢谢参与”。中奖概率合计不得超过 100%。<\/p><\/div><\/section>'+\n panel('设置抽奖方式','<div class=\"lottery-subsection\"><h3>设置抽奖次数 '+lotteryHelp('每次有效提交获得对应次数；每人最多中奖次数留空表示不限。')+'<\/h3><div class=\"lottery-inline lottery-attempts\">每人每填写一次表单可抽奖'+lotteryInput('drawsPerSubmission','抽奖次数','number','min=\"1\" max=\"99\" step=\"1\"')+'次，每人最多可中奖'+lotteryInput('maxWins','最多中奖次数','number','min=\"1\" max=\"99\" step=\"1\" placeholder=\"不限\"')+'次<\/div><p class=\"lottery-hint\">如设置重复填报，每次有效提交重新计算抽奖次数；每人中奖上限按本次活动累计。<\/p><\/div><div class=\"lottery-subsection\"><h3>设置抽奖时间<\/h3>'+lotteryRadios('timeMode',[['immediate','立即抽奖'],['scheduled','指定时间抽奖']])+(p.timeMode==='scheduled'?lotteryInput('drawAt','开放抽奖时间','datetime-local'):'<p class=\"lottery-hint\">填写者提交表单后即可参与抽奖。<\/p>')+'<\/div><div class=\"lottery-subsection\"><h3>设置抽奖条件<\/h3>'+lotteryRadios('conditionMode',[['none','无'],['conditional','按条件抽奖']])+(p.conditionMode==='conditional'?lotteryConditions():'<p class=\"lottery-hint\">提交表单的填写者均可参加抽奖。<\/p>')+'<\/div>')+\n panel('设置抽奖提示',lotteryInput('prompt','抽奖文案','text','',30)+'<div class=\"lottery-subsection\"><h3>抽奖按钮<\/h3>'+lotteryInput('buttonText','按钮文案','text','',10)+'<div class=\"lottery-field\"><span>按钮跳转地址<\/span>'+lotteryRadios('linkMode',[['default','默认抽奖页面'],['custom','自定义']])+'<\/div>'+(p.linkMode==='custom'?lotteryInput('customUrl','自定义地址','url','placeholder=\"https://\"'):'')+'<\/div>')+\n panel('设置中奖信息','<div class=\"lottery-subsection\"><h3>设置文案信息<\/h3><div class=\"lottery-field\"><div class=\"lottery-label-actions\"><label for=\"lotteryWinText\">中奖文案<\/label>'+lotteryButton('插入奖品名称','insert-prize-name','','link')+'<\/div><input id=\"lotteryWinText\" data-lottery-key=\"winText\" value=\"'+esc(p.winText)+'\" maxlength=\"300\"><\/div>'+lotteryInput('claimText','兑奖说明','text','',300)+lotteryInput('loseText','未中奖文案','text','',300)+'<\/div><div class=\"lottery-subsection\"><h3>设置发奖人信息<\/h3><label class=\"lottery-enable\"><input type=\"checkbox\" role=\"switch\" aria-label=\"显示发奖人信息\" data-lottery-key=\"issuerEnabled\" '+(p.issuerEnabled?'checked':'')+'><span>展示发奖人信息<\/span><\/label>'+(p.issuerEnabled?'<div class=\"lottery-field-grid\">'+lotteryInput('issuerName','发奖人姓名','text','maxlength=\"30\"')+lotteryInput('issuerContact','联系方式','text','maxlength=\"60\"')+'<\/div>':'')+'<\/div>')+\n panel('设置兑奖方式',lotteryRadios('redeemMode',[['code','兑奖码'],['phone','手机号码',!phones.length]])+(p.redeemMode==='phone'?'<label class=\"lottery-field\"><span>兑奖手机号字段<\/span><select data-lottery-key=\"phoneField\">'+phones.map(f=>'<option value=\"'+esc(f.id)+'\"'+(p.phoneField===f.id?' selected':'')+'>'+esc(f.label)+'<\/option>').join('')+'<\/select><\/label><p class=\"lottery-hint\">使用填写者提交的手机号核对中奖信息。<\/p>':'<p class=\"lottery-hint\">为中奖者自动生成 8 位字符的兑奖码。'+(!phones.length?'在表单设计中添加手机组件后，可选择手机号码兑奖。':'')+'<\/p>'))+\n '<div class=\"savebar\"><span class=\"muted\">'+(store.saved?'设置已保存在当前浏览器':'更改配置后请保存')+'<\/span><span class=\"muted\">'+(p.enabled?'抽奖设置启用后生效。':'当前未开启抽奖。')+'<\/span><\/div>';\n}\nfunction lotteryError(p){\n if(!p.enabled)return '';\n if(!Number.isInteger(Number(p.wheelCells))||p.wheelCells<3||p.wheelCells>12)return '转盘格数须为 3 至 12 的整数';\n if(!p.prizes.length)return '请至少添加一个奖品';\n for(const x of p.prizes){if(!x.award.trim()||!x.name.trim())return '请填写奖项名称和奖品名称';if(!Number.isInteger(Number(x.quantity))||x.quantity<0)return '剩余数量须为非负整数';if(!Number.isFinite(Number(x.probability))||x.probability<0||x.probability>100)return '单项中奖概率须为 0 至 100 的数字';}\n const total=p.prizes.reduce((s,x)=>s+Number(x.probability),0);if(total>100.00001)return '中奖概率合计不得超过 100%';\n if(p.prizes.length+(total<100?1:0)>Number(p.wheelCells))return '转盘格数不足，请增加格数或减少奖品；未中奖需占一格';\n if(!Number.isInteger(Number(p.drawsPerSubmission))||p.drawsPerSubmission<1||p.drawsPerSubmission>99)return '每次抽奖次数须为 1 至 99 的整数';\n if(p.maxWins!==''&&(!Number.isInteger(Number(p.maxWins))||p.maxWins<1||p.maxWins>99))return '最多中奖次数须为 1 至 99 的整数，或留空不限';\n if(p.timeMode==='scheduled'&&!p.drawAt)return '请选择开放抽奖时间';\n if(p.conditionMode==='conditional'&&(!p.conditions.length||p.conditions.some(c=>!lotteryFields().some(f=>f.id===c.field)||c.operator!=='不为空'&&!String(c.value??'').trim())))return '请完成抽奖条件的字段和比较值';\n if(!p.prompt.trim()||p.prompt.length>30||!p.buttonText.trim()||p.buttonText.length>10)return '请填写抽奖文案（最多30字）和按钮文案（最多10字）';\n if(p.linkMode==='custom'){try{if(!['http:','https:'].includes(new URL(p.customUrl).protocol))throw Error();}catch{return '自定义跳转地址须为有效的 http 或 https 链接';}}\n if(!p.winText.trim()||!p.claimText.trim()||!p.loseText.trim()||[p.winText,p.claimText,p.loseText].some(t=>t.length>300))return '请填写中奖、兑奖及未中奖文案，每项最多300字';\n if(p.issuerEnabled&&(!p.issuerName.trim()||!p.issuerContact.trim()))return '请填写发奖人姓名和联系方式';\n if(p.redeemMode==='phone'&&!lotteryPhoneFields().some(f=>f.id===p.phoneField))return '请选择有效的兑奖手机号字段';\n return '';\n}\nfunction validateLotteryBeforeSave(){const error=lotteryError(lotteryDraft);if(error){showSettingsTab('lottery');toast(error);return false;}return true;}\nfunction editLotteryPrize(index){\n lotteryPrizeDraft=structuredClone(index===undefined?{id:'prize-'+Date.now(),award:'',name:'',quantity:10,probability:10,image:''}:lotteryDraft.prizes[index]);const p=lotteryPrizeDraft;\n openModal(index===undefined?'添加奖品':'编辑奖品','<div class=\"lottery-prize-editor\"><label class=\"lottery-field\"><span>奖品图片<\/span><input type=\"file\" id=\"lotteryPrizeImage\" accept=\"image/png,image/jpeg,image/webp\"><small class=\"lottery-hint\">支持 PNG、JPG、WebP，最大 2MB。<\/small><\/label><div id=\"lotteryImagePreview\">'+(p.image?'<img class=\"lottery-prize-image\" src=\"'+esc(p.image)+'\" alt=\"奖品图片\">':'')+'<\/div>'+lotteryButton('移除图片','remove-image','','link')+'<div class=\"lottery-field-grid\"><label class=\"lottery-field\"><span>奖项名称<\/span><input id=\"lotteryPrizeAward\" maxlength=\"30\" placeholder=\"如：一等奖\" value=\"'+esc(p.award)+'\"><\/label><label class=\"lottery-field\"><span>奖品名称<\/span><input id=\"lotteryPrizeName\" maxlength=\"50\" placeholder=\"如：校园文创礼包\" value=\"'+esc(p.name)+'\"><\/label><label class=\"lottery-field\"><span>剩余数量<\/span><input id=\"lotteryPrizeQuantity\" type=\"number\" min=\"0\" step=\"1\" value=\"'+p.quantity+'\"><\/label><label class=\"lottery-field\"><span>中奖概率（%）<\/span><input id=\"lotteryPrizeProbability\" type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" value=\"'+p.probability+'\"><\/label><\/div><\/div>','确定',()=>{\n const item={...lotteryPrizeDraft,award:$('lotteryPrizeAward').value.trim(),name:$('lotteryPrizeName').value.trim(),quantity:Number($('lotteryPrizeQuantity').value),probability:Number($('lotteryPrizeProbability').value)};\n if(!item.award||!item.name){$('modalError').textContent='请填写奖项名称和奖品名称';return;}if($('lotteryPrizeQuantity').value===''||!Number.isInteger(item.quantity)||item.quantity<0||!Number.isFinite(item.probability)||item.probability<0||item.probability>100||$('lotteryPrizeProbability').value===''){$('modalError').textContent='请填写有效的非负库存和 0–100% 概率';return;}\n if(index===undefined)lotteryDraft.prizes.push(item);else lotteryDraft.prizes[index]=item;store.saved=false;closeModal();renderLotterySettings();\n },620);\n}\nfunction previewLottery(){const config=structuredClone({...lotteryDraft,enabled:true}),error=lotteryError(config);if(error){toast(error);return;}lotteryPreviewState={config,remaining:Number(config.drawsPerSubmission),wins:0,rotation:0};const cells=Array.from({length:Number(config.wheelCells)},(_,i)=>config.prizes[i]||{name:'谢谢参与',id:'none-'+i}),step=360/cells.length,colors=['#dcedf0','#edf4f7','#f7edda','#e6efe7'];const segments=cells.map((_,i)=>colors[i%colors.length]+' '+i*step+'deg '+(i+1)*step+'deg').join(',');\n openModal('抽奖预览','<div class=\"lottery-preview\"><p class=\"lottery-preview-prompt\">'+esc(config.prompt)+'<\/p><small class=\"lottery-hint\">演示预览，不扣减库存或生成真实中奖记录。<\/small><div class=\"lottery-wheel-stage\"><div class=\"lottery-pointer\"><\/div><div class=\"lottery-wheel\" id=\"lotteryWheel\" style=\"background:conic-gradient('+segments+')\">'+cells.map((p,i)=>{const a=(i+.5)*step*Math.PI/180;return '<span class=\"lottery-wheel-label\" style=\"left:'+ (50+33*Math.sin(a))+'%;top:'+(50-33*Math.cos(a))+'%\">'+(p.image?'<img src=\"'+esc(p.image)+'\" alt=\"\">':icon(p.id.startsWith('none-')?'heart-handshake':'gift'))+'<strong>'+esc(p.name)+'<\/strong><\/span>';}).join('')+'<\/div>'+lotteryButton(esc(config.buttonText),'spin','','primary lottery-spin')+'<\/div><p id=\"lotteryPreviewRemaining\">剩余 '+config.drawsPerSubmission+' 次机会<\/p><div id=\"lotteryPreviewResult\" role=\"status\" aria-live=\"polite\"><\/div>'+lotteryButton('重新体验','reset-preview','','link')+'<p class=\"lottery-hint\">'+(config.timeMode==='scheduled'?'指定时间开放：'+esc(config.drawAt.replace('T',' ')):'提交后立即开放')+' · '+(config.conditionMode==='conditional'?'按已满足抽奖条件的填写者视角预览':'所有提交者均可参加')+'<\/p><\/div>','',null,680);\n}\nfunction spinLotteryPreview(){const s=lotteryPreviewState;if(!s||!s.remaining)return;const p=s.config;s.remaining--;let winner=null;if(p.maxWins===''||s.wins<Number(p.maxWins)){let r=Math.random()*100;for(const prize of p.prizes){r-=Number(prize.probability);if(r<0){if(prize.quantity>0)winner=prize;break;}}}if(winner)s.wins++;const index=winner?p.prizes.indexOf(winner):p.prizes.length,step=360/Number(p.wheelCells),target=360-((index+.5)*step)%360;s.rotation=Math.floor(s.rotation/360)*360+720+target;$('lotteryWheel').style.transform='rotate('+s.rotation+'deg)';$('lotteryPreviewRemaining').textContent='剩余 '+s.remaining+' 次机会';const alphabet='ABCDEFGHJKMNPQRSTUVWXYZ23456789',code=Array.from({length:8},()=>alphabet[Math.floor(Math.random()*alphabet.length)]).join('');$('lotteryPreviewResult').innerHTML=winner?'<strong>'+esc(p.winText.replaceAll('{奖品名称}',winner.name))+'<\/strong><p>'+esc(p.claimText)+'<\/p>'+(p.redeemMode==='code'?'<div class=\"lottery-code\">兑奖码 <b>'+code+'<\/b><\/div>':'<p>请使用表单中填写的手机号码兑奖。<\/p>')+(p.issuerEnabled?'<p>'+esc(p.issuerName)+' · '+esc(p.issuerContact)+'<\/p>':''):'<strong>'+esc(p.loseText)+'<\/strong>';document.querySelector('[data-lottery-action=\"spin\"]').disabled=s.remaining===0;}\ndocument.addEventListener('click',e=>{\n const tab=e.target.closest('[data-settings-tab]');if(tab){showSettingsTab(tab.dataset.settingsTab);return;}\n const b=e.target.closest('[data-lottery-action]');if(!b||b.disabled)return;const a=b.dataset.lotteryAction,i=Number(b.dataset.index);\n if(a==='add-prize')editLotteryPrize();if(a==='edit-prize')editLotteryPrize(i);if(a==='remove-prize'){openModal('删除奖品','<p>确认移除“'+esc(lotteryDraft.prizes[i].name)+'”？保存设置后生效。<\/p>','删除',()=>{lotteryDraft.prizes.splice(i,1);store.saved=false;closeModal();renderLotterySettings();},440);}\n if(a==='remove-image'){lotteryPrizeDraft.image='';$('lotteryImagePreview').innerHTML='';$('lotteryPrizeImage').value='';}\n if(a==='add-condition'){lotteryDraft.conditions.push({field:lotteryFields()[0].id,operator:'等于',value:''});store.saved=false;renderLotterySettings();}\n if(a==='remove-condition'){lotteryDraft.conditions.splice(i,1);store.saved=false;renderLotterySettings();}\n if(a==='insert-prize-name'){const input=document.querySelector('[data-lottery-key=\"winText\"]'),start=input.selectionStart??input.value.length,end=input.selectionEnd??start;input.value=(input.value.slice(0,start)+'{奖品名称}'+input.value.slice(end)).slice(0,300);lotteryDraft.winText=input.value;store.saved=false;input.focus();input.setSelectionRange(start+6,start+6);}\n if(a==='preview'||a==='reset-preview')previewLottery();if(a==='spin')spinLotteryPreview();\n});\nfunction readLotteryInput(e){const input=e.target,key=input.dataset.lotteryKey;if(key){lotteryDraft[key]=input.type==='checkbox'?input.checked:input.type==='number'?(input.value===''?'':Number(input.value)):input.value;store.saved=false;document.querySelector('[data-lottery-count=\"'+key+'\"]')?.replaceChildren(document.createTextNode(input.value.length+'/'+input.maxLength));if(e.type==='change'&&['enabled','timeMode','conditionMode','linkMode','issuerEnabled','redeemMode'].includes(key)){if(key==='redeemMode'&&input.value==='phone')lotteryDraft.phoneField=lotteryPhoneFields()[0]?.id||'';renderLotterySettings();}}\n if(input.dataset.lotteryCondition!==undefined){lotteryDraft.conditions[Number(input.dataset.lotteryCondition)][input.dataset.key]=input.value;store.saved=false;if(e.type==='change'&&input.dataset.key==='operator')renderLotterySettings();}}\ndocument.addEventListener('input',readLotteryInput);document.addEventListener('change',readLotteryInput);\ndocument.addEventListener('change',async e=>{if(e.target.id!=='lotteryPrizeImage')return;const file=e.target.files[0];if(!file)return;if(!['image/png','image/jpeg','image/webp'].includes(file.type)||file.size>2*1024*1024){$('modalError').textContent='请选择不超过 2MB 的 PNG、JPG 或 WebP 图片';return;}try{const image=new Image(),url=URL.createObjectURL(file);await new Promise((resolve,reject)=>{image.onload=resolve;image.onerror=reject;image.src=url;});const canvas=document.createElement('canvas'),scale=Math.min(1,256/Math.max(image.width,image.height));canvas.width=Math.max(1,Math.round(image.width*scale));canvas.height=Math.max(1,Math.round(image.height*scale));canvas.getContext('2d').drawImage(image,0,0,canvas.width,canvas.height);lotteryPrizeDraft.image=canvas.toDataURL('image/webp',.85);URL.revokeObjectURL(url);$('lotteryImagePreview').innerHTML='<img class=\"lottery-prize-image\" src=\"'+esc(lotteryPrizeDraft.image)+'\" alt=\"奖品图片\">';$('modalError').textContent='';}catch{$('modalError').textContent='图片无法读取，请重新选择';}});\n\n\nseedDemonstrationData();\nFD.prepareRecords(FORMS,RECORDS);\nboot();\n\nwindow.PrototypeSnapshot=()=>{\n persistForm();\n FormLinkState.update(state=>{\n  state.forms=state.forms||{};\n  for(const f of FORMS)state.forms[f.id]=f;\n  state.tasks=TASKS;state.records=RECORDS;\n });\n};\n"},"docs":{"css":"\n\n/*# sourceMappingURL=tabler-icons.css.map */\n\n\n:root{--primary:var(--primary);--hover:#1d4ed8;--pale:#e9f2fb;--text:#111827;--muted:#475569;--weak:#64748b;--disabled:#94a3b8;--border:#e5e7eb;--line:#eef2f7;--head:#f8fafc;--white:#fff;--green:#16a34a;--green-bg:#eaf8ef;--orange:#d97706;--orange-bg:#fff7e6;--purple:#7c3aed;--purple-bg:#f5f3ff;--red:#dc2626;--red-bg:#fff1f0;--input:#d1d5db;--radius:8px}\n*{box-sizing:border-box}body{margin:0;font:13px/1.5 'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif;color:var(--text);background:var(--white)}button,input,select,textarea{font:inherit}button,a,input,select,textarea{transition:160ms ease}button,a{cursor:pointer}a{color:inherit;text-decoration:none}button{color:inherit}button:disabled{color:var(--disabled);cursor:not-allowed;background:var(--head)}:focus-visible{outline:2px solid var(--primary);outline-offset:3px}[hidden]{display:none!important}.app{height:100vh;display:grid;grid-template-rows:68px minmax(0,1fr) 28px;overflow:hidden}.topbar{display:flex;align-items:center;border-bottom:1px solid var(--border);padding:0 24px;gap:36px}.brand{width:174px;display:flex;align-items:center;gap:10px;font-size:19px;font-weight:800;flex:none}.brandmark{width:32px;height:32px;background:var(--primary);color:var(--white);border-radius:8px;display:grid;place-items:center;font-size:22px}.top-nav{display:flex;height:100%;gap:24px;align-items:center;min-width:0}.top-nav a,.top-nav span{height:100%;display:flex;align-items:center;gap:7px;white-space:nowrap;color:var(--muted);position:relative}.top-nav .active{color:var(--primary);font-weight:700}.top-nav .active:after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:var(--primary)}.top-right{margin-left:auto;display:flex;gap:18px;align-items:center;white-space:nowrap}.avatar{width:30px;height:30px;display:inline-grid;place-items:center;border-radius:50%;background:var(--pale);color:var(--primary);font-weight:700}.workspace{display:flex;min-height:0}.sidebar{width:220px;flex:0 0 220px;border-right:1px solid var(--border);display:flex;flex-direction:column;padding:22px 12px 12px;min-height:0}.sidebar h2{font-size:18px;margin:0 12px 20px;display:flex;align-items:center;gap:9px}.sidebar h2 i{color:var(--primary);font-size:22px}.nav{display:flex;flex-direction:column;gap:3px;overflow:auto;min-height:0}.nav-item{width:100%;border:0;background:none;text-align:left;height:44px;border-radius:6px;padding:0 13px;display:flex;align-items:center;gap:12px;font-size:14px;color:var(--muted)}.nav-item i{font-size:19px}.nav-item:hover{background:var(--head);color:var(--primary)}.nav-item.active{background:var(--pale);color:var(--primary);font-weight:700}.nav-item .count{margin-left:auto;font-size:11px}.nav-sep{height:1px;background:var(--line);margin:12px}.nav-caption{font-size:11px;color:var(--weak);padding:7px 13px}.storage{margin-top:auto;padding:18px 12px 0;color:var(--weak);font-size:11px}.storage b{color:var(--muted)}.progress{height:4px;background:var(--line);border-radius:6px;margin:9px 0;overflow:hidden}.progress span{display:block;width:24%;height:100%;background:var(--primary)}.main{flex:1;min-width:0;min-height:0;overflow:auto;padding:24px 28px 30px}.page-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px;gap:14px}.page-head h1{font-size:22px;font-weight:750;margin:0 0 5px}.subtitle{margin:0;color:var(--weak);font-size:12px}.head-actions,.row,.toolbar,.filters,.actions,.inline{display:flex;align-items:center;gap:10px}.btn{height:32px;display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid var(--input);border-radius:6px;padding:0 12px;background:var(--white);font-weight:600;white-space:nowrap}.btn:hover{border-color:var(--primary);color:var(--primary)}.btn.primary{background:var(--primary)