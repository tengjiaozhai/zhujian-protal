"overlay\"><\/div><div id=\"toast\" class=\"toast\" role=\"status\"><\/div>","script":"function formEntryValuesFor(t,editing=false){return {c1:t.dept||'信息工程学院',c2:t.equipment||'',c3:['填报中','已驳回','已提交','已完成'].includes(t.fill)||editing?t.value??'':'',c4:t.running||'正常运行',c5:t.remark||'',...t.values};}\nfunction readFormEntry(renderer,t){const values=renderer.read();return {values,batchRows:renderer.entries(),dept:values.c1||t.dept||'信息工程学院',equipment:values.c2||'',value:values.c3===''?0:Number(values.c3)||0,running:values.c4||'',remark:values.c5||''};}\nfunction saveFormEntryDraft(t,renderer){Object.assign(t,readFormEntry(renderer,t),{fill:'填报中'});}\nfunction submitFormEntry(t,f,renderer,schema,records,old=null,edit=false){\n const errors=renderer.validate();if(Object.keys(errors).length)return {errors};\n if(t.preview)return {preview:true};\n const v=readFormEntry(renderer,t);\n Object.assign(t,v,{fill:f.type==='流程表单'?'已提交':'已完成',audit:f.type==='流程表单'?'待审核':'—',submitted:new Date().toLocaleString('sv-SE').slice(0,16)});\n const data={id:old?.id||'R'+Date.now(),tid:t.id,fid:t.fid,person:f.identity==='实名填报'?t.person:'匿名提交',dept:f.identity==='实名填报'?v.dept:'不展示组织身份',cycle:t.cycle,submitted:t.submitted,audit:t.audit,version:t.version,node:t.node,withdrawn:false,approvalStarted:false,...v,fieldSchema:structuredClone(schema.fields),formDesign:structuredClone(schema.design)};\n if(f.identity!=='实名填报')data.dept='不展示组织身份';\n if(edit){const snapshot=structuredClone({...old,history:[]});Object.assign(old,data,{history:[...(old.history||[]),snapshot],revision:(old.revision||1)+1});delete old.batchRows;t.batchRows=records.filter(r=>r.tid===t.id&&!r.withdrawn).sort((a,b)=>(a.batchIndex||0)-(b.batchIndex||0)).map(r=>r.values);}else{\n  const rows=renderer.entries(),previous=records.filter(r=>r.tid===t.id).sort((a,b)=>(a.batchIndex||0)-(b.batchIndex||0)),batch=old?.batchId||(rows.length>1?'batch-'+Date.now():null);\n  rows.forEach((values,index)=>{const prior=previous[index],item={...data,id:prior?.id||'R'+Date.now()+'-'+index,values,equipment:values.c2||'',value:Number(values.c3)||0,running:values.c4||'',remark:values.c5||'',dept:f.identity==='实名填报'?values.c1||t.dept:'不展示组织身份',batchId:batch,batchIndex:index,batchCount:rows.length,revision:(prior?.revision||0)+1,history:prior?[...(prior.history||[]),structuredClone({...prior,history:[]})]:[]};delete item.batchRows;if(prior)Object.assign(prior,item);else records.push(item);});\n  previous.slice(rows.length).forEach(r=>{r.withdrawn=true;r.audit='已撤回';});\n }\n return {submitted:true};\n}\n\n/* Canonical component definitions. Packaged unchanged into both prototype sources. */\n(function (global) {\n  'use strict';\n  const C = [];\n  const spec = (key, label, kind = 'text', value = '', choices, section = '基础设置') => ({key, label, kind, value, choices, section});\n  const toggle = (key, label, value = false, section) => spec(key, label, 'toggle', value, null, section);\n  const num = (key, label, value = '', section) => spec(key, label, 'number', value, null, section);\n  const choice = (key, label, choices, value = choices[0], section) => spec(key, label, 'select', value, choices, section);\n  const lines = (key, label, value = '', section) => spec(key, label, 'lines', value, null, section);\n  const color = (key, label, value = '#1b6274', section) => spec(key, label, 'color', value, null, section);\n  const base = [toggle('showTitle','显示标题',true), toggle('showHint','提示信息'), choice('hintMode','提示展示方式',['文字展示','悬浮展示','附件展示']), lines('hint','提示内容'), spec('placeholder','输入提示'), toggle('readonly','不可编辑'), toggle('hidden','是否隐藏组件'), choice('width','组件占比',['整行','3/4','2/3','1/2','1/3','1/4']), spec('titleFont','标题字体','text','Microsoft YaHei'), color('titleColor','标题颜色','#263849'), num('titleSize','标题字号',14), toggle('titleBold','标题加粗'), choice('titleAlign','标题对齐',['左对齐','居中','右对齐'])];\n  const validation = [toggle('required','是否必填',false,'校验设置'), choice('requiredStyle','必填样式',['*','必填'],'*','校验设置')];\n  const advanced = [toggle('printable','是否打印',true,'高级设置'),toggle('linkage','是否支持显隐关联',true,'高级设置')];\n  const defaults = [choice('defaultMode','默认值来源',['自定义','当前用户','当前部门','当前日期','公式'],'自定义'),spec('defaultValue','默认值')];\n  const unique = [toggle('unique','是否查重',false,'校验设置'),toggle('crossUnique','是否跨表单唯一性校验',false,'校验设置'),spec('uniqueForm','唯一性关联表单','form','','','校验设置')];\n  const count = [toggle('counter','计数器',false,'校验设置'),num('minLength','最小长度',0,'校验设置'),num('maxLength','最大长度',255,'校验设置')];\n  const options = [choice('optionSource','选项来源',['自定义','表单数据'],'自定义'),lines('options','选项（每行一个）','选项一\\n选项二\\n选项三'),toggle('randomOptions','是否随机展示'),toggle('otherOption','添加其他'),toggle('coloredOptions','彩色选项'),lines('optionDescriptions','选项说明（每行对应一项）'),lines('optionLinks','选项关联（选项值=字段标识）'),toggle('singleLine','单行显示')];\n  const multiple = [num('minSelected','最少勾选数量',0,'校验设置'),num('maxSelected','最多勾选数量','','校验设置'),toggle('exceedHint','是否超出提示',true,'校验设置'),toggle('exclusive','是否开启排他选项',false,'校验设置'),spec('exclusiveValue','排他选项值','text','','','校验设置')];\n  const numeric = [choice('numberFormat','数字格式',['数值','百分比','金额']),toggle('keepDecimals','保留小数位数'),num('decimals','小数位数',0),toggle('thousands','显示千位分隔符（,）'),num('min','最小值','','校验设置'),num('max','最大值','','校验设置'),toggle('autoFill','自动填充',false,'高级设置')];\n  const files = [toggle('storeOriginal','是否存储原图',true),toggle('watermark','允许拍照添加水印上传'),spec('watermarkText','水印默认值','text','竹简应用中台'),num('maxSize','单个文件最大体积（MB）',20,'校验设置')];\n  const fileCount = [choice('fileCountRule','上传文件数量',['不限制','等于','不超过','不少于'],'不限制','校验设置'),num('fileCount','文件数量',2,'校验设置')];\n  const organizations = (kind) => [...defaults,choice('scope','可选范围',['全部'+kind,'指定'+kind]),lines('scopeOptions','指定范围（每行一个）',kind==='成员'?'高源\\n李静\\n王强':'信息工程学院\\n理学院\\n资产管理处'),lines('tableFormat','表格格式',kind==='成员'?'用户名称\\n用户ID':'机构名称\\n机构ID'),lines('detailFormat','详情格式',kind==='成员'?'用户名称\\n用户ID':'机构名称\\n机构ID')];\n  const table = [toggle('allowAdd','是否新增记录',true),toggle('allowDelete','是否删除记录',true),toggle('allowCopy','是否复制记录',true),toggle('allowImport','是否导入数据',true),lines('columns','子字段（名称|类型，每行一个）','名称|text\\n数量|number'),lines('defaultRows','默认值（CSV，每行一条）'),lines('fieldOrder','字段排序（字段名，每行一个）'),lines('optionLinks','选项关联（选项值=字段标识）'),choice('desktopStyle','电脑端展示样式',['表格','卡片'],'表格','高级设置'),choice('mobileStyle','移动端展示样式',['卡片','表格'],'卡片','高级设置'),num('frozenColumns','冻结前几列',1,'高级设置')];\n  const reference = [spec('buttonText','按钮内容','text','选择数据'),spec('sourceForm','关联表单 / 模型','form'),choice('recordMode','数据条数',['单条','多条']),lines('displayFields','显示 / 引用数据字段（字段标识）'),lines('echoFields','表单回显字段（来源=目标字段标识）'),lines('dataMapping','数据填充设置（来源=目标字段标识）'),lines('filters','过滤条件（字段=值）')];\n  const question = [num('score','本题分值',5,'答题设置'),lines('answer','参考答案（多项用换行分隔）','','答题设置'),lines('analysis','答案解析','','答题设置'),toggle('showAnswer','提交后展示答案',false,'答题设置')];\n  function add(type,label,group,icon,extra=[],flags={}) {C.push({type,label,group,icon,properties:[...base,...(flags.display?[]:validation),...extra,...advanced],...flags});}\n  add('text','单行文本','基础组件','letter-t',[...defaults,...unique,...count,choice('contentValidation','常用数据内容校验',['无','邮箱','网址','身份证','仅数字','字母数字'],'无','校验设置'),spec('relatedValidation','关联组件校验','field','','','校验设置')]);\n  add('textarea','多行文本','基础组件','align-left',[...defaults,...count,toggle('trim','去除首尾空白',true),spec('pattern','自定义正则表达式','text','','','校验设置'),spec('patternMessage','校验错误提示','text','内容格式不符合要求','','校验设置')]);\n  add('radio','单选组件','基础组件','circle-dot',[...options,...unique]);\n  add('checkBox','多选组件','基础组件','checkbox',[...options,...multiple,toggle('followInput','选项跟随输入')]);\n  add('select','下拉选择','基础组件','selector',[...options,...unique,num('dropdownLimit','输入下拉选项最大数量',100)]);\n  add('multipleSelect','下拉多选','基础组件','list-check',[...options,...multiple,num('dropdownLimit','输入下拉选项最大数量',100)]);\n  add('description','文本描述','基础组件','text-caption',[lines('content','描述内容','请填写以下信息。'),toggle('hideBorder','是否隐藏边框',true),num('fontSize