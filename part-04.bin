\") format(\"woff2\");font-style:normal;font-weight:600;font-display:swap}\n:root{--body:\"Microsoft YaHei\",\"PingFang SC\",sans-serif;--display:\"Campus Serif\",\"Noto Serif SC\",\"Songti SC\",SimSun,serif;--primary:#07599f;--primary-hover:#03477f;--blue:var(--primary);--accent:var(--primary);--ink:#172f4c;--text:#263e58;--muted:#526980;--light:#e9f2fb;--soft:#f4f8fc;--border:#dce5ed;--line:#e0e7ef;--fd-primary:var(--primary);--fd-deep:#173b5c;--fd-text:#263e58;--fd-muted:#526980;--fd-border:#d4e0eb;--fd-soft:#f0f6fc}\nhtml,body{font-family:var(--body);font-size:14px;color:var(--text);background:#fff;line-height:1.6}button,input,select,textarea{font-family:var(--body)}button,a{transition:background-color .3s cubic-bezier(.22,1,.36,1),color .3s cubic-bezier(.22,1,.36,1)}button,input,select,textarea{caret-color:var(--primary)}input,select,textarea{accent-color:var(--primary)}::selection{background:#d5eafb;color:#102e4c}*{scrollbar-width:thin;scrollbar-color:#afc3d5 transparent}button:focus-visible,a:focus-visible{outline:2px solid #247fbe;outline-offset:3px}input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid #83b9df;outline-offset:1px}\na{text-decoration:none}a:hover{color:var(--primary)}\nh1,h2{font-family:var(--display);font-weight:600;color:var(--ink)}h1{font-size:30px;line-height:1.5}h2{font-size:20px;line-height:1.5}.muted{color:var(--muted)}small,.help,.hint{color:var(--muted)}\n.primary,.btn.primary,.btn-primary{background:var(--primary);border-color:var(--primary);color:#fff}.primary:hover,.btn.primary:hover,.btn-primary:hover{background:var(--primary-hover);border-color:var(--primary-hover)}.secondary,.btn{border-radius:4px}.btn,.primary,.secondary{font-size:14px;min-height:36px}.secondary{color:#315573;border-color:#cbdbea;background:#fff}.secondary:hover{color:var(--primary);border-color:var(--primary);background:#f0f7fd}.text-button{color:var(--primary)}.tag{font-size:12px}.tag.blue{background:#e9f2fb;color:#256597}\n.platfo