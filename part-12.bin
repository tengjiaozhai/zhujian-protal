') center 28%/cover no-repeat}.portal-hero-inner{max-width:1536px;margin:auto;padding:32px 48px 24px}.portal-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}.portal-heading h1{font-family:var(--display);font-size:48px;line-height:1.4;color:#102e4e;font-weight:700;letter-spacing:1px;margin:0 0 4px}.portal-department{font-size:18px;color:#476484}.portal-heading .secondary{font-size:14px;background:#ffffffed;border-color:#cadbea}\n.portal-overview{display:flex;align-items:center;margin-top:24px;gap:0}.portal-overview>button{display:flex;align-items:center;gap:12px;padding:0 24px;border:0;border-right:1px solid #8da9c3;border-radius:0;min-height:32px;color:#173b60;background:none}.portal-overview>button:first-child{padding-left:0}.portal-overview>button:last-child{border-right:0}.portal-overview>button:hover{color:#07599f}.portal-overview>button>span{display:flex;align-items:center;gap:12px;font-size:16px;white-space:nowrap}.portal-overview>button>span>.ti{color:#07599f;font-size:28px}.portal-overview>button>strong{font-family:var(--display);font-size:24px;font-weight:600;line-height:1}.portal-overview>button>.ti{display:none}\n.portal-grid{max-width:1536px;margin:auto;padding:16px 48px 48px;display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);align-items:start;gap:16px}.portal-column{display:flex;flex-direction:column;gap:16px;min-width:0}.portal-item{min-width:0}.portal-grid.single{display:flex;flex-direction:column;align-items:stretch}.portal-grid.single>.portal-column{display:contents}\n.portal-widget{min-width:0;background:#fff;border:1px solid #dde8f2;border-radius:4px;padding:0 24px 8px}.portal-widget>header{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #e0e8f1}.portal-widget h2{font-family:var(--display);font-size:30px;line-height:1.5;color:#123958;font-weight:700;display:flex;align-items:center;gap:8px;margin:0}.portal-widget h2>span{font-family:var(-